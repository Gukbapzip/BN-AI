msgstr[1] "%s sindirir ve %d enerji puanı yenilersiniz."

#: src/consumption.cpp
#, c-format
msgid "<npcname> digests a %s and recharges %d point of energy."
msgid_plural "<npcname> digests a %s and recharges %d points of energy."
msgstr[0] "<npcname>, bir %s sindirir ve %d enerji puanı yeniler."
msgstr[1] "<npcname>, bir %s sindirir ve %d enerji puanı yeniler."

