msgstr[0] "pişmiş kedi kuyruğu sapı"
msgstr[1] "pişmiş kedi kuyruğu sapları"

#. ~ Description for {'str': 'cooked cattail stalk'}
#: data/json/items/comestibles/veggy_dishes.json
msgid ""
"A cooked stalk from a cattail plant.  Its fibrous outer leaves have been "
"stripped away and now it is quite delicious."
msgstr ""
"Kedi kuyruğu bitkisinden pişirilmiş bir sap. Lifli dış yaprakları soyulmuş "
"ve şimdi oldukça lezzetli."

#: data/json/items/comestibles/veggy_dishes.json
msgid "starch"
msgid_plural "starch"
msgstr[0] "nişasta"
msgstr[1] "nişastalar"

#. ~ Description for {'str_sp': 'starch'}
#: data/json/items/comestibles/veggy_dishes.json
msgid ""
"Sticky, gooey carbohydrate paste extracted from plants.  Spoils rather "
"quickly if not prepared for storage."
msgstr ""
"Bitkilerden elde edilen yapışkan, yapışkan karbonhidrat macunu. Depolama "
"için hazırlanmazsa oldukça hızlı bozulur."

#: data/json/items/comestibles/veggy_dishes.json
