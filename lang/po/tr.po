msgid_plural "chits"
msgstr[0] "fiş"
msgstr[1] "fişler"

#. ~ Description for {'str': 'chit'}
#: data/json/items/generic/currency.json
msgid "This is a slip of paper signed by the issuer."
msgstr "Bu, veren kişi tarafından imzalanmış bir kağıt parçasıdır."

#: data/json/items/generic/currency.json
msgid "icon"
msgid_plural "icons"
msgstr[0] "simge"
msgstr[1] "simgeler"

#. ~ Description for {'str': 'icon'}
#: data/json/items/generic/currency.json
