msgid "C.R.I.T. Automatic Rifleman"
msgstr "C.R.I.T. Otomatik Tüfekçi"

#: data/mods/CRT_EXPANSION/scenarios/crt_grunt_classes.json
msgctxt "profession_female"
msgid "C.R.I.T. Automatic Rifleman"
