#: data/json/professions.json
msgctxt "profession_male"
msgid "Mall Security"
msgstr "AVM Güvenliği"

#: data/json/professions.json
msgctxt "profession_female"
msgid "Mall Security"
msgstr "AVM Güvenliği"

#. ~ Profession (male Mall Security) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"A mall security guard.  You don't have any useful skills, other than some "
"basic training for your job.  You do however have your trusty tazer, baton, "
"and pocket knife."
msgstr ""
"Bir AVM güvenlik görevlisi. İşin için aldığın temel eğitim dışında işe yarar"
" bir yeteneğin yok. Ancak güvenilir elektroşok cihazın, copun ve çakı "
"bıçağın var."

