msgstr[1] "tencereler"

#. ~ Description for {'str': 'pot'}
#: data/json/items/generic/dining_kitchen.json
msgid "Useful for boiling water when cooking spaghetti and more."
msgstr ""
"Spagetti pişirirken ve daha fazlası için su kaynatmakta kullanışlıdır."

#: data/json/items/generic/dining_kitchen.json
