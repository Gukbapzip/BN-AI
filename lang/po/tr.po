#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "  What should <mypronoun> do?"
msgstr "<mypronoun> ne yapmalı?"

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Change your engagement rules…"
msgstr "Etkileşim kurallarınızı değiştirin…"

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Change your aiming rules…"
msgstr "Nişan alma kurallarınızı değiştirin…"

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Change your bionic power reserve rules…"
msgstr "Biyonik güç rezervi kurallarınızı değiştirin…"

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Change your bionic power recharge rules…"
msgstr "Biyonik güç şarj kurallarınızı değiştirin…"

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Move freely as you need to."
msgstr "İhtiyacınız olduğu gibi serbestçe hareket edin."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Stick close to me, no matter what."
msgstr "Ne olursa olsun bana yakın durun."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Follow me about four paces away."
msgstr "Beni dört adım mesafeden takip edin."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Follow me about two paces away."
msgstr "Beni iki adım mesafeden takip edin."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Don't use ranged weapons anymore."
msgstr "Artık menzilli silahlar kullanmayın."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "You can use ranged weapons."
msgstr "Menzilli silahlar kullanabilirsiniz."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Don't worry about noise."
msgstr "Gürültü hakkında endişelenmeyin."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Use only silent weapons."
msgstr "Sadece sessiz silahlar kullanın."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Don't use grenades anymore."
msgstr "Artık el bombası kullanmayın."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "You can use grenades."
msgstr "El bombası kullanabilirsiniz."

