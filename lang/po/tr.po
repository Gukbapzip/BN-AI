#: data/json/speech.json data/mods/Aftershock/speech.json
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Hello?\""
msgstr "\"Merhaba?\""

#: data/json/speech.json
msgid "\"Papaya!\""
msgstr "\"Papaya!\""

#: data/json/speech.json data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Who's there?\""
msgstr "\"Kim var orada?\""

#: data/json/speech.json data/mods/Aftershock/speech.json
msgid "\"Can you help me?\""
msgstr "\"Bana yardım edebilir misin?\""

#: data/json/speech.json
msgid "\"Over here!\""
msgstr "\"Buradayım!\""

#: data/json/speech.json
msgid "\"Can you repeat that?\""
msgstr "\"Bunu tekrar edebilir misin?\""

#: data/json/speech.json
msgid "\"You're just copying me, aren't you?\""
msgstr "\"Beni sadece taklit ediyorsun, değil mi?\""

#: data/json/speech.json
msgid "\"I'm not afraid of you!\""
msgstr "\"Senden korkmuyorum!\""

#: data/json/speech.json
msgid "\"Come here!\""
msgstr "\"Buraya gel!\""

#: data/json/speech.json
msgid "\"Please, don't!\""
msgstr "\"Lütfen, yapma!\""

#: data/json/speech.json
msgid "a horrified scream!"
msgstr "dehşet dolu bir çığlık!"

#: data/json/speech.json
msgid "a little girl's wailing!"
msgstr "küçük bir kızın ağlaması!"

#: data/json/speech.json
msgid "\"So, what is this thing supposed to be, exactly?\""
msgstr "\"Peki, bu şey tam olarak ne supposed to be?\""

#: data/json/speech.json
msgid "\"Uncategorized object seven-seven-three-four.\""
msgstr "\"Sınıflandırılmamış nesne yedi-yedi-üç-dört.\""

#: data/json/speech.json
msgid "\"We found it in a wreckage, barely alive.  Not the first one, either.\""
msgstr "\"Onu bir enkazda bulduk, zar zor hayatta. İlk de değil.\""

#: data/json/speech.json
msgid "\"Area nineteen has a few in cold storage.\""
msgstr "\"Bölge on dokuzda birkaç tane soğuk depoda var.\""

#: data/json/speech.json
msgid "\"Mommy, help!\""
msgstr "\"Anne, yardım et!\""

#: data/json/speech.json
msgid "\"We're still trying to figure out what makes it tick.\""
msgstr "\"Onun nasıl çalıştığını hala çözmeye çalışıyoruz.\""

#: data/json/speech.json
msgid "\"We're not even sure what it is.\""
msgstr "\"Ne olduğundan bile emin değiliz.\""

#: data/json/speech.json
msgid "\"The cell structure is unlike any we've ever seen.\""
msgstr "\"Hücre yapısı daha önce gördüğümüz hiçbir şeye benzemiyor.\""

#: data/json/speech.json
msgid "\"It does seem to have some form of higher level brain functioning.\""
msgstr "\"Daha yüksek seviyede bir beyin fonksiyonuna sahip gibi görünüyor.\""

#: data/json/speech.json
msgid "\"Problem solving, memory retention, that sort of thing.\""
msgstr "\"Problem çözme, hafıza tutma, bu tür şeyler.\""

#: data/json/speech.json
msgid "\"There appear to be some anomalous aspects to the mimicry.\""
msgstr "\"Taklit yeteneğinde bazı anormal yönler var gibi görünüyor.\""

#: data/json/speech.json
msgid "\"Members of the species have some kind of neurocognitive link.\""
msgstr "\"Tür üyelerinin bir tür nörobilişsel bağlantısı var.\""

#: data/json/speech.json
msgid ""
"\"This one's repeating phrases that the previous specimen was exposed to.\""
msgstr "\"Bu, önceki örneğin maruz kaldığı ifadeleri tekrarlıyor.\""

#: data/json/speech.json
msgid "a child shrieking!"
msgstr "bir çocuğun çığlığı!"

#: data/json/speech.json
msgid "\"Oh God, my leg, Oh God!\""
msgstr "\"Aman Tanrım, bacağım, Aman Tanrım!\""

#: data/json/speech.json
msgid "a long cry of agony!"
msgstr "uzun bir acı çığlığı!"

#: data/json/speech.json
msgid "\"You mean it's not just parroting us?\""
msgstr "\"Yani sadece bizi papağan gibi taklit etmiyor mu?\""

#: data/json/speech.json
msgid "\"It's parroting us, but we're uncertain as to how or why.\""
msgstr "\"Bizi taklit ediyor, ama nasıl veya neden olduğundan emin değiliz.\""

#: data/json/speech.json
msgid "\"It may be a mechanism for attracting prey.\""
msgstr "\"Bu, av çekmek için bir mekanizma olabilir.\""

#: data/json/speech.json
msgid "\"It could even be a way of trying to scare us off.\""
msgstr "\"Bizi korkutmaya çalışmanın bir yolu bile olabilir.\""

#: data/json/speech.json
msgid "\"We just don't know.\""
msgstr "\"Bilmiyoruz.\""

#: data/json/speech.json
msgid "an anguished wail!"
msgstr "acı dolu bir feryat!"

#: data/json/speech.json
msgid "\"You're gonna rot in hell for this!\""
msgstr "\"Bunun için cehennemde çürüyeceksin!\""

#: data/json/speech.json
msgid "\"You hear me!?\""
msgstr "\"Beni duyuyor musun!?\""

#: data/json/speech.json
msgid "\"You're gonna rot in hell, you pieces of shit!\""
msgstr "\"Cehennemde çürüyeceksiniz, pislik herifler!\""

#: data/json/speech.json
msgid "\"Like we said, we have no idea what it's thinking.\""
msgstr "\"Dediğimiz gibi, ne düşündüğüne dair hiçbir fikrimiz yok.\""

#: data/json/speech.json
msgid "\"Is that glass electrified?\""
msgstr "\"O cam elektrikli mi?\""

#: data/json/speech.json
msgid "\"Why don't you touch it and find out?\""
msgstr "\"Neden dokunup öğrenmiyorsun?\""

#: data/json/speech.json
msgid "\"Of course it is.\""
msgstr "\"Tabii ki öyle.\""

#: data/json/speech.json
msgid "\"What'll happen if the power goes out?\""
msgstr "\"Elektrikler kesilirse ne olacak?\""

#: data/json/speech.json
msgid "\"Don't worry about it.\""
msgstr "\"Endişelenme.\""

#: data/json/speech.json
msgid "\"Don't worry.\""
msgstr "\"Merak etme.\""

#: data/json/speech.json
msgid "\"There are seven backup generators.\""
msgstr "\"Yedi yedek jeneratör var.\""

#: data/json/speech.json
msgid "\"And what if all the backups fail?\""
msgstr "\"Ya tüm yedekler de arızalanırsa?\""

#: data/json/speech.json
msgid "\"We'd have to terminate the specimen.\""
msgstr "\"Numuneyi sonlandırmak zorunda kalırız.\""

#: data/json/speech.json
msgid "\"The glass alone won't keep us safe for very long.\""
msgstr "\"Sadece cam bizi çok uzun süre güvende tutamaz.\""

#: data/json/speech.json
msgid "\"That fuckin' thing is horrible, man, it gives me the creeps.\""
msgstr "\"O lanet şey korkunç, adamım, tüylerimi diken diken ediyor.\""

#: data/json/speech.json
msgid "\"It's probably more scared of us than we are of it.\""
msgstr "\"Muhtemelen biz ondan daha çok korkuyoruz.\""

#: data/json/speech.json
msgid "\"Somehow, I doubt that.\""
msgstr "\"Nedense bundan şüpheliyim.\""

#: data/json/speech.json
msgid "\"Hey, we got other specimens that could withstand a grenade.\""
msgstr "\"Hey, el bombasına dayanabilecek başka örneklerimiz var.\""

#: data/json/speech.json
msgid "\"And that's supposed to comfort me?\""
msgstr "\"Ve bu beni rahatlatacak mı?\""

#: data/json/speech.json
msgid "\"At least we know they can die.\""
msgstr "\"En azından ölebileceklerini biliyoruz.\""

#: data/json/speech.json
msgid "\"U-O Seven-Seven-Three-Four.\""
msgstr "\"U-O Yedi-Yedi-Üç-Dört.\""

#: data/json/speech.json
msgid "\"Individual instances of U-O Seven-Seven-Three-Four.\""
msgstr "\"U-O Yedi-Yedi-Üç-Dört'ün bireysel örnekleri.\""

#: data/json/speech.json
msgid "\"To be kept in a standard biohazardous containment chamber.\""
msgstr "\"Standart bir biyolojik tehlike içeren odada tutulmalıdır.\""

#: data/json/speech.json
msgid "\"Until such time as more permanent arrangements are made.\""
msgstr "\"Daha kalıcı düzenlemeler yapılana kadar.\""

#: data/json/speech.json
msgid "\"Shows a noted preference for human brain tissue.\""
msgstr "\"İnsan beyin dokusuna belirgin bir tercih gösterir.\""

#: data/json/speech.json
msgid "\"Destroy the specimen if it begins to interact with the lock.\""
msgstr "\"Kilitle etkileşime girmeye başlarsa örneği yok edin.\""

#: data/json/speech.json
msgid "\"Kill them all and let God sort them out!\""
msgstr "\"Hepsini öldürün, Tanrı ayıklasın!\""

#: data/json/speech.json
msgid "\"I watched a snail crawl along the edge of a straight razor.\""
msgstr "\"Bir salyangozun düz bir ustura kenarında süründüğünü izledim.\""

#: data/json/speech.json
msgid "\"I've seen horrors, horrors that you've seen.\""
msgstr "\"Korkular gördüm, senin gördüğün korkular.\""

#: data/json/speech.json
msgid "\"I love the smell of napalm in the morning.\""
msgstr "\"Sabahları napalm kokusunu seviyorum.\""

#: data/json/speech.json
msgid "\"This is the way the fuckin' world ends.\""
msgstr "\"Lan dünya böyle sona eriyor.\""

#: data/json/speech.json
msgid "\"Look at this fuckin' shit we're in, man.\""
msgstr "\"Şu içine düştüğümüz lanet olası duruma bak, dostum.\""

#: data/json/speech.json
msgid "\"Every man has got a breaking point.\""
msgstr "\"Her insanın bir kırılma noktası vardır.\""

#: data/json/speech.json
msgid "\"I'ma cut those fuckin' tentacles off, bitch!\""
msgstr "\"O lanet olası dokunaçları keseceğim, pislik!\""

#: data/json/speech.json
msgid "\"Watch you bleed out!\""
msgstr "\"Kan kaybından ölüşünü izleyeceğim!\""

#: data/json/speech.json
msgid "\"I wonder if it understands us.\""
msgstr "\"Acaba bizi anlıyor mu?\""

#: data/json/speech.json
msgid "\"Do you understand what I'm saying?\""
msgstr "\"Ne dediğimi anlıyor musun?\""

#: data/json/speech.json
msgid "\"Look, it's responding!\""
msgstr "\"Bak, tepki veriyor!\""

#: data/json/speech.json
msgid "\"That's the first time it moved all morning.\""
msgstr "\"Bu sabah ilk kez hareket etti.\""

#: data/json/speech.json
msgid "\"I'm certain it's trying to understand us.\""
msgstr "\"Bizi anlamaya çalıştığından eminim.\""

#: data/json/speech.json
msgid "\"I'm not convinced it can actually comprehend us.\""
msgstr "\"Bizi gerçekten anlayabileceğine ikna olmadım.\""

#: data/json/speech.json
msgid "\"It's just repeating us.\""
msgstr "\"Sadece bizi tekrar ediyor.\""

#: data/json/speech.json
msgid "\"Just being an alien creature doesn't mean it's intelligent.\""
msgstr "\"Yabancı bir yaratık olması, zeki olduğu anlamına gelmez.\""

#: data/json/speech.json
msgid "\"Just because it doesn't look like you doesn't mean that it isn't.\""
msgstr "\"Sana benzemiyor diye zeki olmadığı anlamına gelmez.\""

#: data/json/speech.json
msgid "\"Please open the door and enter the cell.\""
msgstr "\"Lütfen kapıyı aç ve hücreye gir.\""

#: data/json/speech.json
msgid "\"Would it react differently with a child?\""
msgstr "\"Bir çocukla farklı tepki verir mi?\""

#: data/json/speech.json
msgid "\"Experiments to determine extent of cognitive abilities still underway.\""
msgstr ""
"\"Bilişsel yeteneklerin kapsamını belirlemek için deneyler devam ediyor.\""

#: data/json/speech.json
msgid ""
