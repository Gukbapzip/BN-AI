msgstr "zayıf, neredeyse insanlık dışı bir inleme."

#: data/mods/Civilians/speech.json
msgid "\"Die!\""
msgstr "\"Öl!\""

#: data/mods/Civilians/speech.json
msgid "\"Die, zombie scum!\""
msgstr "\"Öl, zombi pisliği!\""

#: data/mods/Civilians/speech.json
msgid "\"You'll get what's coming to you!\""
msgstr "\"Hak ettiğini alacaksın!\""

#: data/mods/Civilians/speech.json
msgid "\"Kick the bucket, filthy dead!\""
msgstr "\"Geber, pis ölü!\""

#: data/mods/Civilians/speech.json
msgid "\"Come get some!\""
msgstr "\"Gel de al!\""

#: data/mods/Civilians/speech.json
