#: data/mods/rpg_system/main.lua
msgid ""
"Affects class bonuses and periodic effects. Things that don't scale with "
"level are unaffected."
msgstr ""
"Sınıf bonuslarını ve periyodik etkileri etkiler. Seviye ile ölçeklenmeyen "
"şeyler etkilenmez."

#: data/mods/rpg_system/main.lua
msgid "Does not affect assigned stats."
msgstr "Atanan istatistikleri etkilemez."

#: data/mods/rpg_system/main.lua
#, c-format
msgid "0% (Disable scaling)"
msgstr "0% (Ölçeklendirmeyi devre dışı bırak)"

#: data/mods/rpg_system/main.lua
msgid "Disables all level-based class bonuses and periodic effects."
msgstr ""
"Seviye tabanlı tüm sınıf bonuslarını ve periyodik efektleri devre dışı "
"bırakır."

#: data/mods/rpg_system/main.lua
#, c-format
