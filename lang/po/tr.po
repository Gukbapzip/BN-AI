msgstr "%s, sizi şok etmeye çalışır ama başarısız olur."

#: src/monattack.cpp
#, c-format
msgid "The %s unsuccessfully attempts to shock <npcname>."
msgstr "%s, <npcname>'i şok etmeye çalışır ama başarısız olur."

