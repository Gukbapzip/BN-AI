#: data/json/professions.json
msgctxt "profession_male"
msgid "Juvenile Delinquent"
msgstr "Suçlu Genç"

#: data/json/professions.json
msgctxt "profession_female"
msgid "Juvenile Delinquent"
msgstr "Suçlu Genç"

#. ~ Profession (male Juvenile Delinquent) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You never cared for grown-ups telling you what to do, and that's how you "
"ended up spending most of your days in the principal's office.  Now, not "
"needing grown-ups to tell you what to do is the only reason you're alive.  "
"Man, you really should've played hooky today."
msgstr ""
"Büyüklerin sana ne yapman gerektiğini söylemesinden hiç hoşlanmadın ve bu "
"yüzden günlerinin çoğunu müdürün odasında geçirdin. Şimdi, büyüklerin sana "
"ne yapman gerektiğini söylemesine ihtiyaç duymamak, hayatta kalmanın tek "
"nedeni. Adamım, bugün okulu asmalıydın."

#. ~ Profession (female Juvenile Delinquent) description
#: data/json/professions.json
