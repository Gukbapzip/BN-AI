msgid "Farmer"
msgstr "Çiftçi"

#: data/json/professions.json
msgctxt "profession_female"
msgid "Farmer"
msgstr "Çiftçi"

#. ~ Profession (male Farmer) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You were making a living by raising crops, when the Cataclysm struck.  Now, "
"with your trusty hoe and some seeds it's time to rebuild the Earth, one "
"plant at a time."
msgstr ""
"Kıyamet vurduğunda geçiminizi tarım yaparak sağlıyordunuz. Şimdi, güvenilir "
"çapınız ve birkaç tohumla, dünyayı yeniden inşa etme zamanı, bir bitki bir "
"bitki."

