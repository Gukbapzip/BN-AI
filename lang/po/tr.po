#, c-format
msgid "It will finish smoking in about %d hour."
msgid_plural "It will finish smoking in about %d hours."
msgstr[0] "Yaklaşık %d saat içinde tütsüleme işlemi bitecek."
msgstr[1] "Yaklaşık %d saat içinde tütsüleme işlemi bitecek."

