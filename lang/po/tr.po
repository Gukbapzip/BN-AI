msgid "Knight"
msgstr "Şövalye"

#: data/json/professions.json
msgctxt "profession_female"
msgid "Knight"
msgstr "Şövalye"

#. ~ Profession (male Knight) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"Chivalry! Daring! Honor! All traits that are useless in the Cataclysm. But "
"you know how to fight with a sword and you have this armor so it could be "
"worse."
msgstr ""
"Şövalyelik! Cesaret! Onur! Kıyamette işe yaramaz tüm özellikler. Ancak "
"kılıçla nasıl savaşacağınızı biliyorsunuz ve bu zırhınız var, bu yüzden daha"
" kötü olabilirdi."

