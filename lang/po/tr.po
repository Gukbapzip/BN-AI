msgstr "50% (Yarım güç)"

#: data/mods/rpg_system/main.lua
msgid "Half effectiveness for balanced gameplay."
msgstr "Dengeli oyun için yarı etkinlik."

#: data/mods/rpg_system/main.lua
#, c-format
msgid "100% (Full power)"
msgstr "100% (Tam güç)"

#: data/mods/rpg_system/main.lua
