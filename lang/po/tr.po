msgstr[0] "bakır tel"
msgstr[1] "bakır teller"

#. ~ Description for {'str': 'copper wire'}
#: data/json/items/ammo.json
msgid "Plastic jacketed copper cable of the type used in small electronics."
msgstr "Küçük elektroniklerde kullanılan türden plastik kaplı bakır kablo."

#: data/json/items/ammo.json data/mods/Aftershock/items/item_overrides.json
msgid "plutonium fuel cell"
msgid_plural "plutonium fuel cells"
msgstr[0] "plütonyum yakıt hücresi"
msgstr[1] "plütonyum yakıt hücreleri"

#. ~ Description for {'str': 'plutonium fuel cell'}
#: data/json/items/ammo.json
msgid ""
"This power cell was designed to store enormous amounts of power, using "
"plutonium-244 and now-irreplaceable compounds to make compact reactors more "
"practical than ever.  Unfortunately it cannot be recharged by conventional "
"means: expended cells had to be sent to a central reprocessing facility that"
" almost certainly doesn't exist anymore."
msgstr ""
"Bu güç hücresi, plütonyum-244 ve artık yerine konulamaz bileşenler "
"kullanarak büyük miktarda güç depolamak için tasarlandı, böylece kompakt "
"reaktörleri her zamankinden daha pratik hale getirdi. Ne yazık ki, "
"geleneksel yöntemlerle yeniden şarj edilemez: harcanmış hücreler, muhtemelen"
" artık var olmayan merkezi bir yeniden işleme tesisine gönderilmek "
"zorundaydı."

#: data/json/items/ammo.json data/json/items/ammo_types.json
