#: data/mods/speedydex/modinfo.json
msgid "SpeedyDex"
msgstr "SpeedyDex"

#. ~ Description for SpeedyDex
#: data/mods/speedydex/modinfo.json
msgid "Higher dex increases your speed."
msgstr "Daha yüksek çeviklik hızınızı artırır."

#: data/mods/stats_through_kills/modinfo.json
