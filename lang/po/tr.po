msgstr[0] "tavuk ve mantı"
msgstr[1] "tavuk ve mantı"

#. ~ Description for {'str_sp': 'chicken and dumplings'}
#: data/json/items/comestibles/soup.json
msgid "A soup with chicken chunks and balls of dough.  Not bad."
msgstr "Tavuk parçaları ve hamur topları içeren bir çorba. Fena değil."

#: data/json/items/comestibles/soup.json
msgid "cullen skink"
msgid_plural "cullen skinks"
msgstr[0] "cullen skink"
msgstr[1] "cullen skinkler"

#. ~ Description for cullen skink
#: data/json/items/comestibles/soup.json
msgid ""
"A rich and tasty fish chowder from Scotland, made with preserved fish and "
"creamy milk."
msgstr ""
"İskoçya'dan gelen, koruyucu balık ve kremsi sütle yapılan zengin ve lezzetli"
" bir balık çorbası."

