msgstr[1] "SpOreos"

#. ~ Description for {'str_sp': 'SpOreos'}
#: data/mods/CrazyCataclysm/crazy_comestibles.json
msgid ""
"The hit cookie from Mycus Industries!  Now comes in addicting flavors such "
"as Marloss, Chanterelle, and The Encroaching, Unavoidable Death of Human "
"Civilization."
msgstr ""
"Mycus Industries'in hit kurabiyesi! Şimdi bağımlılık yapan Marloss, "
"Chanterelle ve İnsan Medeniyetinin Yaklaşan, Kaçınılmaz Ölümü gibi "
"lezzetlerde geliyor."

#: data/mods/CrazyCataclysm/crazy_items.json
