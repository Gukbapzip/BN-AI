msgstr "Mutlu 10. Doğum Günü <given_name>!"

#: data/json/snippets/residential_signs.json
msgid "Garage Sale - Sunday, April 25th"
msgstr "Garaj Satışı - Pazar, 25 Nisan"

#: data/json/snippets/residential_signs.json
msgid "Clarity Windows and Doors - 555-1932"
msgstr "Clarity Windows and Doors - 555-1932"

#: data/json/snippets/residential_signs.json
msgid "Full Service Lawn Care - 555-4628 - Tuffy Lawns"
msgstr "Tam Hizmet Çim Bakımı - 555-4628 - Tuffy Lawns"

#: data/json/snippets/residential_signs.json
msgid "Prospect Realty - Open House"
msgstr "Prospect Realty - Açık Ev"

#: data/json/snippets/residential_signs.json
msgid "Private Property - No Trespassing"
msgstr "Özel Mülk - Girilmez"

#: data/json/snippets/residential_signs.json
msgid "Stern Security Group - 555-7612"
msgstr "Stern Security Group - 555-7612"

#: data/json/snippets/residential_signs.json
msgid "<family_name> Lawnscaping - 555-2674"
msgstr "<family_name> Çim Bakımı - 555-2674"

#: data/json/snippets/residential_signs.json
msgid "Beware of Dog"
msgstr "Köpeğe Dikkat"

#: data/json/snippets/residential_signs.json
msgid "The <family_name> Residence"
msgstr "<family_name> İkameti"

#: data/json/snippets/residential_signs.json
msgid ""
"This For Sale sign has a printed note stapled over top of it that reads "
"\"<given_name>, tried to text you.  Gone to the cabin with <given_name> and "
"<given_name>.  Meet us there.  Love, Mom\""
msgstr ""
"Bu Satılık tabelasının üzerine zımbalanmış basılı bir not var: "
"\"<given_name>, sana mesaj atmaya çalıştım. <given_name> ve <given_name> ile"
" kulübeye gittik. Orada buluşalım. Sevgiler, Anne\""

#: data/json/snippets/residential_signs.json
msgid "Another Home Sold - <family_name> Realtors - 555-7481"
msgstr "Bir Başka Ev Satıldı - <family_name> Emlakçılar - 555-7481"

