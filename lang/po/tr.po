#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"Everyone is dead?  Well, it doesn't matter… your cats are all the friends "
"you need!"
msgstr ""
"Herkes öldü mü? Pekala, önemli değil… kedileriniz ihtiyacınız olan tüm "
"arkadaşlar!"

