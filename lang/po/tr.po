#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Stay awake."
msgstr "Uyanık kal."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Sleep when you feel tired."
msgstr "Kendini yorgun hissettiğinde uyu."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Stay quiet."
msgstr "Sessiz kal."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Tell me when you need something."
msgstr "Bir şeye ihtiyacın olduğunda bana söyle."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Leave corpses alone."
msgstr "Cesetlere dokunma."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Smash zombie corpses."
msgstr "Zombi cesetlerini parçala."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Leave doors open."
msgstr "Kapıları açık bırak."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Close the doors."
msgstr "Kapıları kapat."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Open doors to get where you're going."
msgstr "Gideceğin yere ulaşmak için kapıları aç."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Don't walk through closed doors."
msgstr "Kapalı kapılardan geçme."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "If you hear a noise but can't see the source, move to investigate it."
msgstr ""
"Bir ses duyarsan ama kaynağını göremiyorsan, incelemek için hareket et."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Don't investigate noises that you can't see."
msgstr "Göremediğin sesleri inceleme."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Match my movement speed when following."
msgstr "Takip ederken hareket hızımı eşle."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Move at your own pace."
msgstr "Kendi hızında hareket et."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Set up pickup rules."
msgstr "Alma kurallarını ayarla."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Clear all overrides."
msgstr "Tüm geçersiz kılmaları temizle."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "You're really leaving?"
msgstr "Gerçekten mi gidiyorsun?"

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Yeah, I'm sure.  Bye."
msgstr "Evet, eminim. Hoşça kal."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Nah, I'm just kidding."
msgstr "Hayır, sadece şaka yapıyorum."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Please go to this location…"
msgstr "Lütfen bu konuma gidin…"

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Stay at your current position."
msgstr "Mevcut pozisyonunuzda kalın."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "I'm currently <current_activity>."
msgstr "Şu anda <current_activity>'dayım."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "I'm not doing much currently."
msgstr "Şu anda pek bir şey yapmıyorum."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "I meant what are your goals?"
msgstr "Hedeflerin neler demek istedim?"

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Carry on."
msgstr "Devam et."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Please stop your current activity."
msgstr "Lütfen mevcut etkinliğinizi durdurun."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Please sort out some of these items nearby."
msgstr "Lütfen yakındaki bu eşyaların bir kısmını düzenleyin."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Please do any construction work that you can."
msgstr "Lütfen yapabileceğiniz herhangi bir inşaat işi yapın."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Please do any mining work that you can."
msgstr "Lütfen yapabileceğiniz herhangi bir madencilik işi yapın."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Please study from a book."
msgstr "Lütfen bir kitaptan çalışın."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Please start deconstructing any vehicles in a deconstruction zone."
msgstr "Lütfen bir söküm bölgesindeki araçları sökmeye başlayın."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Please start repairing any vehicles in a repair zone."
msgstr "Lütfen bir tamir bölgesindeki araçları tamir etmeye başlayın."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Please chop logs into planks."
msgstr "Lütfen kütükleri tahtalara doğrayın."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Please butcher any corpses that you can."
msgstr "Lütfen yapabileceğiniz herhangi bir cesedi parçalayın."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Please chop any trees in the designated areas."
msgstr "Lütfen belirlenmiş alanlardaki ağaçları kesin."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Please go catch some fish."
msgstr "Lütfen biraz balık yakala."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Please do some farming work."
msgstr "Lütfen biraz çiftçilik yap."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "*pssshht* ten-four, I'll make my way there, over."
msgstr "*pssshht* anlaşıldı, oraya doğru yola çıkıyorum, tamam."

#: data/json/npcs/TALK_COMMON_ALLY.json data/json/npcs/talk_tags.json
msgid "Affirmative."
msgstr "Olumlu."

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Sure thing, I'll make my way there."
msgstr "Tabii ki, oraya doğru yola çıkıyorum."

#: data/json/npcs/TALK_COMMON_ALLY.json
