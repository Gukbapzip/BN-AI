#: data/json/professions.json
msgctxt "profession_male"
msgid "Davy Jones"
msgstr "Davy Jones"

#: data/json/professions.json
msgctxt "profession_female"
msgid "Davy Jones"
msgstr "Davy Jones"

#. ~ Profession (male Davy Jones) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You were robbed, shot in the head and thrown into the sea just before the "
"Cataclysm. Now you have risen undead from the depths, with a thirst for "
"vengeance against those who wronged you, and a desire to reclaim your lost "
"treasures."
msgstr ""
"Felakete az kala soyuldunuz, kafanızdan vuruldunuz ve denize atıldınız. "
"Şimdi, size haksızlık edenlerden intikam almak ve kaybettiğiniz hazineleri "
"geri kazanmak arzusu ile derinliklerden ölümsüz olarak yükseldiniz."

