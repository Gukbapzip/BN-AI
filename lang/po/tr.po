msgid_plural "pineapples"
msgstr[0] "ananas"
msgstr[1] "ananaslar"

#. ~ Description for pineapple
#: data/json/items/comestibles/raw_fruit.json
msgid "A large, spiky pineapple.  A bit sour, though."
msgstr "Büyük, dikenli bir ananas. Biraz ekşi."

#: data/json/items/comestibles/raw_fruit.json
#: data/mods/Aftershock/items/seed.json
msgid "coconut"
msgid_plural "coconuts"
msgstr[0] "hindistancevizi"
msgstr[1] "hindistancevizleri"

#. ~ Description for coconut
#: data/json/items/comestibles/raw_fruit.json
msgid "A fruit with a hard and hairy shell."
msgstr "Sert ve tüylü bir kabuğa sahip bir meyve."

#: data/json/items/comestibles/raw_fruit.json
msgid "peach"
msgid_plural "peaches"
msgstr[0] "şeftali"
msgstr[1] "şeftaliler"

#. ~ Description for {'str': 'peach', 'str_pl': 'peaches'}
#: data/json/items/comestibles/raw_fruit.json
msgid "This fruit's large pit is surrounded by its tasty flesh."
msgstr "Bu meyvenin büyük çekirdeği, lezzetli etiyle çevrilidir."

#: data/json/items/comestibles/raw_fruit.json
msgid "watermelon"
msgid_plural "watermelons"
msgstr[0] "karpuz"
msgstr[1] "karpuzlar"

#. ~ Description for watermelon
#: data/json/items/comestibles/raw_fruit.json
msgid "A fruit, bigger than your head.  It is very juicy!"
msgstr "Kafanızdan daha büyük bir meyve. Çok sulu!"

#: data/json/items/comestibles/raw_fruit.json
#: data/mods/Aftershock/items/seed.json
msgid "melon"
msgid_plural "melons"
msgstr[0] "kavun"
msgstr[1] "kavunlar"

#. ~ Description for melon
#: data/json/items/comestibles/raw_fruit.json
msgid "A large and very sweet fruit."
msgstr "Büyük ve çok tatlı bir meyve."

#: data/json/items/comestibles/raw_fruit.json
msgid "blackberries"
msgid_plural "blackberries"
msgstr[0] "böğürtlen"
msgstr[1] "böğürtlenler"

#. ~ Description for {'str_sp': 'blackberries'}
#: data/json/items/comestibles/raw_fruit.json
msgid "A darker cousin of raspberry."
msgstr "Ahududunun koyu renkli kuzeni."

#: data/json/items/comestibles/raw_fruit.json
msgid "mango"
msgid_plural "mangos"
msgstr[0] "mango"
msgstr[1] "mangolar"

#. ~ Description for mango
#: data/json/items/comestibles/raw_fruit.json
msgid "A fleshy fruit with large pit."
msgstr "Büyük çekirdekli etli bir meyve."

#: data/json/items/comestibles/raw_fruit.json
msgid "pomegranate"
msgid_plural "pomegranates"
msgstr[0] "nar"
msgstr[1] "narlar"

#. ~ Description for pomegranate
#: data/json/items/comestibles/raw_fruit.json
msgid "Under this pomegranate's spongy skin lies hundreds of fleshy seeds."
msgstr "Bu narın süngerimsi kabuğunun altında yüzlerce etli tohum bulunur."

#: data/json/items/comestibles/raw_fruit.json
msgid "papaya"
msgid_plural "papayas"
msgstr[0] "papaya"
msgstr[1] "papayalar"

#. ~ Description for papaya
#: data/json/items/comestibles/raw_fruit.json
msgid "A very sweet and soft tropical fruit."
msgstr "Çok tatlı ve yumuşak bir tropikal meyve."

#: data/json/items/comestibles/raw_fruit.json
msgid "kiwi"
msgid_plural "kiwis"
msgstr[0] "kivi"
msgstr[1] "kiviler"

#. ~ Description for kiwi
#: data/json/items/comestibles/raw_fruit.json
msgid ""
"A large, brown and fuzzy-skinned berry.  Its delicious insides are green."
msgstr "Büyük, kahverengi ve tüylü kabuklu bir meyve. Lezzetli içi yeşildir."

#: data/json/items/comestibles/raw_fruit.json
msgid "apricots"
msgid_plural "apricots"
msgstr[0] "kayısı"
msgstr[1] "kayısılar"

#. ~ Description for {'str_sp': 'apricots'}
#: data/json/items/comestibles/raw_fruit.json
msgid "A smooth-skinned fruit, related to the peach."
msgstr "Şeftali ile akraba, pürüzsüz kabuklu bir meyve."

#: data/json/items/comestibles/raw_fruit.json
msgid "cholla bud"
msgid_plural "cholla buds"
msgstr[0] "cholla tomurcuğu"
msgstr[1] "cholla tomurcukları"

#. ~ Description for cholla bud
#: data/json/items/comestibles/raw_fruit.json
msgid ""
"Edible bud of a cholla cactus, with spines removed; the candy of the Mojave "
"indigenous peoples.  Tastes similar to asparagus."
msgstr ""
"Dikenleri çıkarılmış bir cholla kaktüsünün yenilebilir tomurcuğu; Mojave "
"yerli halkının şekeri. Kuşkonmaza benzer bir tadı vardır."

#: data/json/items/comestibles/raw_fruit.json
msgid "cactus pad"
msgid_plural "cactus pads"
msgstr[0] "kaktüs yastığı"
msgstr[1] "kaktüs yastıkları"

#. ~ Description for cactus pad
#: data/json/items/comestibles/raw_fruit.json
msgid "An edible pad of a cactus."
msgstr "Bir kaktüsün yenilebilir yastığı."

#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "barley"
msgid_plural "barleys"
msgstr[0] "arpa"
msgstr[1] "arpalar"

#. ~ Description for {'str': 'barley'}
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"Grainy cereal used for malting.  A staple of brewing everywhere.  It can "
"also be ground into flour."
msgstr ""
"Malt yapmak için kullanılan taneli tahıl. Her yerde bira yapımının "
"temelidir. Ayrıca un haline de getirilebilir."

#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "bee balm"
msgid_plural "bee balms"
msgstr[0] "arı balsamı"
msgstr[1] "arı balsamları"

#. ~ Description for {'str': 'bee balm'}
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A snow-white flower also known as wild bergamot.  Smells faintly of mint."
msgstr ""
"Kar beyazı bir çiçek, aynı zamanda yabani bergamot olarak da bilinir. "
"Hafifçe nane kokar."

#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "broccoli"
msgid_plural "broccoli"
msgstr[0] "brokoli"
msgstr[1] "brokoliler"

#. ~ Description for {'str_sp': 'broccoli'}
#: data/json/items/comestibles/raw_veggy.json
msgid "It's a bit tough, but quite delicious."
msgstr "Biraz sert, ama oldukça lezzetli."

#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "buckwheat"
msgid_plural "buckwheat"
msgstr[0] "karabuğday"
msgstr[1] "karabuğdaylar"

#. ~ Description for {'str_sp': 'buckwheat'}
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"Seeds from a wild buckwheat plant.  Not particularly good to eat in their "
"raw state, they are commonly cooked or ground into flour."
msgstr ""
"Yabani karabuğday bitkisinin tohumları. Çiğ halde pek iyi değildir, "
"genellikle pişirilir veya un haline getirilir."

#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "cabbage"
msgid_plural "cabbages"
msgstr[0] "lahana"
msgstr[1] "lahanalar"

#. ~ Description for cabbage
#: data/json/items/comestibles/raw_veggy.json
msgid "Crisp white cabbage."
msgstr "Gevrek beyaz lahana."

#: data/json/items/comestibles/raw_veggy.json
msgid "grape leaves"
msgid_plural "grape leaves"
msgstr[0] "asma yaprağı"
msgstr[1] "asma yaprakları"

#. ~ Description for {'str_sp': 'grape leaves'}
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"Edible leaves of a grape vine.  Typically used in salads or as food "
"wrapping."
msgstr ""
"Asma yaprağının yenilebilir yaprakları. Genellikle salatalarda veya yiyecek "
"sarması olarak kullanılır."

#: data/json/items/comestibles/raw_veggy.json
msgid "spinach"
msgid_plural "spinach"
msgstr[0] "ıspanak"
msgstr[1] "ıspanaklar"

#. ~ Description for {'str_sp': 'spinach'}
#: data/json/items/comestibles/raw_veggy.json
msgid "A bunch of spinach leaves."
msgstr "Bir demet ıspanak yaprağı."

#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "carrot"
msgid_plural "carrots"
msgstr[0] "havuç"
msgstr[1] "havuçlar"

#. ~ Description for {'str': 'carrot'}
#: data/json/items/comestibles/raw_veggy.json
msgid "A healthy root vegetable.  Rich in vitamin A!"
msgstr "Sağlıklı bir kök sebze. A vitamini açısından zengin!"

#: data/json/items/comestibles/raw_veggy.json
msgid "cattail rhizome"
msgid_plural "cattail rhizomes"
msgstr[0] "kedi kuyruğu rizomu"
msgstr[1] "kedi kuyruğu rizomları"

#. ~ Description for {'str': 'cattail rhizome'}
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A stout branching rhizome from a cattail plant.  Its crisp white flesh is "
"very starchy and fibrous, but you really ought to cook it before you attempt"
" to eat it."
msgstr ""
"Kabak bitkisinden gelen sağlam bir rizom. Gevrek beyaz eti çok nişastalı ve "
"liflidir, ama yemeye kalkışmadan önce gerçekten pişirmeniz gerekir."

#: data/json/items/comestibles/raw_veggy.json
msgid "cattail stalk"
msgid_plural "cattail stalks"
msgstr[0] "kedi kuyruğu sapı"
msgstr[1] "kedi kuyruğu sapları"

#. ~ Description for {'str': 'cattail stalk'}
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A stiff green stalk from a cattail plant.  It is starchy and fibrous, but it"
" would be much better if you cooked it."
msgstr ""
"Kabak bitkisinden gelen sert yeşil bir sap. Nişastalı ve liflidir, ama "
"pişirirseniz çok daha iyi olur."

#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "celery"
msgid_plural "celerys"
msgstr[0] "kereviz"
msgstr[1] "kerevizler"

#. ~ Description for celery
#: data/json/items/comestibles/raw_veggy.json
msgid "Neither tasty nor very nutritious, but it goes well with salad."
msgstr "Ne lezzetli ne de çok besleyici, ama salatayla iyi gider."

#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
#: data/json/items/comestibles/veggy_dishes.json
msgid "corn"
msgid_plural "corn"
msgstr[0] "mısır"
msgstr[1] "mısırlar"

#. ~ Description for {'str_sp': 'corn'}
#: data/json/items/comestibles/raw_veggy.json
msgid "Delicious golden kernels."
msgstr "Lezzetli altın taneler."

#: data/json/items/comestibles/raw_veggy.json
msgid "cotton boll"
msgid_plural "cotton bolls"
msgstr[0] "pamuk kozası"
msgstr[1] "pamuk kozaları"

#. ~ Description for {'str': 'cotton boll'}
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A tough protective capsule bulging with densely packed fibers and seeds, "
"this cotton boll can be processed into usable material with the right tools."
msgstr ""
"Yoğun lifler ve tohumlarla dolu, sert koruyucu bir kapsül olan bu pamuk "
"kozası, doğru araçlarla işlenerek kullanılabilir malzemeye dönüştürülebilir."

#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "chili pepper"
msgid_plural "chili peppers"
msgstr[0] "acı biber"
msgstr[1] "acı biberler"

#. ~ Description for chili pepper
#: data/json/items/comestibles/raw_veggy.json
msgid "Spicy chili pepper."
msgstr "Baharatlı acı biber."

#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "cucumber"
msgid_plural "cucumbers"
msgstr[0] "salatalık"
msgstr[1] "salatalıklar"

#. ~ Description for cucumber
#: data/json/items/comestibles/raw_veggy.json
msgid "Comes from the gourd family.  Not tasty but very juicy."
msgstr "Kabakgiller ailesinden gelir. Lezzetli değil ama çok sulu."

#: data/json/items/comestibles/raw_veggy.json
msgid "dahlia root"
msgid_plural "dahlia roots"
msgstr[0] "dahlia kökü"
msgstr[1] "dahlia kökleri"

#. ~ Description for dahlia root
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"The large, tuberous root of a dahlia flower.  It smells spicy, but is too "
"starchy to eat without cooking."
msgstr ""
"Bir dalya çiçeğinin büyük, yumrulu kökü. Baharatlı kokar, ancak pişirilmeden"
" yenemeyecek kadar nişastalıdır."

#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "salsify"
msgid_plural "salsify"
msgstr[0] "yılan otu"
msgstr[1] "yılan otu"

#. ~ Description for {'str_sp': 'salsify'}
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"An herb with a small purple flower.  The roots are nutritious, but tough and"
" bland until cooked."
msgstr ""
"Küçük mor çiçekli bir bitki. Kökleri besleyicidir, ancak pişirilene kadar "
"sert ve tatsızdır."

#. ~ Description for {'str_sp': 'chicory'}
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A modest blue flower.  The flower's roots are very bitter and not meant to "
"be eaten raw."
msgstr ""
"Mütevazı bir mavi çiçek. Çiçeğin kökleri çok acıdır ve çiğ yenmek için uygun"
" değildir."

#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "wild root"
msgid_plural "wild roots"
msgstr[0] "yabani kök"
msgstr[1] "yabani kökler"

#. ~ Description for {'str': 'wild root'}
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A weed with a cluster of tiny white flowers.  These are often wild carrots, "
"but beware of poisonous lookalikes."
msgstr ""
"Küçük beyaz çiçeklerden oluşan bir yabani ot. Bunlar genellikle yabani "
"havuçtur, ancak zehirli benzerlerine dikkat edin."

#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "dogbane"
msgid_plural "dogbanes"
msgstr[0] "köpek otu"
msgstr[1] "köpek otları"

#. ~ Description for dogbane
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A stalk of dogbane.  It has very fibrous stems and is mildly poisonous."
msgstr "Köpekbanotu sapı. Çok lifli sapları vardır ve hafif zehirlidir."

#: data/json/items/comestibles/raw_veggy.json
msgid "garlic bulb"
msgid_plural "garlic bulbs"
msgstr[0] "sarımsak başı"
msgstr[1] "sarımsak başları"

#. ~ Description for garlic bulb
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A pungent garlic bulb.  Popular as a seasoning for its strong flavor.  Can "
"be disassembled to cloves."
msgstr ""
"Keskin kokulu bir sarımsak başı. Güçlü aroması nedeniyle baharat olarak "
"popülerdir. Dişlere ayrılabilir."

#: data/json/items/comestibles/raw_veggy.json
msgid "hops flower"
msgid_plural "hops flowers"
msgstr[0] "şerbetçiotu çiçeği"
msgstr[1] "şerbetçiotu çiçekleri"

#. ~ Description for {'str': 'hops flower'}
#: data/json/items/comestibles/raw_veggy.json
msgid "A cluster of small cone-like flowers, indispensable for brewing beer."
msgstr ""
"Bira yapımında vazgeçilmez olan, küçük kozalak benzeri çiçeklerin bir "
"kümesi."

#: data/json/items/comestibles/raw_veggy.json
msgid "horseradish root"
msgid_plural "horseradish roots"
msgstr[0] "yaban turpu kökü"
msgstr[1] "yaban turpu kökleri"

#. ~ Description for {'str': 'horseradish root'}
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"Large white tapered root of a horseradish plant.  Way too spicy in this "
"form, but can be used for making condiments."
msgstr ""
"Beyaz yaban turpu bitkisinin büyük beyaz konik kökü. Bu haliyle çok acıdır, "
"ancak sos yapımında kullanılabilir."

#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "lettuce"
msgid_plural "lettuces"
msgstr[0] "marul"
msgstr[1] "marullar"

#. ~ Description for lettuce
#: data/json/items/comestibles/raw_veggy.json
msgid "A crisp head of iceberg lettuce."
msgstr "Buzdağı marulunun çıtır bir başı."

#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "mugwort"
msgid_plural "mugworts"
msgstr[0] "pelin otu"
msgstr[1] "pelin otları"

#. ~ Description for mugwort
#: data/json/items/comestibles/raw_veggy.json
msgid "A stalk of mugwort.  Smells wonderful."
msgstr "Misk otu sapı. Harika kokar."

#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "onion"
msgid_plural "onions"
msgstr[0] "soğan"
msgstr[1] "soğanlar"

#. ~ Description for onion
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"An aromatic onion used in cooking.  Cutting these up can make your eyes "
"sting!"
msgstr ""
"Yemek pişirmede kullanılan aromatik bir soğan. Bunları doğramak gözlerinizi "
"yakabilir!"

#: data/json/items/comestibles/raw_veggy.json
msgid "fungal fluid sac"
msgid_plural "fungal fluid sacs"
msgstr[0] "mantar sıvı kesesi"
msgstr[1] "mantar sıvı keseleri"

#. ~ Description for fungal fluid sac
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A fluid bladder from a fungus based lifeform.  Not very nutritious, but fine"
" to eat anyway."
msgstr ""
"Mantar bazlı bir yaşam formundan elde edilen sıvı bir kese. Çok besleyici "
"değil, ama yine de yenilebilir."

#: data/json/items/comestibles/raw_veggy.json
msgid "raw popcorn"
msgid_plural "raw popcorn"
msgstr[0] "çiğ patlamış mısır"
msgstr[1] "çiğ patlamış mısır"

#. ~ Description for {'str_sp': 'raw popcorn'}
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A special variety of corn which could be used for making popcorn, after it's"
" dried.  Unlike normal corn, it's not sweet and is more dry."
msgstr ""
"Kuruduktan sonra patlamış mısır yapımında kullanılabilecek özel bir mısır "
"çeşidi. Normal mısır gibi tatlı değil ve daha kurudur."

#: data/json/items/comestibles/raw_veggy.json
msgid "raw potato"
msgid_plural "raw potatoes"
msgstr[0] "çiğ patates"
msgstr[1] "çiğ patatesler"

#. ~ Description for {'str': 'raw potato', 'str_pl': 'raw potatoes'}
#: data/json/items/comestibles/raw_veggy.json
msgid "Mildly toxic and not very tasty raw.  When cooked, it is delicious."
msgstr ""
"Hafif zehirli ve çiğ olarak çok lezzetli değil. Pişirildiğinde ise "
"lezzetlidir."

#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "pumpkin"
msgid_plural "pumpkins"
msgstr[0] "balkabağı"
msgstr[1] "balkabakları"

#. ~ Description for pumpkin
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A large vegetable, about the size of your head.  Not very tasty raw, but is "
"great for cooking."
msgstr ""
"Başınız büyüklüğünde büyük bir sebze. Çiğ olarak çok lezzetli değil, ama "
"pişirmede harikadır."

#: data/json/items/comestibles/raw_veggy.json
msgid "horseradish greens"
msgid_plural "horseradish greens"
msgstr[0] "yaban turpu yaprakları"
msgstr[1] "yaban turpu yaprakları"

#. ~ Description for {'str_sp': 'horseradish greens'}
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"Leaves of a horseradish plant with a sharp, bitter and peppery taste.  "
"They're edible, but not commonly eaten."
msgstr ""
"Acı, keskin ve biberli bir tada sahip yaban turpu bitkisinin yaprakları. "
"Yenilebilirler, ancak genellikle yenmezler."

#: data/json/items/comestibles/raw_veggy.json
msgid "dandelions"
msgid_plural "dandelions"
msgstr[0] "karahindiba"
msgstr[1] "karahindibalar"

#. ~ Description for {'str_sp': 'dandelions'}
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A collection of freshly picked yellow dandelions.  In their current raw "
"state they are quite bitter."
msgstr ""
"Taze toplanmış sarı karahindiba çiçeklerinin bir koleksiyonu. Şu anki çiğ "
"halleri oldukça acıdır."

#: data/json/items/comestibles/raw_veggy.json
msgid "burdocks"
msgid_plural "burdocks"
msgstr[0] "dulavratotu"
msgstr[1] "dulavratotları"

#. ~ Description for {'str_sp': 'burdocks'}
#: data/json/items/comestibles/raw_veggy.json
msgid "Burdock, a bitter thistle-like vegetable.  Can be eaten raw or cooked."
msgstr ""
"Dulavratotu, acı bir deve dikeni benzeri sebze. Çiğ veya pişmiş olarak "
"yenebilir."

#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "rhubarb"
msgid_plural "rhubarbs"
msgstr[0] "ravent"
msgstr[1] "raventler"

#. ~ Description for rhubarb
#: data/json/items/comestibles/raw_veggy.json
msgid "Sour stems of the rhubarb plant, often used in baking pies."
msgstr "Genellikle turta yapımında kullanılan ekşi ravent bitkisinin sapları."

#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "sugar beet"
msgid_plural "sugar beets"
msgstr[0] "şeker pancarı"
msgstr[1] "şeker pancarları"

#. ~ Description for sugar beet
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"This fleshy root is ripe and flowing with sugars; just takes some processing"
" to extract them."
msgstr ""
"Bu etli kök olgunlaşmış ve şekerlerle doludur; sadece onları çıkarmak için "
"biraz işlem gerektirir."

#: data/json/items/comestibles/raw_veggy.json
msgid "tea leaf"
msgid_plural "tea leaves"
msgstr[0] "çay yaprağı"
msgstr[1] "çay yaprakları"

#. ~ Description for {'str': 'tea leaf', 'str_pl': 'tea leaves'}
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"Dried leaves of a tropical plant.  You can boil them into tea, or you can "
"just eat them raw.  They aren't too filling though."
msgstr ""
"Tropikal bir bitkinin kurutulmuş yaprakları. Onları çay yapmak için "
"kaynatabilir veya çiğ olarak yiyebilirsiniz. Ancak çok doyurucu değiller."

#: data/json/items/comestibles/raw_veggy.json
msgid "coca leaf"
msgid_plural "coca leaves"
msgstr[0] "koka yaprağı"
msgstr[1] "koka yaprakları"

