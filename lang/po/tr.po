#: data/json/professions.json
msgctxt "profession_male"
msgid "National Guard"
msgstr "Ulusal Muhafız"

#: data/json/professions.json
msgctxt "profession_female"
msgid "National Guard"
msgstr "Ulusal Muhafız"

#. ~ Profession (male National Guard) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"Your National Guard unit was activated when the epidemic struck.  Despite "
"your best efforts you did not manage to meet up with them before all "
"communications ceased and you found yourself alone amongst the dead."
msgstr ""
"Salgın başladığında Ulusal Muhafız birliğiniz göreve çağrıldı. Tüm "
"çabalarınıza rağmen, iletişim kesilmeden önce onlarla buluşmayı "
"başaramadınız ve kendinizi ölülerin arasında yalnız buldunuz."

#. ~ Profession (female National Guard) description
#: data/json/professions.json
