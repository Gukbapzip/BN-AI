msgstr[1] "çevresel elektrotlar"

#. ~ Description for {'str': 'peripheral electrode'}
#: data/mods/Aftershock/items/crafting_scrap/neural_io_scrap.json
msgid ""
"A thin strand of wire and a clamp, meant to be spliced into the smaller "
"nerves of the human body."
msgstr ""
"İnsan vücudunun daha küçük sinirlerine eklenmek üzere tasarlanmış ince bir "
"tel ve kelepçe."

#: data/mods/Aftershock/items/crafting_scrap/neural_io_scrap.json
