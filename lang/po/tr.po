msgstr "Harekete geçsek iyi olur."

#: data/json/npcs/talk_tags.json
msgid "Let's head out."
msgstr "Hadi çıkalım."

#: data/json/npcs/talk_tags.json
msgid "Time's a-wasting.  Let's head out."
msgstr "Zaman kaybediyoruz. Hadi çıkalım."

#: data/json/npcs/talk_tags.json
msgid "Come on.  We got stuff to do."
msgstr "Hadi. Yapacak işlerimiz var."

#: data/json/npcs/talk_tags.json
msgid "Let's hit the road."
msgstr "Yola çıkalım."

#: data/json/npcs/talk_tags.json
msgid "We'll pick this up another time.  Let's go."
msgstr "Bunu başka bir zaman devam ettiririz. Hadi gidelim."

#: data/json/npcs/talk_tags.json
msgid "Let's put a pin in this chat for now."
msgstr "Bu sohbeti şimdilik bir kenara bırakalım."

#: data/json/npcs/talk_tags.json
msgid "Talk to you later."
msgstr "Sonra konuşuruz."

#: data/json/npcs/talk_tags.json
