msgstr[1] "çırpılmış yumurta ve beyinler"

#. ~ Description for scrambled eggs and brain
#: data/json/items/comestibles/offal_dishes.json
msgid "Brains and eggs, why didn't you ever think to put these together?"
msgstr "Beyin ve yumurta, neden bunları bir araya getirmeyi hiç düşünmediniz?"

#: data/json/items/comestibles/offal_dishes.json
msgid "sausage casing"
msgid_plural "sausage casings"
msgstr[0] "sosis kılıfı"
msgstr[1] "sosis kılıfları"

#. ~ Description for {'str': 'sausage casing'}
#: data/json/items/comestibles/offal_dishes.json
msgid ""
"Sausage casings made from animal intestines.  Ready to be used for forming "
"meat products."
msgstr ""
"Hayvan bağırsaklarından yapılmış sosis kılıfları. Et ürünlerini "
"şekillendirmek için kullanıma hazır."

#: data/json/items/comestibles/offal_dishes.json
msgid "artificial sausage casing"
msgid_plural "artificial sausage casings"
msgstr[0] "yapay sosis kılıfı"
msgstr[1] "yapay sosis kılıfları"

#. ~ Description for {'str': 'artificial sausage casing'}
#: data/json/items/comestibles/offal_dishes.json
msgid ""
"Sausage casings made from plastic.  Ready to be used for forming meat "
"products."
msgstr ""
"Plastikten yapılmış sosis kılıfları. Et ürünlerini şekillendirmek için "
"kullanıma hazır."

#: data/json/items/comestibles/offal_dishes.json
