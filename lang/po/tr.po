msgstr[1] "sürüngen yumurtaları"

#. ~ Description for reptile egg
#: data/json/items/comestibles/egg.json
msgid "An egg belonging to one of reptile species found in New England."
msgstr "New England'da bulunan sürüngen türlerinden birine ait bir yumurta."

#: data/json/items/comestibles/egg.json
msgid "Insect Egg"
msgid_plural "Insect Eggs"
msgstr[0] "böcek yumurtası"
msgstr[1] "böcek yumurtaları"

#. ~ Description for Insect Egg
#: data/json/items/comestibles/egg.json
msgid ""
"An egg belonging to some kind of insect.  If you are seeing this then it is "
"a bug."
msgstr ""
"Bir tür böceğe ait bir yumurta. Eğer bunu görüyorsanız, bu bir hatadır."

#: data/json/items/comestibles/egg.json
msgid "ant egg"
msgid_plural "ant eggs"
msgstr[0] "karınca yumurtası"
msgstr[1] "karınca yumurtaları"

#. ~ Description for {'str': 'ant egg'}
#: data/json/items/comestibles/egg.json
msgid ""
"A large white ant egg, the size of a softball.  Extremely nutritious, but "
"incredibly gross."
msgstr ""
"Beyzbol topu büyüklüğünde büyük beyaz bir karınca yumurtası. Son derece "
"besleyici, ama inanılmaz derecede iğrenç."

#: data/json/items/comestibles/egg.json
msgid "spider egg"
msgid_plural "spider eggs"
msgstr[0] "örümcek yumurtası"
msgstr[1] "örümcek yumurtaları"

#. ~ Description for spider egg
#: data/json/items/comestibles/egg.json
msgid ""
"A egg from a giant spider, a bit bigger than a chicken one.  Incredibly "
"gross."
msgstr ""
"Dev bir örümcekten gelen, tavuk yumurtasından biraz daha büyük bir yumurta. "
"İnanılmaz derecede iğrenç."

#: data/json/items/comestibles/egg.json
msgid "roach egg"
msgid_plural "roach eggs"
msgstr[0] "hamam böceği yumurtası"
msgstr[1] "hamam böceği yumurtaları"

#. ~ Description for roach egg
#: data/json/items/comestibles/egg.json
msgid ""
"A egg from a giant roach, a bit bigger than a chicken one.  Incredibly "
"gross."
msgstr ""
"Dev bir hamam böceğinden gelen, tavuk yumurtasından biraz daha büyük bir "
"yumurta. İnanılmaz derecede iğrenç."

#: data/json/items/comestibles/egg.json
msgid "insect egg"
msgid_plural "insect eggs"
msgstr[0] "böcek yumurtası"
msgstr[1] "böcek yumurtaları"

#. ~ Description for insect egg
#: data/json/items/comestibles/egg.json
msgid "A egg from a locust, a bit bigger than a chicken one."
msgstr ""
"Bir çekirgeden gelen, tavuk yumurtasından biraz daha büyük bir yumurta."

#: data/json/items/comestibles/egg.json
msgid "firefly egg"
msgid_plural "firefly eggs"
msgstr[0] "ateşböceği yumurtası"
msgstr[1] "ateşböceği yumurtaları"

#. ~ Description for firefly egg
#: data/json/items/comestibles/egg.json
msgid "The fist-sized egg of a mutant firefly.  Glows faintly in the dark."
msgstr ""
"Mutant bir ateşböceğinin yumruğu büyüklüğündeki yumurtası. Karanlıkta "
"hafifçe parlıyor."

#: data/json/items/comestibles/egg.json
msgid "dragonfly egg"
msgid_plural "dragonfly eggs"
msgstr[0] "yusufçuk yumurtası"
msgstr[1] "yusufçuk yumurtaları"

#. ~ Description for dragonfly egg
#: data/json/items/comestibles/egg.json
msgid ""
"The still wet egg of a mutated dragonfly.  Serves as a disgusting substitute"
" for the real thing, just don't let it hatch in the water."
msgstr ""
"Mutant bir yusufçuk yumurtası, hala ıslak. Gerçek şeyin iğrenç bir yedeği "
"olarak hizmet eder, sadece suda çatlamasına izin vermeyin."

#: data/json/items/comestibles/egg.json
msgid "centipede egg"
msgid_plural "centipede eggs"
msgstr[0] "kırkayak yumurtası"
msgstr[1] "kırkayak yumurtaları"

#. ~ Description for centipede egg
#: data/json/items/comestibles/egg.json
msgid ""
"A large, soft egg you got from butchering a mutant centipede.  Inside, you "
"can already see a bundle of spindly legs, twitching in anticipation."
msgstr ""
"Mutant bir kırkayak keserek elde ettiğiniz büyük, yumuşak bir yumurta. "
"İçinde, sabırsızlıkla titreyen ince bacakların bir demetini zaten "
"görebilirsiniz."

#: data/json/items/comestibles/egg.json
msgid "wasp egg"
msgid_plural "wasp eggs"
msgstr[0] "eşek arısı yumurtası"
msgstr[1] "eşek arısı yumurtaları"

#. ~ Description for {'str': 'wasp egg'}
#: data/json/items/comestibles/egg.json
msgid ""
"A white, flexible wasp egg.  It looks like a pristine grain of rice, grown "
"to the size of your palm."
msgstr ""
"Beyaz, esnek bir yaban arısı yumurtası. Avuç içi büyüklüğüne kadar büyümüş, "
"kusursuz bir pirinç tanesi gibi görünüyor."

#: data/json/items/comestibles/egg.json
msgid "razorclaw roe"
msgid_plural "razorclaw roes"
msgstr[0] "razorclaw havyarı"
msgstr[1] "razorclaw havyarları"

#. ~ Description for razorclaw roe
#: data/json/items/comestibles/egg.json
msgid "A clump of razorclaw eggs.  A post-Cataclysm delicacy."
msgstr "Bir grup razorclaw yumurtası. Kıyamet sonrası bir lezzet."

#: data/json/items/comestibles/egg.json
msgid "roe"
msgid_plural "roes"
msgstr[0] "havyar"
msgstr[1] "havyarlar"

#. ~ Description for roe
#: data/json/items/comestibles/egg.json
msgid "Common roe from an unknown fish."
msgstr "Bilinmeyen bir balıktan gelen sıradan havyar."

#: data/json/items/comestibles/egg.json
msgid "powdered egg"
msgid_plural "powdered eggs"
msgstr[0] "toz yumurta"
msgstr[1] "toz yumurtalar"

#. ~ Description for {'str': 'powdered egg'}
#: data/json/items/comestibles/egg.json
msgid "Whole fresh eggs, dehydrated into an easy to store powder."
msgstr "Kolay saklanabilir bir toz haline getirilmiş bütün taze yumurtalar."

#: data/json/items/comestibles/egg.json
msgid "scrambled eggs"
msgid_plural "scrambled eggs"
msgstr[0] "çırpılmış yumurta"
msgstr[1] "çırpılmış yumurtalar"

#. ~ Description for {'str_sp': 'scrambled eggs'}
#: data/json/items/comestibles/egg.json
msgid "Fluffy and delicious scrambled eggs."
msgstr "Kabarmış ve lezzetli çırpılmış yumurta."

#: data/json/items/comestibles/egg.json
msgid "boiled egg"
msgid_plural "boiled eggs"
msgstr[0] "haşlanmış yumurta"
