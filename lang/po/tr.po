msgid_plural "movie posters"
msgstr[0] "film afişi"
msgstr[1] "film afişleri"

#. ~ Description for {'str': 'movie poster'}
#: data/json/items/newspaper.json
msgid "Posters promoting movies that were in theaters when the Cataclysm hit."
msgstr "Felaket vurduğunda sinemalarda olan filmleri tanıtan posterler."

#: data/json/items/newspaper.json
msgid ""
"Last Stand 2: Still Standing movie poster — the highly anticipated sequel "
