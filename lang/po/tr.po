msgstr "Küçük detayları fark ediyorsunuz!"

#. ~ Remove message for effect(s) 'Eagle's Sight'.
#: data/mods/MagicalNights/effects/effects.json
msgid "Your vision returns to normal."
msgstr "Görüşünüz normale dönüyor."

#. ~ Description of effect 'Cat's Grace'.
#: data/mods/MagicalNights/effects/effects.json
