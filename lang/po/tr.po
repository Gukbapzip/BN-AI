#: data/json/professions.json
msgctxt "profession_male"
msgid "Airship Captain"
msgstr "Hava Gemisi Kaptanı"

#: data/json/professions.json
msgctxt "profession_female"
msgid "Airship Captain"
msgstr "Hava Gemisi Kaptanı"

#. ~ Profession (male Airship Captain) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You once led a crew of skyfarers, traveling the skies for fame, bricks and "
"sand.  Now you are on your own, and the ground is swarming with zombies.  At"
" least this world has ground…"
msgstr ""
"Bir zamanlar gökyüzü kaşiflerinden oluşan bir mürettebata liderlik "
"ediyordunuz, şöhret, tuğla ve kum için gökyüzünde seyahat ediyordunuz. Şimdi"
" ise yalnızsınız ve yer zombilerle dolup taşıyor. En azından bu dünyanın bir"
" zemini var…"

#. ~ Profession (female Airship Captain) description
#: data/json/professions.json
msgctxt "prof_desc_female"
msgid ""
