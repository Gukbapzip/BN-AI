#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/furniture_and_terrain/terrain-doors.json
#: data/json/furniture_and_terrain/terrain-fences-gates.json
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "You finish cutting the metal."
msgstr "Metali kesmeyi bitirdiniz."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "wooden rack"
msgstr "ahşap raf"

#. ~ Description for wooden rack
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "A simple wooden rack.  Display your items on it."
msgstr "Basit bir ahşap raf. Eşyalarınızı üzerinde sergileyin."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "coat rack"
msgstr "portmanto"

#. ~ Description for coat rack
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "A hooked rack for hanging jackets and hats."
msgstr "Ceket ve şapka asmak için kancalı bir raf."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "recycle bin"
msgstr "geri dönüşüm kutusu"

#. ~ Description for recycle bin
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Stores items for recycling."
msgstr "Geri dönüşüm için eşyaları saklar."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "safe"
msgstr "kasa"

#. ~ Description for safe
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Holds items.  Securely."
msgstr "Eşyaları tutar. Güvenli bir şekilde."

#. ~ Description for safe
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "What needs protection like this?"
msgstr "Böyle neyi korumak gerekiyor?"

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "open safe"
msgstr "kasa aç"

#. ~ Description for open safe
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Grab the firearms!"
msgstr "Silahları kap!"

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "trash can"
msgstr "çöp kutusu"

#. ~ Description for trash can
#: data/json/furniture_and_terrain/furniture-storage.json
msgid ""
"One man's trash is another man's dinner.  Examine it to take down, if you "
"need an improvised bucket."
msgstr ""
"Birinin çöpü, diğerinin yemeğidir. İhtiyacınız varsa, doğaçlama bir kova "
"olarak kullanmak için inceleyin."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "wardrobe"
msgstr "gardırop"

#. ~ Description for wardrobe
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "A tall piece of furniture - basically a freestanding closet."
msgstr "Uzun bir mobilya parçası - temelde bağımsız bir dolap."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/mapgen/city_blocks/urban_37_office_tower_beehive.json
msgid "filing cabinet"
msgstr "dosya dolabı"

#. ~ Description for filing cabinet
#: data/json/furniture_and_terrain/furniture-storage.json
msgid ""
"A set of drawers in a sturdy metal cabinet, used to hold files.  It can be "
"locked to protect important information.  If you're lucky, there are often "
"keys nearby."
msgstr ""
"Dosyaları saklamak için kullanılan sağlam bir metal dolapta bir dizi "
"çekmece. Önemli bilgileri korumak için kilitlenebilir. Şanslıysanız, "
"genellikle yakınlarda anahtarlar bulunur."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "utility shelf"
msgstr "alet rafı"

#. ~ Description for utility shelf
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "A simple heavy-duty plastic and metal shelving unit."
msgstr "Basit, dayanıklı plastik ve metalden yapılmış bir raf ünitesi."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "warehouse shelf"
msgstr "depo rafı"

#. ~ Description for warehouse shelf
#: data/json/furniture_and_terrain/furniture-storage.json
msgid ""
"A large, sturdy shelf made of metal for storing pallets and crates in "
"warehouses."
msgstr ""
"Depolarda palet ve kasaları saklamak için kullanılan büyük, sağlam metal "
"raf."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "wooden keg"
msgstr "ahşap fıçı"

#. ~ Description for wooden keg
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "A keg made mostly of wood.  Holds liquids, preferably alcoholic."
msgstr ""
"Çoğunlukla ahşaptan yapılmış bir fıçı. Sıvıları, tercihen alkollü olanları "
"saklar."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "display case"
msgstr "vitrin"

#. ~ Description for display case
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Display your stuff fancily and securely."
msgstr "Eşyalarınızı şık ve güvenli bir şekilde sergileyin."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "You pry open the display case."
msgstr "Vitrini açmak için zorluyorsunuz."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "You pry, but cannot pry open the display."
msgstr "Zorluyorsunuz, ancak vitrini açamıyorsunuz."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "You break the glass."
msgstr "Camı kırıyorsunuz."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "With a satisfying click, the display case slides open."
msgstr "Tatmin edici bir tıklama ile vitrin açılır."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "broken display case"
msgstr "kırık vitrin"

#. ~ Description for broken display case
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Display your stuff.  It'll get stolen."
msgstr "Eşyalarını sergile. Çalınacak."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "unlocked display case"
msgstr "kilidi açılmış vitrin"

#. ~ Description for unlocked display case
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Display your stuff.  Not very secure anymore, but still looks nice."
msgstr ""
"Eşyalarını sergile. Artık çok güvenli değil, ama hâlâ güzel görünüyor."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "standing tank"
msgstr "ayakta duran tank"

#. ~ Description for standing tank
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "A large freestanding metal tank, useful for holding liquids."
msgstr "Sıvı tutmak için kullanışlı, büyük, bağımsız bir metal tank."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "standing tank (plumbed)"
msgstr "ayakta duran tank (tesisatlı)"

#. ~ Description for standing tank (plumbed)
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "A large freestanding metal tank hooked into a fluid grid."
msgstr "Bir sıvı ağına bağlı, büyük, bağımsız bir metal tank."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "clay water pots"
msgstr "kil su kapları"

#. ~ Description for clay water pots
#: data/json/furniture_and_terrain/furniture-storage.json
msgid ""
"Four large water pots together in a corner, holding up to 150 liters of a "
"single type of liquid.  It is quite fragile but can be constructed and "
"removed without tools."
msgstr ""
"Bir köşede birlikte duran dört büyük su kabı, tek tip sıvıdan 150 litreye "
"kadar tutabilir. Oldukça kırılgandır ancak alet kullanmadan inşa edilebilir "
"ve çıkarılabilir."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "ceramic shattering!"
msgstr "seramik parçalanıyor!"

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "dumpster"
msgstr "çöp kutusu"

#. ~ Description for dumpster
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Stores trash.  Doesn't get picked up anymore.  Note the smell."
msgstr "Çöp depolar. Artık toplanmıyor. Kokuyu not edin."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "butter churn"
msgstr "tereyağı yayığı"

#. ~ Description for butter churn
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "A pedal driven butter churn."
msgstr "Pedal ile çalışan bir tereyağı yayığı."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "atomic butter churn on a stand"
msgstr "stand üzerinde atomik tereyağı yayığı"

#. ~ Description for atomic butter churn on a stand
#: data/json/furniture_and_terrain/furniture-storage.json
msgid ""
"The Rivtech Atomic Butter Churn in deployed state.  It hums menacingly.  "
"Ready to add raw milk and salt.  It will churn till the earth is a cinder."
msgstr ""
"Rivtech Atomik Tereyağı Yayığı konuşlandırılmış durumda. Tehditkar bir "
"şekilde uğulduyor. Çiğ süt ve tuz eklemeye hazır. Dünya kül olana kadar "
"yayacak."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "metal foot locker"
msgstr "metal ayaklı sandık"

#. ~ Description for metal foot locker
#: data/json/furniture_and_terrain/furniture-storage.json
msgid ""
"A metal storage box, capable of holding any number of things.  The lid has "
"has a small lock."
msgstr ""
"Her türlü şeyi tutabilen metal bir saklama kutusu. Kapağında küçük bir kilit"
" var."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "wooden chest"
msgstr "ahşap sandık"

#. ~ Description for wooden chest
#: data/json/furniture_and_terrain/furniture-storage.json
msgid ""
"A nice big wooden box with a hinged lid, to store all manner of things in."
msgstr ""
"Her türlü şeyi saklamak için menteşeli kapağı olan güzel büyük bir ahşap "
"kutu."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "counter"
msgstr "tezgah"

#. ~ Description for counter
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "Affixed to the wall or found in kitchens or stores."
msgstr "Duvara monte edilmiş veya mutfaklarda ya da mağazalarda bulunur."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "cupboard"
msgstr "dolap"

#. ~ Description for cupboard
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "Store your cups."
msgstr "Bardaklarınızı saklayın."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "closed counter gate"
msgstr "kapalı tezgah kapısı"

#. ~ Description for closed counter gate
#. ~ Description for open counter gate
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid ""
"A commercial quality swinging door made of wood that allows passage behind "
"counters."
msgstr ""
"Tezgahların arkasına geçişe izin veren, ahşaptan yapılmış ticari kalitede "
"bir salıncak kapı."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "open counter gate"
msgstr "açık tezgah kapısı"

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "desk"
msgstr "masa"

#. ~ Description for desk
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "Sit down at it or work on it."
msgstr "Üzerinde oturun veya üzerinde çalışın."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/items/vehicle/tables.json data/json/vehicleparts/crafting.json
msgid "workbench"
msgid_plural "workbenches"
msgstr[0] "tezgah"
msgstr[1] "tezgahlar"

#. ~ Description for workbench
#. ~ Description for {'str': 'workbench', 'str_pl': 'workbenches'}
#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/items/vehicle/tables.json
msgid ""
"A sturdy workbench built out of metal.  It is perfect for crafting large and"
" heavy things."
msgstr ""
"Metalden yapılmış sağlam bir çalışma tezgahı. Büyük ve ağır şeyler üretmek "
"için mükemmeldir."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "survivor workbench"
msgstr "hayatta kalma tezgahı"

#. ~ Description for survivor workbench
#. ~ Description for {'str': 'survivors workbench', 'str_pl': 'survivors
#. workbenches'}
#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/items/vehicle/tables.json
msgid ""
"A sturdy workbench built out of metal.  It is perfect for crafting large and"
" heavy things.  This one contains a few extra tools and supplies, making it "
"more useful than a standard workbench."
msgstr ""
"Metalden yapılmış sağlam bir çalışma tezgahı. Büyük ve ağır şeyler üretmek "
"için mükemmeldir. Bu tezgah, birkaç ekstra araç ve malzeme içerir, bu da onu"
" standart bir tezgahdan daha kullanışlı hale getirir."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "robotic workbench"
msgstr "robotik tezgah"

#. ~ Description for robotic workbench
#. ~ Description for {'str': 'robobench', 'str_pl': 'robobenches'}
#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/items/vehicle/tables.json
msgid ""
"Having upgraded the basic workbench, you've now created a robotic workbench "
"that helps speed up crafting."
msgstr ""
"Temel çalışma tezgahını yükselterek, artık üretim hızını artıran bir robotik"
" tezgah oluşturdunuz."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/items/tool/deployable.json
msgid "leather tarp"
msgid_plural "leather tarps"
msgstr[0] "deri branda"
msgstr[1] "deri brandalar"

#. ~ Description for leather tarp
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid ""
"A large sheet of sewn leather that can be used instead of a picnic blanket, "
"but it's more valuable as a butchery appliance as it does not soak in blood."
msgstr ""
"Piknik örtüsü yerine kullanılabilecek büyük bir dikilmiş deri levha, ancak "
"kanı emmediği için kasaplık aleti olarak daha değerlidir."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "plastic groundsheet"
msgstr "plastik yer örtüsü"

#. ~ Description for plastic groundsheet
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid ""
"A large sheet of thick plastic has been tossed on the ground here.  It would"
" be a useful place to do some butchery, perhaps."
msgstr ""
"Buraya yere atılmış kalın plastikten büyük bir levha. Belki de kasaplık "
"yapmak için kullanışlı bir yer olabilir."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "whuff!"
msgstr "vuff!"

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "crinkle."
msgstr "kıvrım."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/items/tool/deployable.json
msgid "fiber mat"
msgid_plural "fiber mats"
msgstr[0] "elyaf mat"
msgstr[1] "elyaf matlar"

#. ~ Description for fiber mat
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid ""
"A large mat woven from fibrous material that can be used instead of a picnic"
" blanket, but it's more valuable as a butchery appliance.  Too thin to be a "
"comfortable sleeping place."
msgstr ""
"Lifli malzemeden dokunmuş büyük bir hasır, piknik örtüsü yerine "
"kullanılabilir, ancak kasaplık aleti olarak daha değerlidir. Rahat bir uyuma"
" yeri olacak kadar kalın değildir."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/items/tool/deployable.json
msgid "tourist table"
msgid_plural "tourist tables"
msgstr[0] "turist masası"
msgstr[1] "turist masaları"

#. ~ Description for tourist table
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid ""
"Small metal folding table, ideal for off-road trips into the wild.  Can be "
"used as a workbench in a pinch, or tipped over to create a more solid "
"obstacle."
msgstr ""
"Küçük metal katlanır masa, vahşi doğaya yapılan arazi gezileri için "
"idealdir. Acil durumlarda bir çalışma tezgahı olarak kullanılabilir veya "
"daha sağlam bir engel oluşturmak için devrilebilir."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "Flip tourist table"
msgstr "Turist masasını çevir"

#. ~ Message for furniture 'tourist table'
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "You knock the tourist table onto its side."
msgstr "Turist masasını yan çeviriyorsunuz."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "flipped tourist table"
msgstr "devrilmiş turist masası"

#. ~ Description for flipped tourist table
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid ""
"This little metal table looks like a bear's had lunch off it.  Examine it to"
" set it back upright to be less of a tripping hazard."
msgstr ""
"Bu küçük metal masa, sanki bir ayı üzerinde öğle yemeği yemiş gibi "
"görünüyor. Daha az bir takılma tehlikesi olması için onu tekrar dik hale "
"getirmek için inceleyin."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "Set tourist table upright"
msgstr "Turist masasını dik hale getir"

#. ~ Message for furniture 'flipped tourist table'
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "You set the tourist table back upright."
msgstr "Turist masasını tekrar dik hale getiriyorsunuz."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/vehicleparts/furniture.json
msgid "table"
msgstr "masa"

#. ~ Description for table
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid ""
"Sit down when you eat!  Examine to flip it on its side if you're feeling "
"angry, or want a barricade in a hurry."
msgstr ""
"Yemek yerken otur! Sinirli hissediyorsan ya da aceleyle bir barikat "
"istiyorsan, yan çevirmek için incele."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "Flip table"
msgstr "Masayı çevir"

#. ~ Message for furniture 'table'
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "You flip the table onto its side."
msgstr "Masayı yanına çeviriyorsun."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "flipped table"
msgstr "yan çevrilmiş masa"

#. ~ Description for flipped table
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid ""
"Not so good for eating on, but will buy you a few more seconds before the "
"zombies eat you.  Examine to set it back up for more civilized uses."
msgstr ""
"Üzerinde yemek yemek için pek iyi değil, ama zombiler seni yemeden önce "
"birkaç saniye kazandırır. Daha medeni kullanımlar için tekrar kurmak üzere "
"incele."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "Set table upright"
msgstr "Masayı dikleştir"

#. ~ Message for furniture 'flipped table'
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "You set the table back on its feet."
msgstr "Masayı tekrar ayakları üzerine koyuyorsun."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "coffee table"
msgstr "sehpa"

#. ~ Description for coffee table
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid ""
"a low table for livingrooms.  Examine it to tip it onto its side, to slow "
"down the horde in a pinch."
msgstr ""
"Oturma odaları için alçak bir masa. Acil bir durumda kalabalığı yavaşlatmak "
"için yan çevirmek üzere incele."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "Flip coffee table"
msgstr "Sehpayı çevir"

#. ~ Message for furniture 'coffee table'
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "You kick the coffee table onto its side."
msgstr "Kahve masasını yanına devirdin."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "flipped coffee table"
msgstr "devrilmiş kahve masası"

#. ~ Description for flipped coffee table
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "a low table knocked onto its side.  Examine to upright it."
msgstr "yanına devrilmiş alçak bir masa. Düzeltmek için incele."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "Set coffee table upright"
msgstr "Kahve masasını dikleştir"

#. ~ Message for furniture 'flipped coffee table'
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "You tip the coffee table back onto its feet."
msgstr "Kahve masasını tekrar ayaklarının üzerine dikersin."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "tatami mat"
msgstr "tatami minderi"

#. ~ Description for tatami mat
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"A tatami is a type of mat used as a flooring material in traditional "
"Japanese-style rooms."
msgstr ""
"Tatami, geleneksel Japon tarzı odalarda zemin kaplama malzemesi olarak "
"kullanılan bir minder türüdür."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "pillow fort"
msgstr "yastık kale"

#. ~ Description for pillow fort
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "A comfy place to hide from the world.  Not very defensible, though."
msgstr "Dünyadan saklanmak için rahat bir yer. Ancak çok savunmasız."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "paf!"
msgstr "paf!"

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "cardboard fort"
msgstr "karton kale"

#. ~ Description for cardboard fort
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"A fort built by tipping a cardboard box on its side, lining it with "
"blankets, and partly weather sealing it with a plastic sheet."
msgstr ""
"Yan yatırılmış bir karton kutu ile inşa edilmiş, içi battaniyelerle "
"kaplanmış ve kısmen plastik bir örtü ile hava koşullarına karşı korunmuş bir"
" kale."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "cardboard wall"
msgstr "karton duvar"

#. ~ Description for cardboard wall
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"This is a pile of cardboard boxes that have been filled with rags and junk "
"and stacked together like bricks to form a wall."
msgstr ""
"Bu, tuğla gibi üst üste yığılmış, paçavralar ve hurda ile doldurulmuş karton"
" kutulardan oluşan bir duvardır."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "cardboard floor"
msgstr "karton zemin"

#. ~ Description for cardboard floor
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"A flat floor made of sheets of cardboard duct-taped together overtop a "
"plastic sheet."
msgstr ""
"Plastik bir örtünün üzerine bantlanarak birleştirilmiş karton levhalardan "
"yapılmış düz bir zemin."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "cardboard roof"
msgstr "karton çatı"

#. ~ Description for cardboard roof
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"A sloped roof made of cardboard boxes, stuffed with scrap cardboard and "
"paper and layered atop each other.  Sheets of plastic are carefully arrayed "
"on top to shed water.  It looks like it could last a season or two at least "
"before crumbling."
msgstr ""
"Karton kutulardan yapılmış, hurda karton ve kağıtla doldurulmuş ve üst üste "
"katmanlanmış eğimli bir çatı. Üzerine dikkatlice yerleştirilmiş plastik "
"levhalar suyu uzaklaştırır. En az bir veya iki sezon dayanacak gibi "
"görünüyor."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "cardboard door"
msgstr "karton kapı"

#. ~ Description for cardboard door
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"This is a pile of cardboard boxes that have been filled with rags and junk "
"and stacked together like bricks to form a wall.  The largest box has been "
"cut open and folded to form a makeshift door, which is open."
msgstr ""
"Bu, tuğla gibi üst üste yığılmış, paçavralar ve hurda ile doldurulmuş karton"
" kutulardan oluşan bir duvardır. En büyük kutu kesilerek açılmış ve geçici "
"bir kapı oluşturacak şekilde katlanmıştır, kapı açıktır."

#. ~ Description for cardboard door
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"This is a pile of cardboard boxes that have been filled with rags and junk "
"and stacked together like bricks to form a wall.  The largest box has been "
"cut open and folded to form a makeshift door, which is closed."
msgstr ""
"Bu, duvar oluşturmak için tuğla gibi üst üste yığılmış paçavralar ve hurda "
"ile doldurulmuş karton kutular yığınıdır. En büyük kutu kesilmiş ve geçici "
"bir kapı oluşturacak şekilde katlanmış, kapalı durumda."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "beaded curtain"
msgstr "boncuklu perde"

#. ~ Description for beaded curtain
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "This beaded curtain could be pulled aside."
msgstr "Bu boncuklu perde kenara çekilebilir."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "clickity clack… clack… clack"
msgstr "tıngır mıngır… tık… tık"

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "clickity clack… clack"
msgstr "tıngır mıngır… tık"

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "open beaded curtain"
msgstr "boncuklu perdeyi aç"

#. ~ Description for open beaded curtain
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "This beaded curtain has been pulled aside."
msgstr "Bu boncuklu perde kenara çekilmiş."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "clickity clack… clack… clack!"
msgstr "tıngır mıngır… tık… tık!"

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "canvas floor"
msgstr "branda zemin"

#. ~ Description for canvas floor
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"Flooring made out of stretched, waterproof cloth.  Helps keep the dirt out "
"of the tent."
msgstr ""
"Gerilmiş, su geçirmez kumaştan yapılmış zemin. Çadırın içine kir girmesini "
"engellemeye yardımcı olur."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "skylight canvas floor"
msgstr "gökyüzü pencereli kanvas zemin"

#. ~ Description for skylight canvas floor
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"Flooring made out of stretched, waterproof cloth.  Helps keep the dirt out "
"of the tent. Has a plastic skylight to let light"
msgstr ""
"Gerilmiş, su geçirmez kumaştan yapılmış zemin. Çadırın içine kir girmesini "
"engeller. Işık girmesi için plastik bir gökyüzü penceresi vardır."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "canvas wall"
msgstr "kanvas duvar"

#. ~ Description for canvas wall
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"A wall made of stretched, waterproof cloth and supported by wooden or metal "
"stakes."
msgstr ""
"Gerilmiş, su geçirmez kumaştan yapılmış ve ahşap veya metal kazıklarla "
"desteklenmiş bir duvar."

#: data/json/furniture_and_terrain/furniture-terrains.json
#: data/json/furniture_and_terrain/terrain-doors.json
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-roofs.json
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "slap!"
msgstr "şlap!"

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "heavy-duty canvas wall"
msgstr "ağır hizmet tipi kanvas duvar"

#. ~ Description for heavy-duty canvas wall
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"A wall made of stretched, waterproof cloth and supported by wooden or metal "
"stakes. It has been strenghtened with plastic sheets."
msgstr ""
"Gerilmiş, su geçirmez kumaştan yapılmış ve ahşap veya metal kazıklarla "
"desteklenmiş bir duvar. Plastik levhalarla güçlendirilmiştir."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "canvas flap"
msgstr "kanvas kapak"

#. ~ Description for canvas flap
#. ~ Description for heavy-duty canvas flap
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"This canvas flap door could be pulled aside. If you examine it closely, you "
"could peek outside."
msgstr ""
"Bu kanvas kapı kenara çekilebilir. Yakından incelerseniz dışarıyı "
"gözetleyebilirsiniz."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "open canvas flap"
msgstr "kanvas kapağı aç"

#. ~ Description for open canvas flap
#. ~ Description for open heavy-duty canvas flap
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "This canvas flap door has been pulled aside."
msgstr "Bu branda kapısı kenara çekilmiş."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "heavy-duty canvas flap"
msgstr "ağır hizmet tipi branda kapı"

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "open heavy-duty canvas flap"
msgstr "açık ağır hizmet tipi branda kapı"

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "groundsheet"
msgstr "yer örtüsü"

#. ~ Description for groundsheet
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "This plastic groundsheet could keep you dry."
msgstr "Bu plastik yer örtüsü sizi kuru tutabilir."

#. ~ Description for groundsheet
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "This large plastic groundsheet could keep you dry."
msgstr "Bu büyük plastik yer örtüsü sizi kuru tutabilir."

#. ~ Description for groundsheet
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"This plastic government-issue groundsheet could keep you dry, but was made "
"by the lowest bidder."
msgstr ""
"Bu plastik devlet malı yer örtüsü sizi kuru tutabilir, ancak en düşük "
"teklifi verene yaptırılmış."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "animalskin wall"
msgstr "hayvan derisi duvar"

#. ~ Description for animalskin wall
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "Wall made out of animal skin.  Either an amazing or horrifying sight."
msgstr ""
"Hayvan derisinden yapılmış duvar. Ya harika ya da korkunç bir manzara."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "animalskin flap"
msgstr "hayvan derisi kapak"

#. ~ Description for animalskin flap
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "This animal skin flap could be pulled aside."
msgstr "Bu hayvan derisi kanadı kenara çekilebilir."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "open animalskin flap"
msgstr "hayvan derisi kanadını aç"

#. ~ Description for open animalskin flap
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "This animal skin flap has been pulled aside."
msgstr "Bu hayvan derisi kanadı kenara çekilmiş."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "animalskin floor"
msgstr "hayvan derisi zemin"

#. ~ Description for animalskin floor
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "This animal skin groundsheet could keep you dry."
msgstr "Bu hayvan derisi yer örtüsü seni kuru tutabilir."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "pile of rubble"
msgstr "moloz yığını"

#. ~ Description for pile of rubble
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"Pile of various metals, bricks, and other building materials.  You could "
"clear it with a shovel."
msgstr ""
"Çeşitli metaller, tuğlalar ve diğer yapı malzemelerinden oluşan yığın. Bir "
"kürekle temizleyebilirsin."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "pile of rocky rubble"
msgstr "kayalık moloz yığını"

#. ~ Description for pile of rocky rubble
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "Pile of rocks.  Useless?"
msgstr "Taş yığını. İşe yaramaz mı?"

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "pile of trashy rubble"
msgstr "çöplük moloz yığını"

#. ~ Description for pile of trashy rubble
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"Trash topped with dirt and grass, it smells gross, but another man's trash…"
msgstr "Kir ve çimenle kaplanmış çöp, kötü kokuyor, ama birinin çöpü..."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "pile of floating trash"
msgstr "yüzen çöp yığını"

#. ~ Description for pile of floating trash
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "Trash floating in the water. I guess it really does all end up here..."
msgstr "Suda yüzen çöp. Sanırım gerçekten hepsi buraya geliyor..."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "metal wreckage"
msgstr "metal enkaz"

#. ~ Description for metal wreckage
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "Pile of various bent and twisted metals."
msgstr "Çeşitli bükülmüş ve kıvrılmış metallerin yığını."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "pile of ash"
msgstr "kül yığını"

#. ~ Description for pile of ash
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "Some ash, from wood or possibly bodies."
msgstr "Odun veya muhtemelen cesetlerden kalan kül."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "small boulder"
msgstr "küçük kaya"

#. ~ Description for small boulder
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"Blocking your path.  Should be easy to move.  It can be used as a primitive "
"anvil."
msgstr ""
"Yolunu kapatıyor. Hareket ettirmesi kolay olmalı. İlkel bir örs olarak "
"kullanılabilir."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "upturned small boulder"
msgstr "ters dönmüş küçük kaya"

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "medium boulder"
msgstr "orta boy kaya"

#. ~ Description for medium boulder
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"Blocking your path.  It'll be a struggle to move.  It can be used as a "
"primitive anvil."
msgstr ""
"Yolunu kapatıyor. Hareket ettirmek için uğraşman gerekecek. İlkel bir örs "
"olarak kullanılabilir."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "large boulder"
msgstr "büyük kaya"

#. ~ Description for large boulder
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "Now how are you going to move this?"
msgstr "Bunu nasıl hareket ettireceksin?"

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "street light"
msgstr "sokak lambası"

#. ~ Description for street light
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"Raised source of light which used to illuminate streets and their "
"surrounding area, but it's useless without electricity."
msgstr ""
"Sokakları ve çevresini aydınlatmak için kullanılan yükseltilmiş ışık "
"kaynağı, ancak elektriksiz işe yaramaz."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "traffic light"
msgstr "trafik lambası"

#. ~ Description for traffic light
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"Signaling device positioned at road intersections and pedestrian crossings "
"to control flows of traffic, but it's useless without electricity."
msgstr ""
"Yol kavşaklarında ve yaya geçitlerinde trafik akışını kontrol etmek için "
"konumlandırılmış sinyal cihazı, ancak elektriksiz işe yaramaz."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "utility pole"
msgstr "elektrik direği"

#. ~ Description for utility pole
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"A long wooden post which used to support overhead power lines and other "
"public utilities, but it doesn't work anymore."
msgstr ""
"Hava hattı enerji hatlarını ve diğer kamu hizmetlerini desteklemek için "
"kullanılan uzun ahşap direk, ancak artık çalışmıyor."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "concrete lump"
msgstr "beton yığını"

#. ~ Description for concrete lump
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"The result of you pouring concrete over mi-go gas emitters.  It's stuck to "
"the floor.  It can be used as a primitive anvil."
msgstr ""
"Betonun mi-go gaz yayıcılarının üzerine dökülmesi sonucu oluşan. Zemine "
"yapışmış durumda. İlkel bir örs olarak kullanılabilir."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "flagpole"
msgstr "bayrak direği"

#. ~ Description for flagpole
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"An old metal flagpole, with no flag to fly.  Don't lick it if it's cold out."
msgstr "Bayraksız eski bir metal bayrak direği. Hava soğuksa yalamayın."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "flagpole with American flag"
msgstr "Amerikan bayraklı bayrak direği"

#. ~ Description for flagpole with American flag
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"An old metal flagpole flying an American flag.  A leftover from before the "
"world ended, you could take it down if you need one for some reason."
msgstr ""
"Amerikan bayrağı dalgalanan eski bir metal bayrak direği. Dünyanın sonundan "
"önce kalmış, bir sebeple ihtiyacınız varsa indirebilirsiniz."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "wooden flagpole"
msgstr "ahşap bayrak direği"

#. ~ Description for wooden flagpole
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "A makeshift flagpole constructed from a wooden beam and rope."
msgstr "Ahşap bir kiriş ve ipten yapılmış geçici bir bayrak direği."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "wooden flagpole with American flag"
msgstr "Amerikan bayraklı ahşap bayrak direği"

#. ~ Description for wooden flagpole with American flag
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "Someone's hoisted an old American flag from this makeshift flagpole."
msgstr "Birisi bu geçici bayrak direğine eski bir Amerikan bayrağı çekmiş."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "flagpole with Jolly Roger"
msgstr "Jolly Roger'lı bayrak direği"

#. ~ Description for flagpole with Jolly Roger
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "An old metal flagpole, now flying a black pirate flag."
msgstr ""
"Eskiden metal olan bir bayrak direği, şimdi siyah bir korsan bayrağı "
"dalgalanıyor."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "wooden flagpole with Jolly Roger"
msgstr "Jolly Roger'lı ahşap bayrak direği"

#. ~ Description for wooden flagpole with Jolly Roger
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "Someone's hoisted a black pirate flag from this makeshift flagpole."
msgstr "Birisi bu geçici bayrak direğinden siyah bir korsan bayrağı çekmiş."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "room divider"
msgstr "oda bölücü"

#. ~ Description for room divider
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "A tall piece of furniture used to divide rooms into separate areas."
msgstr ""
"Odaları ayrı alanlara ayırmak için kullanılan uzun bir mobilya parçası."

#: data/json/furniture_and_terrain/furniture-terrains.json
#: data/json/obsoletion/uncategorized.json
msgid "tarp lean-to"
msgstr "branda barınağı"

#. ~ Description for tarp lean-to
#: data/json/furniture_and_terrain/furniture-terrains.json
#: data/json/obsoletion/uncategorized.json
msgid ""
"A small shelter covered by waterproof tarp, that can be used to take refuge "
"from the elements."
msgstr ""
"Su geçirmez branda ile kaplanmış, hava koşullarından korunmak için "
"kullanılabilecek küçük bir barınak."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "leather tarp lean-to"
msgstr "deri branda barınağı"

#. ~ Description for leather tarp lean-to
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"A makeshift shelter made from a lather tarp and stakes driven into the "
"ground."
msgstr ""
"Deri bir branda ve yere çakılmış kazıklarla yapılan geçici bir barınak."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "broken console"
msgstr "bozuk konsol"

#. ~ Description for broken console
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a standalone computer terminal.  It doesn't seem to be working.  "
"It's the broken screen and shattered circuit boards that's telling you that."
msgstr ""
"Bu, bağımsız bir bilgisayar terminali. Çalışıyor gibi görünmüyor. Kırık "
"ekran ve parçalanmış devre kartları bunu size söylüyor."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "computer console"
msgstr "bilgisayar konsolu"

#. ~ Description for computer console
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a standalone computer terminal.  It can be used to view contents and"
" perform any allowed functions.  It might even be possible to hack it, given"
" the skills."
msgstr ""
"Bu, bağımsız bir bilgisayar terminali. İçeriği görüntülemek ve izin verilen "
"herhangi bir işlevi gerçekleştirmek için kullanılabilir. Yeterli beceriye "
"sahipseniz, belki de hacklemek bile mümkün olabilir."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
msgid "artifact analyzer console"
msgid_plural "artifact analyzer consoles"
msgstr[0] "eser analizörü konsolu"
msgstr[1] "eser analizörü konsolları"

#. ~ Description for artifact analyzer console
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A research console configured to analyze artifacts.  Use it to scan any "
"artifacts you are carrying."
msgstr ""
"Eserleri analiz etmek için yapılandırılmış bir araştırma konsolu. "
"Taşıdığınız eserleri taramak için kullanın."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "forge"
msgstr "dövme ocağı"

#. ~ Description for forge
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "Metalworking station typically used in combination with an anvil."
msgstr "Genellikle bir örs ile birlikte kullanılan metal işleme istasyonu."

#. ~ Description for anvil
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "Used in metalworking."
msgstr "Metal işleme için kullanılır."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/tool/cooking.json
msgid "still"
msgid_plural "stills"
msgstr[0] "damıtma cihazı"
msgstr[1] "damıtma cihazları"

#. ~ Description for still
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"An essential component for brewing and chemistry that allows for refining "
"liquid mixtures."
msgstr ""
"Sıvı karışımların rafine edilmesine olanak tanıyan, bira yapımı ve kimya "
"için temel bir bileşen."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/tool/metalworking.json
msgid "charcoal kiln"
msgid_plural "charcoal kilns"
msgstr[0] "odun kömürü fırını"
msgstr[1] "odun kömürü fırınları"

#. ~ Description for charcoal kiln
#. ~ Description for filled charcoal kiln
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A rock kiln designed to burn wood and organic material into charcoal in "
"absence of oxygen."
msgstr ""
"Oksijen yokluğunda odun ve organik malzemeleri kömüre dönüştürmek için "
"tasarlanmış bir taş fırın."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/tool/metalworking.json
msgid "filled charcoal kiln"
msgid_plural "filled charcoal kilns"
msgstr[0] "dolu odun kömürü fırını"
msgstr[1] "dolu odun kömürü fırınları"

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "metal charcoal kiln"
msgstr "metal kömür fırını"

#. ~ Description for metal charcoal kiln
#. ~ Description for filled metal charcoal kiln
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A metal kiln designed to burn wood and organic material into charcoal in "
"absence of oxygen."
msgstr ""
"Odun ve organik malzemeleri oksijen yokluğunda kömüre dönüştürmek için "
"tasarlanmış metal bir fırın."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "filled metal charcoal kiln"
msgstr "dolu metal kömür fırını"

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
msgid "arc furnace"
msgid_plural "arc furnaces"
msgstr[0] "ark ocağı"
msgstr[1] "ark ocakları"

#. ~ Description for arc furnace
#. ~ Description for filled arc furnace
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"An arc furnace designed to burn a powdery mix of coke and limestone to "
"create calcium carbide."
msgstr ""
"Kalsiyum karbür oluşturmak için kok ve kireçtaşı karışımını yakmak üzere "
"tasarlanmış bir ark ocağı."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "filled arc furnace"
msgstr "dolu ark ocağı"

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "smoking rack"
msgstr "tütsü rafı"

#. ~ Description for smoking rack
#. ~ Description for metal smoking rack
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A special rack designed to smoke food for better preservation and taste.  "
"Works as a charcoal smoker in crafting recipes."
msgstr ""
"Yiyecekleri daha iyi koruma ve tat için tütsülemek üzere tasarlanmış özel "
"bir raf. Tariflerde kömür tütsüleyici olarak çalışır."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "active smoking rack"
msgstr "aktif tütsü rafı"

#. ~ Description for active smoking rack
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A special rack designed to smoke food for better preservation and taste.  It"
" is lit and smoking."
msgstr ""
"Yiyecekleri daha iyi koruma ve tat için tütsülemek üzere tasarlanmış özel "
"bir raf. Yanıyor ve tütsülüyor."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/tool/deployable.json
msgid "metal smoking rack"
msgid_plural "metal smoking racks"
msgstr[0] "metal tütsüleme rafı"
msgstr[1] "metal tütsüleme rafları"

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "active metal smoking rack"
msgstr "aktif metal tütsü rafı"

#. ~ Description for active metal smoking rack
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A special rack designed to smoke food for better preservation and taste."
msgstr ""
"Yiyecekleri daha iyi koruma ve tat için tütsülemek üzere tasarlanmış özel "
"bir raf."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "rock forge"
msgstr "taş dövme ocağı"

#. ~ Description for rock forge
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"Metalworking station made of rock, typically used in combination with an "
"anvil.  Works as a charcoal forge in crafting recipes."
msgstr ""
"Genellikle bir örs ile birlikte kullanılan, taştan yapılmış bir metal işleme"
" istasyonu. Tariflerde odun kömürü ocağı olarak çalışır."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "clay kiln"
msgstr "kil fırını"

#. ~ Description for clay kiln
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "A kiln designed to bake clay pottery and bricks."
msgstr "Kil çömlek ve tuğlaları pişirmek için tasarlanmış bir fırın."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "charcoal purifier"
msgstr "odun kömürü arıtıcı"

#. ~ Description for charcoal purifier
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A makeshift filter constructed to hold a supply of charcoal, for purifying "
"water."
msgstr ""
"Suyu arıtmak için odun kömürü stoğunu tutacak şekilde inşa edilmiş geçici "
"bir filtre."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/tool/misc.json
msgid "stepladder"
msgid_plural "stepladders"
msgstr[0] "merdiven"
msgstr[1] "merdivenler"

#. ~ Description for stepladder
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A short, foldable ladder.  Can help you climb to a rooftop, or maybe slow "
"something down."
msgstr ""
"Kısa, katlanabilir bir merdiven. Çatıya tırmanmanıza yardımcı olabilir veya "
"belki bir şeyi yavaşlatabilir."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "electric arc furnace"
msgstr "elektrik ark ocağı"

#. ~ Description for electric arc furnace
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"Not the kind of furnace you'd heat your house with, this is a device for "
"heating things to extreme temperatures as part of industrial fabrication "
"processes."
msgstr ""
"Evinizi ısıtmak için kullanacağınız türden bir fırın değil, bu cihaz "
"endüstriyel üretim süreçlerinin bir parçası olarak şeyleri aşırı "
"sıcaklıklara ısıtmak için kullanılır."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "drill press"
msgstr "matkap presi"

#. ~ Description for drill press
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A powerful drill mounted on a slide that lets it drop precisely down.  "
"Useful in all kinds of projects from industrial fabrication to home "
"woodworking."
msgstr ""
"Tam olarak aşağıya inmesini sağlayan bir kızak üzerine monte edilmiş güçlü "
"bir matkap. Endüstriyel üretimden evde ahşap işçiliğine kadar her türlü "
"projede kullanışlıdır."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "tablesaw"
msgstr "daire testere"

#. ~ Description for tablesaw
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A rotating saw blade set into a large flat table, for making straight "
"measured cuts.  One of the key tools in a carpenter's arsenal."
msgstr ""
"Düz ve ölçülü kesimler yapmak için büyük düz bir masaya yerleştirilmiş döner"
" testere bıçağı. Bir marangozun cephaneliğindeki anahtar araçlardan biridir."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "mitre saw"
msgstr "gönye testere"

#. ~ Description for mitre saw
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A circular saw blade on an arm that can slide and rotate in several "
"directions, this is a staple tool for nearly any carpentry."
msgstr ""
"Bir kol üzerinde kayabilen ve çeşitli yönlerde dönebilen dairesel testere "
"bıçağı, bu neredeyse her marangozluk için temel bir araçtır."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "bandsaw"
msgstr "şerit testere"

#. ~ Description for bandsaw
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A ribbonlike sawblade runs in a single direction in this tool, allowing "
"precise cuts at almost any angle."
msgstr ""
"Bu alette tek yönde çalışan şerit benzeri bir testere bıçağı, neredeyse her "
"açıdan hassas kesimler yapmayı sağlar."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "router table"
msgstr "freze masası"

#. ~ Description for router table
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"This table has an inset router, a rotating motor with an exchangeable blade "
"head for cutting specific profiles and grooves and stuff."
msgstr ""
"Bu masada, belirli profiller ve oluklar kesmek için değiştirilebilir bıçak "
"başlığına sahip döner bir motor olan gömme bir freze bulunur."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "planer"
msgstr "planya"

#. ~ Description for planer
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A hefty tool that will take in a board and cut it smooth and flat to a "
"specific width.  Particularly great if working with raw lumber stock, but "
"also good just for shaving wood down to size."
msgstr ""
"Bir tahtayı alıp belirli bir genişlikte pürüzsüz ve düz bir şekilde kesen "
"ağır bir alet. Özellikle ham kereste ile çalışırken harikadır, ancak ahşabı "
"istenilen boyuta indirmek için de iyidir."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "jointer"
msgstr "planya makinesi"

#. ~ Description for jointer
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A table-shaped tool with a rotating blade that will cut down, smooth out, "
"and square off a board to make it very smooth and nice indeed."
msgstr ""
"Döner bıçağa sahip masa şeklinde bir alet, tahtayı kesip düzleştirir ve "
"köşelerini kare yapar, böylece çok pürüzsüz ve güzel hale getirir."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "power lathe"
msgstr "güçlü torna tezgahı"

#. ~ Description for power lathe
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"An industrial-grade lathe, for turning chunks of metal and other hard things"
" into round chunks of metal and other hard things.  Power it back up and it "
"could be used to practice Fabrication."
msgstr ""
"Metal parçaları ve diğer sert malzemeleri yuvarlak parçalara dönüştürmek "
"için endüstriyel sınıf bir torna tezgahı. Tekrar çalıştırıldığında İmalat "
"pratiği yapmak için kullanılabilir."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "industrial laser cutter"
msgstr "endüstriyel lazer kesici"

#. ~ Description for industrial laser cutter
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A large box of tinted glass, with a robotic arm inside.  Before the "
"cataclysm, it used to cut and etch sheet metal with a high-powered laser.  "
"Now, it's better suited for scrap parts."
msgstr ""
"İçinde robotik bir kol bulunan, renkli camdan yapılmış büyük bir kutu. "
"Felaket öncesinde, yüksek güçlü bir lazerle sac metali kesmek ve oymak için "
"kullanılırdı. Şimdi, hurda parçalar için daha uygun."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "air compressor"
msgstr "hava kompresörü"

#. ~ Description for air compressor
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"This durable tank is topped with a motor that will cram as much air into the"
" tank as possible."
msgstr ""
"Bu dayanıklı tank, içine mümkün olduğunca fazla hava sıkıştıracak bir "
"motorla donatılmıştır."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "fermenting vat"
msgstr "fermantasyon tankı"

#. ~ Description for fermenting vat
#. ~ Description for filled fermenting vat
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "A sealable vat for fermenting vinegar and various alcoholic brews."
msgstr ""
"Sirke ve çeşitli alkollü içeceklerin fermantasyonu için kapatılabilir bir "
"tank."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "filled fermenting vat"
msgstr "dolu fermantasyon tankı"

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "butchering rack"
msgstr "kesim rafı"

#. ~ Description for butchering rack
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "Butchering rack designed to hang a carcass in the air."
msgstr "Bir karkası havada asmak için tasarlanmış kesim rafı."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/tool/deployable.json
msgid "metal butchering rack"
msgid_plural "metal butchering racks"
msgstr[0] "metal kasaplık rafı"
msgstr[1] "metal kasaplık rafları"

#. ~ Description for metal butchering rack
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"Metal butchering rack designed to hang a carcass in the air.  It can be "
"deconstructed and folded for easy transportation."
msgstr ""
"Bir karkası havada asmak için tasarlanmış metal kesim rafı. Kolay "
"taşınabilirlik için sökülebilir ve katlanabilir."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "hanging meathook"
msgstr "asılı et kancası"

#. ~ Description for hanging meathook
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "A hefty hook suspended from a chain for stringing up corpses."
msgstr "Cesetleri asmak için zincirden sarkıtılmış sağlam bir kanca."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/tool/deployable.json
msgid "wind mill"
msgid_plural "wind mills"
msgstr[0] "yeldeğirmeni"
msgstr[1] "yeldeğirmenleri"

#. ~ Description for wind mill
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "A small wind-powered mill that can be used to grind down materials."
msgstr ""
"Malzemeleri öğütmek için kullanılabilecek küçük bir rüzgarla çalışan "
"değirmen."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "active wind mill"
msgstr "aktif yel değirmeni"

#. ~ Description for active wind mill
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A small wind-powered mill that can be used to grind down materials.  Its "
"brake has been removed and it is turning."
msgstr ""
"Malzemeleri öğütmek için kullanılabilecek küçük bir rüzgar enerjili "
"değirmen. Freni çıkarılmış ve dönüyor."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/tool/deployable.json
msgid "water mill"
msgid_plural "water mills"
msgstr[0] "su değirmeni"
msgstr[1] "su değirmenleri"

#. ~ Description for water mill
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "A small water-powered mill that can be used to grind down materials."
msgstr ""
"Malzemeleri öğütmek için kullanılabilecek küçük bir su enerjili değirmen."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "active water mill"
msgstr "aktif su değirmeni"

#. ~ Description for active water mill
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A small water-powered mill that can be used to grind down materials.  Its "
"brake has been removed and it is turning."
msgstr ""
"Malzemeleri öğütmek için kullanılabilecek küçük bir su enerjili değirmen. "
"Freni çıkarılmış ve dönüyor."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "automated gas console"
msgstr "otomatik gaz konsolu"

#. ~ Description for automated gas console
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "Automated gas flow control console."
msgstr "Otomatik gaz akışı kontrol konsolu."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "broken automated gas console"
msgstr "bozuk otomatik gaz konsolu"

#. ~ Description for broken automated gas console
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"Automated gas flow control console.  Broken.  This is not a good thing."
msgstr "Otomatik gaz akışı kontrol konsolu. Bozuk. Bu iyi bir şey değil."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "reinforced vending machine"
msgstr "güçlendirilmiş otomat"

#. ~ Description for reinforced vending machine
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A bit tougher to crack open than regular vending machines.  That just makes "
"it all the sweeter a target, doesn't it?"
msgstr ""
"Normal otomatlara göre açması biraz daha zor. Bu da onu daha cazip bir hedef"
" yapmıyor mu?"

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "vending machine"
msgstr "otomat"

#. ~ Description for vending machine
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "Buy stuff with a cash card."
msgstr "Nakit kartıyla bir şeyler satın al."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "broken vending machine"
msgstr "bozuk otomat"

#. ~ Description for broken vending machine
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"Ponder if you could buy stuff, as it's broken.  Maybe if you broke it more, "
"you wouldn't need to pay at all!"
msgstr ""
"Bozuk olduğu için bir şeyler alıp alamayacağını düşün. Belki daha fazla "
"kırarsan, hiç ödeme yapman gerekmez!"

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
msgid "rope leading up"
msgstr "yukarıya uzanan ip"

#. ~ Description for rope leading up
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "A rope.  You could climb it up."
msgstr "Bir ip. Yukarıya tırmanabilirsin."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "web rope leading up"
msgstr "yukarıya uzanan ağ ipi"

#. ~ Description for web rope leading up
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "A web rope.  You could climb it up."
msgstr "Bir ağ ipi. Yukarıya tırmanabilirsin."

#: data/json/furniture_and_terrain/furniture-triffid.json
msgid "luminous plant bulb"
msgstr "ışıklı bitki soğanı"

#. ~ Description for luminous plant bulb
#: data/json/furniture_and_terrain/furniture-triffid.json
msgid ""
"A small plant grows among the roots here, its green onion-like bulb "
"illuminating the area around it."
msgstr ""
"Burada köklerin arasında küçük bir bitki büyüyor, yeşil soğan benzeri soğanı"
" etrafını aydınlatıyor."

#: data/json/furniture_and_terrain/furniture-triffid.json
msgid "brambles"
msgstr "dikenli çalılar"

#. ~ Description for brambles
#: data/json/furniture_and_terrain/furniture-triffid.json
msgid ""
"A wall of tangled roots blocks the path here, you'd have destroy it to get "
"past."
msgstr ""
"Burada yolu kapatan karışık köklerden oluşan bir duvar var, geçmek için onu "
"yok etmelisin."

#: data/json/furniture_and_terrain/furniture-triffid.json
#: data/json/furniture_and_terrain/terrain-fungal.json
msgid "smash"
msgstr "parçala"

#: data/json/furniture_and_terrain/furniture-triffid.json
msgid "composting midden"
msgstr "kompost yığını"

#. ~ Description for composting midden
#: data/json/furniture_and_terrain/furniture-triffid.json
msgid ""
"A hole that has been dug into the roots here, a pretty unpleasant smell "
"emits from it."
msgstr ""
"Burada köklere kazılmış bir delik var, oldukça rahatsız edici bir koku "
"yayıyor."

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid "walkway"
msgstr "yaya yolu"

#. ~ Description for walkway
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid ""
"A metallic bridge commonly used in industrial settings to meet specified "
"safety standards."
msgstr ""
"Belirli güvenlik standartlarını karşılamak için endüstriyel ortamlarda "
"yaygın olarak kullanılan metalik bir köprü."

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
#: data/json/overmap/overmap_terrain/overmap_terrain_recreational.json
msgid "dock"
msgstr "iskele"

#. ~ Description for dock
#. ~ Description for shallow bridge
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid "A wooden platform held by a support made of logs dug into the ground."
msgstr ""
"Yere kazılmış kütüklerden yapılmış bir destekle tutulan ahşap bir platform."

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid "deep dock pile"
msgstr "derin iskele kazığı"

#. ~ Description for deep dock pile
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid ""
"A sturdy pile made of wood extending all the way to the riverbed.  A frame "
"will be required to support a surface."
msgstr ""
"Nehir yatağına kadar uzanan ahşaptan yapılmış sağlam bir kazık. Yüzeyi "
"desteklemek için bir çerçeve gerekecek."

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid "deep dock frame"
msgstr "derin iskele çerçevesi"

#. ~ Description for deep dock frame
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid ""
"A log frame secured atop a wooden pile.  Adding a wood surface will make "
"this into a proper dock section."
msgstr ""
"Ahşap bir kazığın üzerine sabitlenmiş bir kütük çerçevesi. Üzerine ahşap bir"
" yüzey eklemek, bunu düzgün bir iskele bölümüne dönüştürecektir."

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid "deep dock"
msgstr "derin iskele"

#. ~ Description for deep dock
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid ""
"A wooden platform held by a tall wooden pile that extend to the riverbed.  "
"Very sturdy, and likely to outlast you."
msgstr ""
"Nehir yatağına kadar uzanan uzun bir ahşap kazıkla tutulan ahşap bir "
"platform. Çok sağlam ve muhtemelen senden daha uzun ömürlü."

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid "shallow bridge"
msgstr "sığ köprü"

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid "pontoon bridge"
msgstr "pontoon köprüsü"

#. ~ Description for pontoon bridge
#. ~ Description for river bridge
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid ""
"A floating temporary bridge, like the ones army used to make to cross "
"rivers."
msgstr ""
"Nehirleri geçmek için orduların yaptığı türden yüzen geçici bir köprü."

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid "river bridge"
msgstr "nehir köprüsü"

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
#: data/json/furniture_and_terrain/terrain-highways.json
msgid "bridge pavement"
msgstr "köprü kaplaması"

#. ~ Description for bridge pavement
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
#: data/json/furniture_and_terrain/terrain-highways.json
msgid "A bridge section made out of metal and concrete."
msgstr "Metal ve betondan yapılmış bir köprü bölümü."

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
#: data/json/furniture_and_terrain/terrain-highways.json
msgid "concrete cracking and metal screeching!"
msgstr "Beton çatlıyor ve metal gıcırdıyor!"

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
#: data/json/furniture_and_terrain/terrain-highways.json
msgid "bridge yellow pavement"
msgstr "köprü sarı kaldırım"

#. ~ Description for bridge yellow pavement
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
#: data/json/furniture_and_terrain/terrain-highways.json
msgid "A bridge section made out of metal and concrete.  It's painted yellow."
msgstr "Metal ve betondan yapılmış bir köprü bölümü. Sarıya boyanmış."

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
#: data/json/furniture_and_terrain/terrain-highways.json
msgid "bridge sidewalk"
msgstr "köprü yaya yolu"

#. ~ Description for bridge sidewalk
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
#: data/json/furniture_and_terrain/terrain-highways.json
msgid "The sidewalk section of a concrete bridge."
msgstr "Beton bir köprünün yaya yolu bölümü."

#. ~ Description for dock
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid ""
"A metal platform held by a support made of concrete set into the ground."
msgstr "Betona gömülü bir destek tarafından tutulan metal bir platform."

#. ~ Description for deep dock pile
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid ""
"A sturdy pile made of poured concrete extending all the way to the riverbed."
"  A metal frame will be required to support a surface."
msgstr ""
"Nehir yatağına kadar uzanan dökme betondan yapılmış sağlam bir kazık. Yüzeyi"
" desteklemek için bir metal çerçeve gerekecek."

#. ~ Description for deep dock frame
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid ""
"A metal frame secured atop a concrete pile.  Adding a metal surface will "
"make this into a proper dock section."
msgstr ""
"Beton bir kazığın üzerine sabitlenmiş metal bir çerçeve. Metal bir yüzey "
"eklemek, bunu düzgün bir iskele bölümüne dönüştürecek."

#. ~ Description for deep dock
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid ""
"A metal platform held by a tall metal pile that extends to the riverbed.  "
"Very sturdy, and likely to outlast you."
msgstr ""
"Nehir yatağına kadar uzanan uzun bir metal kazık tarafından tutulan metal "
"bir platform. Çok sağlam ve muhtemelen sizden daha uzun ömürlü."

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid "metal floating dock"
msgstr "metal yüzer iskele"

#. ~ Description for metal floating dock
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid "A floating temporary dock, anchored to keep it from drifting away."
msgstr "Sürüklenmesini önlemek için demirlenmiş, geçici bir yüzer iskele."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed laminated glass door"
msgstr "kapalı lamine cam kapı"

#. ~ Description for closed laminated glass door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A closed laminated glass door is composed layers of glass and plastic held "
"together by an interlayer."
msgstr ""
"Kapalı lamine cam kapı, bir ara katmanla bir arada tutulan cam ve plastik "
"katmanlarından oluşur."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open laminated glass door"
msgstr "açık lamine cam kapı"

#. ~ Description for open laminated glass door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"Laminated glass door is composed layers of glass and plastic held together "
"by an interlayer.  Yep, it's open."
msgstr ""
"Lamine cam kapı, bir ara katmanla bir arada tutulan cam ve plastik "
"katmanlarından oluşur. Evet, açık."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed ballistic glass door"
msgstr "kapalı balistik cam kapı"

#. ~ Description for closed ballistic glass door
#. ~ Description for ballistic glass
#: data/json/furniture_and_terrain/terrain-doors.json
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "Ballistic glass consists of layers of laminated glass."
msgstr "Balistik cam, lamine cam katmanlarından oluşur."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open ballistic glass door"
msgstr "açık balistik cam kapı"

#. ~ Description for open ballistic glass door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"Ballistic glass consists of layers of laminated glass.  Yep, it's open."
msgstr "Balistik cam, lamine cam katmanlarından oluşur. Evet, açık."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed reinforced glass door"
msgstr "kapalı güçlendirilmiş cam kapı"

#. ~ Description for closed reinforced glass door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A closed glass door reinforced with woven steel wires in a stylish, but "
"practical pattern."
msgstr ""
"Örgülü çelik tellerle güçlendirilmiş, şık ama pratik bir desene sahip kapalı"
" bir cam kapı."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open reinforced glass door"
msgstr "açık güçlendirilmiş cam kapı"

#. ~ Description for open reinforced glass door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A glass door reinforced with woven steel wires in a stylish, but practical "
"pattern.  Yep, it's open."
msgstr ""
"Örgülü çelik tellerle güçlendirilmiş, şık ama pratik bir desene sahip bir "
"cam kapı. Evet, açık."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed wood door"
msgstr "kapalı ahşap kapı"

#. ~ Description for closed wood door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A standard wooden door that doesn't look very resilient.  It'd probably burn"
" easily, too."
msgstr ""
"Çok dayanıklı görünmeyen standart bir ahşap kapı. Muhtemelen kolayca yanar."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open wood door"
msgstr "açık ahşap kapı"

#. ~ Description for open wood door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A standard wooden door that doesn't look very resilient.  It'd probably burn"
" easily, too.  This one is wide open."
msgstr ""
"Çok dayanıklı görünmeyen standart bir ahşap kapı. Muhtemelen kolayca yanar. "
"Bu kapı sonuna kadar açık."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "damaged wood door"
msgstr "hasarlı ahşap kapı"

#. ~ Description for damaged wood door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A trashed wooden door, that is more of an obstacle than a door.  Also, you "
"can see right through it.  It could be boarded up with a few two by fours."
msgstr ""
"Daha çok bir engel olan, harap olmuş bir ahşap kapı. Ayrıca, içini "
"görebiliyorsunuz. Birkaç ikiye dört tahta ile kapatılabilir."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "empty door frame"
msgstr "boş kapı çerçevesi"

#. ~ Description for empty door frame
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An empty door frame made from two by fours and nails.  A variety of doors "
"could be constructed here."
msgstr ""
"İki dört ve çivilerden yapılmış boş bir kapı çerçevesi. Burada çeşitli "
"kapılar inşa edilebilir."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed glass door"
msgstr "kapalı cam kapı"

#. ~ Description for closed glass door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A sliding glass door, the kind that was on social media with people and "
"animals running into.  This one is closed, so don't hurt yourself."
msgstr ""
"Sosyal medyada insanların ve hayvanların çarptığı türden bir sürgülü cam "
"kapı. Bu kapı kapalı, o yüzden kendinize zarar vermeyin."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open glass door"
msgstr "açık cam kapı"

#. ~ Description for open glass door
#. ~ Description for open frosted glass door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A sliding glass door that has been left open for all manner of things to "
"travel through."
msgstr "Her türlü şeyin geçmesi için açık bırakılmış bir sürgülü cam kapı."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed wood door with peephole"
msgstr "dürüklü kapalı ahşap kapı"

#. ~ Description for closed wood door with peephole
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A regular door made of ordinary wood, except this one has a peephole.  If "
"you examined it more closely, you'd be able to peek through the hole."
msgstr ""
"Sıradan ahşaptan yapılmış bir kapı, ancak bu kapının bir dürbünü var. Daha "
"yakından incelerseniz, delikten bakabilirsiniz."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "damaged wood door with peephole"
msgstr "hasarlı dürüklü ahşap kapı"

#. ~ Description for damaged wood door with peephole
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"Bad news is the peephole is broken and you can't look outside the door.  "
"Good news is the door is nearly broken down, so there's nothing blocking the"
" view.  A few planks, nails and the right tools could patch up all the "
"damage."
msgstr ""
"Kötü haber, dürbün kırık ve kapının dışını göremiyorsunuz. İyi haber, kapı "
"neredeyse kırılmış durumda, bu yüzden manzarayı engelleyen bir şey yok. "
"Birkaç tahta, çivi ve doğru araçlarla tüm hasar onarılabilir."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open wood door with peephole"
msgstr "darbeliği olan açık ahşap kapı"

#. ~ Description for open wood door with peephole
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A regular door made of ordinary wood, except this one has a peephole.  If "
"you examined it more closely, you'd be able to peek through the hole.  "
"Although, you don't need to peek through it since the door is open anyway."
msgstr ""
"Sıradan ahşaptan yapılmış bir kapı, ancak bu kapının bir darbeliği var. Eğer"
" daha yakından incelerseniz, delikten bakabilirsiniz. Ancak, zaten açık "
"olduğu için delikten bakmanıza gerek yok."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed reinforced wood door"
msgstr "kapalı güçlendirilmiş ahşap kapı"

#. ~ Description for closed reinforced wood door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"Just like other wooden doors, except this one has layers of nailed in two by"
" fours and additional hinge for reinforcement.  It might be barricaded, but "
"still susceptible to fire."
msgstr ""
"Diğer ahşap kapılar gibi, ancak bu kapı çivilenmiş ikiye dörtlük katmanlar "
"ve ek menteşe ile güçlendirilmiş. Barikatlanmış olabilir, ama yine de "
"yangına karşı hassas."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "damaged reinforced wood door"
msgstr "hasarlı güçlendirilmiş ahşap kapı"

#. ~ Description for damaged reinforced wood door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"There are splintering planks and visible holes in the wood, it looks like it"
" could be smashed apart if not repaired."
msgstr ""
"Ahşapta çatlayan tahtalar ve görünen delikler var, eğer tamir edilmezse "
"parçalanabilir gibi görünüyor."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open reinforced wood door"
msgstr "açık güçlendirilmiş ahşap kapı"

#. ~ Description for open reinforced wood door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"Just like other wooden doors, except this one has layers of nailed in two by"
" fours for reinforcement.  It might be fortified, but still susceptible to "
"fire.  It's open so it's not stopping anything right now."
msgstr ""
"Diğer ahşap kapılar gibi, ancak bu kapı çivilenmiş ikiye dörtlük katmanlar "
"ile güçlendirilmiş. Güçlendirilmiş olabilir, ama yine de yangına karşı "
"hassas. Şu anda açık olduğu için hiçbir şeyi durdurmuyor."

#. ~ Description for closed wood door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A standard wooden door that doesn't look very resilient.  It'd probably burn"
" easily, too.  This one has an extra keyhole, so it's likely locked.  You "
"could pry it open or pick the lock."
msgstr ""
"Çok dayanıklı görünmeyen standart bir ahşap kapı. Muhtemelen kolayca yanar. "
"Bu kapının ekstra bir anahtar deliği var, bu yüzden muhtemelen kilitli. "
"Açmak için zorlayabilir veya kilidi açabilirsiniz."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "You pry open the door."
msgstr "Kapıyı zorlayarak açıyorsunuz."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "You pry, but cannot pry open the door."
msgstr "Zorladınız, ama kapıyı açmayı başaramadınız."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "You damage the door!"
msgstr "Kapıya zarar verdiniz!"

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "With a satisfying click, the lock on the door opens."
msgstr "Tatmin edici bir tıklama ile kapının kilidi açıldı."

#. ~ Description for closed wood door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A standard wooden door that doesn't look very resilient.  It'd probably burn"
" easily, too.  This one has a deadbolt keyhole, so it's likely locked.  You "
"could pry it open or pick the lock, or unlock the deadbolt from the inside."
msgstr ""
"Dayanıklı görünmeyen standart bir ahşap kapı. Muhtemelen kolayca yanar. Bu "
"kapının bir sürgü kilidi var, bu yüzden muhtemelen kilitli. Kapıyı "
"zorlayarak açabilir, kilidi açabilir veya sürgüyü içeriden açabilirsiniz."

#. ~ Description for closed wood door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A regular door made of ordinary wood, except this one has a peephole.  If "
"you examined it more closely, you'd be able to peek through the hole.  This "
"one has a deadbolt keyhole, so it's likely locked.  You could pry it open or"
" pick the lock, or unlock the deadbolt from the inside."
msgstr ""
"Sıradan ahşaptan yapılmış bir kapı, ancak bu kapının bir gözetleme deliği "
"var. Daha yakından incelerseniz, delikten bakabilirsiniz. Bu kapının bir "
"sürgü kilidi var, bu yüzden muhtemelen kilitli. Kapıyı zorlayarak açabilir, "
"kilidi açabilir veya sürgüyü içeriden açabilirsiniz."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed door curtain"
msgstr "kapalı kapı perdesi"

#. ~ Description for closed door curtain
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"Repurposed curtains from a window acting as a door.  Could be easily taken "
"down for supplies or placed somewhere else."
msgstr ""
"Pencere için kullanılan perdeler kapı olarak yeniden kullanılmış. Kolayca "
"malzeme için sökülebilir veya başka bir yere yerleştirilebilir."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed makeshift door"
msgstr "kapalı geçici kapı"

#. ~ Description for closed makeshift door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A makeshift screen consisting of two by fours bound together with vertical "
"rope hanging from the top of the doorway.  Could be easily taken down and "
"re-purposed."
msgstr ""
"Kapı girişinin üst kısmından sarkan dikey iplerle bir araya getirilmiş iki "
"dört çubuktan oluşan geçici bir perde. Kolayca sökülüp yeniden "
"kullanılabilir."

#: data/json/furniture_and_terrain/terrain-doors.json
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "wham."
msgstr "güm."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open door curtain"
msgstr "açık kapı perdesi"

#. ~ Description for open door curtain
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"Repurposed curtains from a window acting as a door.  Could be easily taken "
"down for supplies or placed somewhere else.  These curtains are open, "
"bundled and tied next to the doorway."
msgstr ""
"Pencere için kullanılan perdeler kapı olarak yeniden değerlendirilmiş. "
"Kolayca sökülüp malzeme olarak kullanılabilir veya başka bir yere "
"yerleştirilebilir. Bu perdeler açık, kapının yanına toplanmış ve bağlanmış "
"durumda."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open makeshift door"
msgstr "açık geçici kapı"

#. ~ Description for open makeshift door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A makeshift screen consisting of two by fours bound together with rope "
"hanging from the top of the doorway.  Could be easily taken down and re-"
"purposed.  The planks have been rolled up and attached to the top of the "
"doorway, allowing free movement through."
msgstr ""
"İkiye dörde bölünmüş ve iplerle bağlanmış tahtalardan oluşan geçici bir "
"perde, kapının üst kısmından asılı duruyor. Kolayca sökülüp başka amaçlarla "
"kullanılabilir. Tahtalar yukarıya doğru sarılmış ve kapının üst kısmına "
"tutturulmuş, böylece serbest geçiş sağlanmış."

#. ~ Description for empty door frame
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An empty door frame made from wood.  A variety of doors could be constructed"
" here."
msgstr ""
"Ahşaptan yapılmış boş bir kapı çerçevesi. Burada çeşitli kapılar inşa "
"edilebilir."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "empty metal door frame"
msgstr "boş metal kapı çerçevesi"

#. ~ Description for empty metal door frame
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An empty door frame made of steel and assorted metal.  A variety of doors "
"could be constructed here."
msgstr ""
"Çelik ve çeşitli metallerden yapılmış boş bir kapı çerçevesi. Burada çeşitli"
" kapılar inşa edilebilir."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "empty metal window frame"
msgstr "boş metal pencere çerçevesi"

#. ~ Description for empty metal window frame
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An empty window frame constructed from assembled metal and carefully braced "
"with various hardware."
msgstr ""
"Bir araya getirilmiş metalden yapılmış ve çeşitli donanımlarla dikkatlice "
"desteklenmiş boş bir pencere çerçevesi."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "boarded up door"
msgstr "tahtalarla kapatılmış kapı"

#. ~ Description for boarded up door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A standard wooden door that has several planks across it, nailed down to "
"board it up and increase its durability.  Still flammable though."
msgstr ""
"Birkaç tahtayla kaplanmış, çivilerle sabitlenmiş ve dayanıklılığı artırılmış"
" standart bir ahşap kapı. Yine de yanıcı."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "boarded up damaged door"
msgstr "kapalı hasarlı kapı"

#. ~ Description for boarded up damaged door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A boarded up wooden door, except some of the planks are fractured or coming "
"loose.  Without repairs, it could be broken down easily."
msgstr ""
"Bazı tahtaları çatlamış veya gevşemiş kapalı bir ahşap kapı. Onarılmadığı "
"takdirde kolayca kırılabilir."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "boarded up door with peephole"
msgstr "gözetleme deliği olan kapalı kapı"

#. ~ Description for boarded up door with peephole
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A boarded up door made of ordinary wood, except this one has a peephole.  "
"Although it's been covered up in planks, you could still examine the "
"peephole."
msgstr ""
"Sıradan ahşaptan yapılmış kapalı bir kapı, ancak bu kapının bir gözetleme "
"deliği var. Tahtalarla kaplanmış olmasına rağmen, gözetleme deliğini "
"inceleyebilirsiniz."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "boarded up reinforced door"
msgstr "kapalı güçlendirilmiş kapı"

#. ~ Description for boarded up reinforced door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An additionally reinforced door of layered two by fours that has been "
"boarded up with more wood to prevent it from opening.  Still susceptible to "
"fire."
msgstr ""
"Açılmasını önlemek için daha fazla ahşapla kaplanmış, katmanlı ikiye "
"dörtlüklerle ek olarak güçlendirilmiş bir kapı. Yine de yangına karşı "
"hassas."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "boarded up damaged reinforced door"
msgstr "kapalı hasarlı güçlendirilmiş kapı"

#. ~ Description for boarded up damaged reinforced door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A battered and torn reinforced door with planks bursting from the joints.  "
"The boarded up two by fours are fragmented and in pieces, this doesn't look "
"like an easy repair."
msgstr ""
"Ek yerlerinden patlayan tahtalarla dövülmüş ve yırtılmış güçlendirilmiş bir "
"kapı. Kapalı ikiye dörtlükler parçalanmış ve dağılmış durumda, bu kolay bir "
"onarım gibi görünmüyor."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "boarded up damaged door with peephole"
msgstr "gözetleme deliği olan kapalı hasarlı kapı"

#. ~ Description for boarded up damaged door with peephole
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A wrecked door made of ordinary wood, except this one has a peephole.  "
"Although it's been covered up in planks, the peephole was damaged and can't "
"be used to see through."
msgstr ""
"Sıradan ahşaptan yapılmış, ancak bu kapının bir gözetleme deliği var. Her ne"
" kadar tahtalarla kapatılmış olsa da, gözetleme deliği hasar görmüş ve "
"içinden bakılamıyor."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed metal door"
msgstr "kapalı metal kapı"

#. ~ Description for closed metal door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape."
msgstr ""
"Çeşitli çeliklerden yapılmış, şekil verilmiş ve dövülmüş son derece "
"dayanıklı bir kapı."

#: data/json/furniture_and_terrain/terrain-doors.json
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "metal wall"
msgstr "metal duvar"

#. ~ Description for metal wall
#: data/json/furniture_and_terrain/terrain-doors.json
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"An industrially fabricated thick sheet carefully positioned and joined "
"seamlessly with perimeter sealant, this wall is capable of resisting extreme"
" elements as well as hostile forces.  Blast load rated and extremely fire-"
"retardant, breaching will require specialized tools or industrial vehicles."
msgstr ""
"Endüstriyel olarak üretilmiş kalın bir levha, dikkatlice konumlandırılmış ve"
" çevresel sızdırmazlık malzemesiyle kusursuz bir şekilde birleştirilmiştir. "
"Bu duvar, aşırı koşullara ve düşmanca güçlere karşı direnç gösterebilir. "
"Patlama yükü dereceli ve son derece yangına dayanıklıdır, delmek için özel "
"aletler veya endüstriyel araçlar gerekecektir."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open secret door"
msgstr "açık gizli kapı"

#. ~ Description for open secret door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"This apparently normal segment of metal wall has opened to reveal a secret "
"passage."
msgstr ""
"Görünüşte normal bir metal duvar segmenti, gizli bir geçidi açığa çıkarmak "
"için açıldı."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open metal door"
msgstr "açık metal kapı"

#. ~ Description for open metal door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape.  It's open, so no tools are needed to break in."
msgstr ""
"Çeşitli çeliklerden yapılmış, şekil verilmiş ve dövülmüş son derece "
"dayanıklı bir kapı. Açık, bu yüzden içeri girmek için aletlere gerek yok."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed metal door with peephole"
msgstr "gözetleme delikli kapalı metal kapı"

#. ~ Description for closed metal door with peephole
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape.  If you examined it more closely, you'd be able to peek through the "
"hole."
msgstr ""
"Çeşitli çeliklerden yapılmış, şekillendirilmiş ve dövülmüş son derece "
"dayanıklı bir kapı. Daha yakından incelerseniz, delikten göz atabilirsiniz."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open metal door with peephole"
msgstr "gözetleme deliği olan açık metal kapı"

#. ~ Description for open metal door with peephole
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape.  If you examined it more closely, you'd be able to peek through the "
"hole.  Although, you don't need to peek through it since the door is open "
"anyway."
msgstr ""
"Çeşitli çeliklerden yapılmış, şekillendirilmiş ve dövülmüş son derece "
"dayanıklı bir kapı. Daha yakından incelerseniz, delikten göz atabilirsiniz. "
"Ancak, zaten kapı açık olduğu için içeri bakmanıza gerek yok."

#. ~ Description for closed metal door
#. ~ Description for underwater closed metal door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A galvanized steel door, forged to withstand punishment and impede anyone or"
" anything.  Typically used in conjunction with automated electronic locking "
"mechanisms that require an external source to unlock."
msgstr ""
"Cezalandırmaya dayanacak ve herhangi bir şeyi engelleyecek şekilde dövülmüş "
"galvanizli çelik kapı. Genellikle, kilidini açmak için harici bir kaynağa "
"ihtiyaç duyan otomatik elektronik kilit mekanizmaları ile birlikte "
"kullanılır."

#. ~ Description for open metal door
#. ~ Description for underwater open metal door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A hanging metal gate.  Typically used in conjunction with mechanical winch."
"  Probably shouldn't be underneath when it comes down."
msgstr ""
"Asılı metal kapı. Genellikle mekanik vinç ile birlikte kullanılır. Aşağı "
"inerken altında olmamak en iyisi."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "underwater closed metal door"
msgstr "su altı kapalı metal kapı"

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "underwater open metal door"
msgstr "su altı açık metal kapı"

#. ~ Description for closed metal door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape.  This one has an extra keyhole, so it's likely locked.  You could "
"probably pick the lock, or a very strong tool could pry it open."
msgstr ""
"Çeşitli çeliklerden yapılmış, şekillendirilmiş ve dövülmüş son derece "
"dayanıklı bir kapı. Bu kapının ekstra bir anahtar deliği var, bu yüzden "
"muhtemelen kilitli. Muhtemelen kilidi açabilir veya çok güçlü bir aletle "
"zorlayarak açabilirsiniz."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed junk metal door"
msgstr "kapalı hurda metal kapı"

#. ~ Description for closed junk metal door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A makeshift door made of rusty scrap metal bolted together, with metal wires"
" for hinges.  Very fashionable in post-apocalyptic shantytowns."
msgstr ""
"Paslı hurda metalleri bir araya getirilip cıvatalanarak yapılmış, menteşe "
"olarak metal teller kullanılan geçici bir kapı. Kıyamet sonrası gecekondu "
"mahallelerinde oldukça moda."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open junk metal door"
msgstr "hurda metal kapıyı aç"

#. ~ Description for open junk metal door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A makeshift door made of rusty scrap metal bolted together, with metal wires"
" for hinges.  Very fashionable in post-apocalyptic shantytowns.  Somehow "
"even draftier now that it's open."
msgstr ""
"Paslı hurda metallerden yapılmış, metal tellerle menteşelenmiş geçici bir "
"kapı. Kıyamet sonrası gecekondu mahallelerinde oldukça moda. Açıkken bile "
"daha fazla cereyan yapıyor."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed bar door"
msgstr "kapalı bar kapısı"

#. ~ Description for closed bar door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A detention door made up of crisscrossed stainless steel bars.  The locking "
"mechanism doesn't appear to be engaged."
msgstr ""
"Çapraz paslanmaz çelik çubuklardan oluşan bir tutuklama kapısı. Kilit "
"mekanizması devrede görünmüyor."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open bar door"
msgstr "açık bar kapısı"

#. ~ Description for open bar door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A detention door made up of crisscrossed stainless steel bars.  It's swung "
"wide open.  Freedom!"
msgstr ""
"Çapraz paslanmaz çelik çubuklardan oluşan bir tutuklama kapısı. Tamamen "
"açık. Özgürlük!"

#. ~ Description for closed bar door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A detention door made up of crisscrossed stainless steel bars.  The locking "
"mechanism appears to be engaged.  The mechanism could be picked open with "
"enough skill."
msgstr ""
"Çapraz paslanmaz çelik çubuklardan oluşan bir tutuklama kapısı. Kilit "
"mekanizması devrede görünüyor. Yeterli beceriyle mekanizma açılabilir."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "The door swings open…"
msgstr "Kapı açılıyor…"

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed frosted glass door"
msgstr "kapalı buzlu cam kapı"

#. ~ Description for closed frosted glass door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid "A sliding door of frosted white glass."
msgstr "Buzlu beyaz camdan yapılmış bir sürgülü kapı."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open frosted glass door"
msgstr "buzlu cam kapıyı aç"

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed bulkhead door"
msgstr "kapalı ambar kapısı"

#. ~ Description for closed bulkhead door
#. ~ Description for open bulkhead door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An extremely resilient door of cast metal, it is watertight and opened using"
" the fly wheel."
msgstr ""
"Dökme metalden yapılmış son derece dayanıklı bir kapı, su geçirmezdir ve "
"volan kullanılarak açılır."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open bulkhead door"
msgstr "ambar kapısını aç"

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "underwater closed bulkhead door"
msgstr "su altındaki kapalı ambar kapısı"

#. ~ Description for underwater closed bulkhead door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An extremely resilient door of cast metal, opened using the fly wheel.  It's"
" technically still watertight, but that's a moot point when both sides are "
"flooded."
msgstr ""
"Dökme metalden yapılmış son derece dayanıklı bir kapı, volan kullanılarak "
"açılır. Teknik olarak hala su geçirmez, ancak her iki taraf da su altında "
"olduğunda bu pek bir anlam ifade etmiyor."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "underwater open bulkhead door"
msgstr "su altındaki açık ambar kapısı"

#. ~ Description for underwater open bulkhead door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An extremely resilient door of cast metal, currently open and letting all "
"the fish in."
msgstr ""
"Dökme metalden yapılmış son derece dayanıklı bir kapı, şu anda açık ve tüm "
"balıkların içeri girmesine izin veriyor."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "welded metal door"
msgstr "kaynaklı metal kapı"

#. ~ Description for welded metal door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape.  It's been welded shut, that oughta hold 'em."
msgstr ""
"Çeşitli çeliklerden yapılmış, şekil verilmiş ve dövülmüş son derece "
"dayanıklı bir kapı. Kapı kaynakla kapatılmış, bu onları durdurmalı."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "welded metal door with peephole"
msgstr "darbeli metal kapı, gözetleme deliği ile"

#. ~ Description for welded metal door with peephole
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape.  It's been welded shut, that oughta hold 'em.  If you examined it "
"more closely, you'd be able to peek through the hole."
msgstr ""
"Çeşitli çeliklerden yapılmış, şekil verilmiş ve dövülmüş son derece "
"dayanıklı bir kapı. Kaynakla kapatılmış, onları tutar. Daha yakından "
"incelerseniz, delikten bakabilirsiniz."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "welded bulkhead door"
msgstr "kaynaklı bölme kapısı"

#. ~ Description for welded bulkhead door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An extremely resilient watertight door of cast metal.  Used to open using "
"the fly wheel, it's since been welded shut.  That oughta hold 'em."
msgstr ""
"Dökme metalden yapılmış son derece dayanıklı su geçirmez bir kapı. Eskiden "
"el çarkı ile açılırdı, şimdi ise kaynakla kapatılmış. Onları tutar."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "welded bar door"
msgstr "kaynaklı parmaklık kapısı"

#. ~ Description for welded bar door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A detention door made up of crisscrossed stainless steel bars.  It's been "
"welded shut, that oughta hold 'em."
msgstr ""
"Paslanmaz çelik çubuklardan oluşan bir tutuklama kapısı. Kaynakla "
"kapatılmış, onları tutar."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed screen door"
msgstr "kapalı sineklik kapı"

#. ~ Description for closed screen door
#. ~ Description for open screen door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid "A simple wooden doorway with screen mesh."
msgstr "Ekran ağına sahip basit bir ahşap kapı."

#: data/json/furniture_and_terrain/terrain-doors.json
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "rattle!"
msgstr "takırtı!"

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open screen door"
msgstr "açık sineklik kapı"

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "palisade gate"
msgstr "palisade kapısı"

#. ~ Description for palisade gate
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A large doorway consisting of long logs cabled together, that could be "
"expanded upon.  Can act as a door if some type of pulley system were rigged "
"on an adjacent palisade wall."
msgstr ""
"Birbirine kablolanmış uzun kütüklerden oluşan, genişletilebilen büyük bir "
"kapı. Yanındaki palisade duvarına bir tür makara sistemi kurulduğunda kapı "
"olarak işlev görebilir."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "open palisade gate"
msgstr "palisade kapısını aç"

#. ~ Description for open palisade gate
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A hanging palisade gate, hoisted by a nearby pulley system.  Probably "
"shouldn't be underneath when it comes down."
msgstr ""
"Yakındaki bir makara sistemi tarafından kaldırılmış asılı bir palisade "
"kapısı. Aşağıya indiğinde altında olmamak en iyisi."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "makeshift portcullis"
msgstr "geçici mazgal"

#. ~ Description for makeshift portcullis
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"An immense gateway scrapped together with various bits of steel and metal "
"scraps."
msgstr ""
"Çeşitli çelik ve metal parçalarından bir araya getirilmiş devasa bir geçit."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "locked wire gate"
msgstr "kilitli tel kapı"

#. ~ Description for locked wire gate
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A gate for a chain link fence.  This one has a locked padlock on the latch "
"system.  With the right tools, you could cut the metal fence, pick the lock,"
" or pry the whole thing open.  You could also examine the fence to see if it"
" looks climbable."
msgstr ""
"Zincirli çit için bir kapı. Bu kapının kilit sisteminde kilitli bir asma "
"kilit var. Doğru aletlerle, metal çiti kesebilir, kilidi açabilir veya tüm "
"kapıyı zorlayarak açabilirsiniz. Ayrıca çitin tırmanılabilir görünüp "
"görünmediğini inceleyebilirsiniz."

#. ~ sound of bolt cutting locked wire gate
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "Gachunk!"
msgstr "Gachunk!"

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "You pry open the gate."
msgstr "Kapıyı zorlayarak açıyorsunuz."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "You pry, but cannot pry open the gate."
msgstr "Zorladınız, ancak kapıyı açamadınız."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "With a satisfying click, the lock on the gate opens."
msgstr "Tatmin edici bir tıklama ile kapının kilidi açıldı."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "closed wire gate"
msgstr "kapalı tel kapı"

#. ~ Description for closed wire gate
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "A gate for a chain link fence with a latch system to stay closed."
msgstr ""
"Kapalı kalması için mandal sistemi olan bir zincir bağlantılı çit kapısı."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "open wire gate"
msgstr "açık tel kapı"

#. ~ Description for open wire gate
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A gate for a chain link fence with a latch system to stay closed.  The latch"
" is undone, so the gate has swung open."
msgstr ""
"Kapalı kalması için mandal sistemi olan bir zincir bağlantılı çit kapısı. "
"Mandal açılmış, bu yüzden kapı açılmış durumda."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "closed wooden gate"
msgstr "kapalı ahşap kapı"

#. ~ Description for closed wooden gate
#. ~ Description for closed wooden split rail gate
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "A commercial quality gate made of wood with a latch system."
msgstr "Mandal sistemi olan ticari kalitede ahşap bir kapı."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "open wooden gate"
msgstr "açık ahşap kapı"

#. ~ Description for open wooden gate
#. ~ Description for open wooden split rail gate
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A commercial quality gate made of wood with a latch system.  The gate is "
"wide open, allowing anything to travel through."
msgstr ""
"Mandal sistemi olan ticari kalitede ahşap bir kapı. Kapı tamamen açık, her "
"şeyin geçmesine izin veriyor."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "closed chickenwire gate"
msgstr "kapalı tavuk teli kapısı"

#. ~ Description for closed chickenwire gate
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A gate for a chickenwire fence with a simple latch system to stay closed."
msgstr "Basit bir mandal sistemi ile kapalı kalan bir tavuk teli çit kapısı."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "open chickenwire gate"
msgstr "açık tavuk teli kapısı"

#. ~ Description for open chickenwire gate
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A gate for a chickenwire fence with a simple latch system to stay closed.  "
"The latch is undone, so the gate has swung open."
msgstr ""
"Basit bir mandal sistemi ile kapalı kalan bir tavuk teli çit kapısı. Mandal "
"açılmış, bu yüzden kapı açılmış."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "picket fence"
msgstr "çit"

#. ~ Description for picket fence
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A barrier made of wood, it's nothing complicated.  Mildly suggests where not"
" to go."
msgstr ""
"Ahşaptan yapılmış bir engel, karmaşık bir şey değil. Hafifçe nereye "
"gidilmemesi gerektiğini gösterir."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "chain link fence"
msgstr "zincir bağlantılı çit"

#. ~ Description for chain link fence
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A tall fence made of woven wires.  It doesn't suggest to stop, it just "
"stops."
msgstr ""
"Örgü tellerden yapılmış yüksek bir çit. Durmayı önermez, sadece durdurur."

#. ~ sound of bolt cutting chain link fence
#. ~ sound of bolt cutting wire fence
#. ~ sound of bolt cutting barbed wire fence
#: data/json/furniture_and_terrain/terrain-fences-gates.json
#: src/activity_actor.cpp
msgid "Snick, snick, gachunk!"
msgstr "Şık, şık, gıchunk!"

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "metal post"
msgstr "metal direk"

#. ~ Description for metal post
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "Set of metal posts, that can hold more serious fences."
msgstr "Daha sağlam çitleri tutabilecek metal direk seti."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "chickenwire fence"
msgstr "tavuk teli çiti"

#. ~ Description for chickenwire fence
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A rather flimsy tall fence made of 2x4s and woven wire, suitable for "
"containing small livestock like chickens."
msgstr ""
"2x4'ler ve dokuma telden yapılmış, tavuk gibi küçük hayvanları tutmak için "
"uygun, oldukça dayanıksız bir yüksek çit."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "metal rattling!"
msgstr "metal tıngırtısı!"

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "chickenwire fence post"
msgstr "tavuk teli çit direği"

#. ~ Description for chickenwire fence post
#. ~ Description for fence post
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A couple of posts that support the fence.  They look alone without the "
"fence."
msgstr "Çiti destekleyen birkaç direk. Çit olmadan yalnız görünüyorlar."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "fence post"
msgstr "çit direği"

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "wire fence"
msgstr "tel çit"

#. ~ Description for wire fence
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A barrier made of wire, it's nothing complicated.  Mildly suggests where not"
" to go."
msgstr ""
"Telden yapılmış bir engel, karmaşık bir şey değil. Hafifçe nereye "
"gidilmemesi gerektiğini önerir."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "barbed wire fence"
msgstr "dikenli tel çit"

#. ~ Description for barbed wire fence
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A barrier made of sharp barbed wire.  More persuasive brother of wire fence."
msgstr ""
"Keskin dikenli tellerden yapılmış bir bariyer. Tel çitin daha ikna edici "
"kardeşi."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "rope fence"
msgstr "halat çit"

#. ~ Description for rope fence
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A barrier made of rope, it's nothing complicated.  Mildly suggests where not"
" to go."
msgstr ""
"Halattan yapılmış bir bariyer, karmaşık bir şey değil. Nereye gidilmemesi "
"gerektiğini hafifçe önerir."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "split rail fence"
msgstr "bölünmüş raylı çit"

#. ~ Description for split rail fence
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A rather stout fence made of split logs with notches, held together by "
"gravity and suitable for containing livestock like horses, cows and pigs."
msgstr ""
"Yarık kütüklerden yapılmış, yerçekimiyle bir arada tutulan ve atlar, inekler"
" ve domuzlar gibi hayvanları içeride tutmaya uygun oldukça sağlam bir çit."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "closed wooden split rail gate"
msgstr "kapalı ahşap bölünmüş raylı kapı"

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "open wooden split rail gate"
msgstr "açık ahşap bölünmüş raylı kapı"

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "metal fence"
msgstr "metal çit"

#. ~ Description for metal fence
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "A simple metal fence."
msgstr "Basit bir metal çit."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "closed metal gate"
msgstr "kapalı metal kapı"

#. ~ Description for closed metal gate
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "A closed metal gate."
msgstr "Kapalı metal kapı."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "open metal gate"
msgstr "açık metal kapı"

#. ~ Description for open metal gate
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "An open metal gate."
msgstr "Açık metal kapı."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "wooden privacy fence"
msgstr "ahşap gizlilik çiti"

#. ~ Description for wooden privacy fence
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A rather stout fence made of 2x4s and fence posts, it is tall and prevents "
"people from seeing into your yard."
msgstr ""
"2x4'ler ve çit direklerinden yapılmış oldukça sağlam bir çit, yüksektir ve "
"insanların bahçenize bakmasını engeller."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "railing"
msgstr "korkuluk"

#. ~ Description for railing
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "A section of wooden railing."
msgstr "Ahşap korkuluk bölümü."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
#: data/json/furniture_and_terrain/terrain-recreational.json src/mapdata.cpp
msgid "crack!"
msgstr "çat!"

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "underwater railing"
msgstr "su altı korkuluğu"

#. ~ Description for underwater railing
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A flooded section of wooden railing.  Much less effective at stopping you "
"from jumping overboard, now."
msgstr ""
"Sular altında kalmış bir ahşap korkuluk bölümü. Şimdi, gemiden atlamanızı "
"engellemede çok daha az etkili."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "glass railing"
msgstr "cam korkuluk"

#. ~ Description for glass railing
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "A section of railing made out of glass."
msgstr "Camdan yapılmış bir korkuluk bölümü."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "glass braking!"
msgstr "cam frenleme!"

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "metal railing"
msgstr "metal korkuluk"

#. ~ Description for metal railing
#. ~ Description for underwater metal railing
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "A section of metal railing."
msgstr "Metalden yapılmış bir korkuluk bölümü."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "underwater metal railing"
msgstr "su altı metal korkuluk"

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "concrete railing"
msgstr "beton korkuluk"

#. ~ Description for concrete railing
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "A section of cemented concrete railing."
msgstr "Çimentolu beton korkuluk bölümü."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "guard rail"
msgstr "koruyucu korkuluk"

#. ~ Description for guard rail
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A section of metal railing, put in place to prevent people from falling or "
"taking the easy way out."
msgstr ""
"İnsanların düşmesini veya kolay yolu seçmesini önlemek için yerleştirilmiş "
"bir metal korkuluk bölümü."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "concrete floor"
msgstr "beton zemin"

#. ~ Description for concrete floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"A bare and cold concrete floor with matching roof, could still insulate from"
" the outdoors but roof collapse is possible if supporting walls are broken "
"down."
msgstr ""
"Çıplak ve soğuk bir beton zemin, uyumlu bir çatı ile birlikte, dışarıdan "
"yalıtım sağlayabilir ancak destek duvarları yıkılırsa çatı çökebilir."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#: data/json/furniture_and_terrain/terrain-fungal.json
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "SMASH!"
msgstr "PARÇALA!"

#. ~ Description for concrete floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"A bare and cold concrete floor with a streak of yellow paint, could still "
"insulate from the outdoors but roof collapse is possible if supporting walls"
" are broken down."
msgstr ""
"Çıplak ve soğuk bir beton zemin, üzerinde sarı bir boya çizgisi var, "
"dışarıdan yalıtım sağlayabilir ancak destek duvarları yıkılırsa çatı "
"çökebilir."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "concrete floor, overhead light"
msgstr "beton zemin, tavan lambası"

#. ~ Description for concrete floor, overhead light
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"A bare and cold concrete floor with a still-functioning light attached to "
"the ceiling above."
msgstr ""
"Tavanına bağlı hâlâ çalışan bir ışık bulunan çıplak ve soğuk bir beton "
"zemin."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "wooden floor, overhead light"
msgstr "ahşap zemin, tavan lambası"

#. ~ Description for wooden floor, overhead light
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Interlocking wooden tiles that are more than likely treated against fire, "
"with a still-functioning light attached to the ceiling above."
msgstr ""
"Yangına karşı muhtemelen işlem görmüş birbirine kenetlenen ahşap karolar, "
"tavanına bağlı hâlâ çalışan bir ışık ile birlikte."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "metal floor, with overhead light"
msgstr "metal zemin, tavan lambası ile"

#. ~ Description for metal floor, with overhead light
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"High-quality and tough checkered flooring to reduce risk of slips and falls,"
" with a still-functioning light attached to the ceiling above."
msgstr ""
"Kayma ve düşme riskini azaltmak için yüksek kaliteli ve sağlam dama desenli "
"zemin, tavanına bağlı hâlâ çalışan bir ışık ile birlikte."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#: data/json/furniture_and_terrain/terrain-flora.json
#: data/json/furniture_and_terrain/terrain-liquids.json
#: data/json/furniture_and_terrain/terrain-traps.json
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/mods/MagicalNights/terrain.json
#: data/mods/desert_region/desert_terrain.json
msgid "thump"
msgstr "gümbürtü"

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "small rebar roof cage"
msgstr "küçük demir çubuklu çatı kafesi"

#. ~ Description for small rebar roof cage
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"A series of structural support crafted from rebar in order to allow the "
"pouring of concrete for a more stable floor and roof."
msgstr ""
"Daha sağlam bir zemin ve çatı için beton dökülmesine olanak sağlamak "
"amacıyla demir çubuktan yapılmış bir dizi yapısal destek."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "SCRRRASH!"
msgstr "ÇATIRT!"

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "reinforced concrete floor"
msgstr "güçlendirilmiş beton zemin"

#. ~ Description for reinforced concrete floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"Extremely resilient floor made from carefully placed rebar and poured "
"concrete, capable of providing protection from the elements.  As for the "
"matching roof, it still requires supporting walls, otherwise it may very "
"well cave in."
msgstr ""
"Özenle yerleştirilmiş demir çubuklar ve dökülmüş betondan yapılmış, doğa "
"koşullarına karşı koruma sağlayabilen son derece dayanıklı zemin. Uyumlu "
"çatı için ise hala destekleyici duvarlar gerekmektedir, aksi takdirde "
"çökmeye meyilli olabilir."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "rebar roof cage"
msgstr "demir çubuklu çatı kafesi"

#. ~ Description for rebar roof cage
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"A network of architecturally sound rebar in order to support a floor and "
"roof, looks like it's missing the poured concrete."
msgstr ""
"Zemin ve çatı desteği sağlamak için mimari açıdan sağlam bir demir çubuk "
"ağı, dökülmüş beton eksik görünüyor."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "half-built reinforced concrete floor"
msgstr "yarı inşa edilmiş güçlendirilmiş beton zemin"

#. ~ Description for half-built reinforced concrete floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Unfinished series of rebar and poured concrete; the floor hasn't been "
"smoothed and the roof isn't quite filled in yet."
msgstr ""
"Tamamlanmamış demir çubuk ve dökülmüş beton serisi; zemin henüz "
"düzeltilmemiş ve çatı tam olarak doldurulmamış."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "rock floor"
msgstr "kaya zemin"

#. ~ Description for rock floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"A relatively flat area of rock and stone.  Looks stable enough to be mined "
"with the proper mining gear."
msgstr ""
"Görece düz bir kaya ve taş alanı. Uygun madencilik ekipmanıyla madencilik "
"için yeterince sağlam görünüyor."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "metal floor"
msgstr "metal zemin"

#. ~ Description for metal floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"High-quality and tough checkered flooring to reduce risk of slips and falls,"
" with a matching roof."
msgstr ""
"Kayma ve düşme riskini azaltmak için yüksek kaliteli ve dayanıklı kareli "
"zemin, uyumlu bir çatı ile birlikte."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "underwater metal floor"
msgstr "su altı metal zemin"

#. ~ Description for underwater metal floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"High-quality and tough checkered flooring, with a matching roof.  Designed "
"to reduce risk of slips and falls, but definitely needs a \"wet floor\" sign"
" now."
msgstr ""
"Kayma ve düşme riskini azaltmak için yüksek kaliteli ve dayanıklı kareli "
"zemin, uyumlu bir çatı ile birlikte. Ancak şimdi kesinlikle bir \"ıslak "
"zemin\" tabelasına ihtiyaç var."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "wooden floor"
msgstr "ahşap zemin"

#. ~ Description for wooden floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Interlocking wooden tiles that are more than likely treated against fire, "
"with wooden posts and beams supporting a roof."
msgstr ""
"Yangına karşı muhtemelen işlem görmüş, birbirine geçen ahşap karolar, ahşap "
"direkler ve kirişlerle desteklenen bir çatı."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "primitive floor"
msgstr "ilkel zemin"

#. ~ Description for primitive floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "Timber floor and supports, holding up a sod roof."
msgstr "Kereste zemin ve destekler, çim bir çatıyı taşıyor."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "simple metal floor"
msgstr "basit metal zemin"

#. ~ Description for simple metal floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"A crudely welded together floor of metal with steel trusses and supporting "
"girders."
msgstr ""
"Çelik kafesler ve destek kirişleri ile kaba bir şekilde kaynaklanmış metal "
"bir zemin."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "waxed floor"
msgstr "cilalı zemin"

#. ~ Description for waxed floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Hardwood flooring that has been treated with chemicals to improve slip "
"resistance and sliding, commonly for recreational sports."
msgstr ""
"Kayma direncini ve kaymayı artırmak için kimyasallarla işlenmiş, genellikle "
"rekreasyonel sporlar için kullanılan parke zemin."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "dirt floor"
msgstr "toprak zemin"

#. ~ Description for dirt floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Floor consisting of finely mixed earth that has been tamped down, with a "
"wooden ceiling above it."
msgstr ""
"Üzerinde ahşap bir tavan bulunan, sıkıştırılmış ince karışımlı topraktan "
"oluşan zemin."

#. ~ Description for dirt floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Floor consisting of finely mixed earth that has been tamped down, with "
"thatched roof above it."
msgstr ""
"Üzerinde sazdan bir çatı bulunan, sıkıştırılmış ince karışımlı topraktan "
"oluşan zemin."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "metal grate"
msgstr "metal ızgara"

#. ~ Description for metal grate
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"A type of walkway that can be used as protective covering over drains or "
"even used as a filter."
msgstr ""
"Drenajların üzerine koruyucu kaplama olarak kullanılabilen veya filtre "
"olarak kullanılabilen bir tür yaya yolu."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "utility light"
msgstr "yardımcı ışık"

#. ~ Description for utility light
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"An industrial flood light set up to illuminate the surroundings.  It could "
"be salvaged to install elsewhere, but will require grid power once taken "
"down.  Examine it to switch it off."
msgstr ""
"Çevreyi aydınlatmak için kurulmuş bir endüstriyel projektör. Başka bir yere "
"kurmak için kurtarılabilir, ancak indirildikten sonra şebeke gücüne ihtiyaç "
"duyacaktır. Kapatmak için inceleyin."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "Switch off the utility light"
msgstr "Yardımcı ışığı kapat"

#. ~ Message for terrain 'utility light'
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "You flick the utility light off."
msgstr "Yardımcı ışığı kapatıyorsunuz."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "utility light (off)"
msgstr "yardımcı ışık (kapalı)"

#. ~ Description for utility light (off)
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"An industrial flood light, which could be turned on to illuminate your "
"surroundings.  It could also be salvaged if you're willing to provide it "
"more than emergency power.  Examine it to switch it back on."
msgstr ""
"Çevrenizi aydınlatmak için açılabilecek bir endüstriyel projektör. Acil "
"durum gücünden fazlasını sağlamaya istekliyseniz, kurtarılabilir de. Tekrar "
"açmak için inceleyin."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "Switch on the utility light"
msgstr "Yardımcı ışığı aç"

#. ~ Message for terrain 'utility light (off)'
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "You flick the utility light on."
msgstr "Yardımcı ışığı açıyorsunuz."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "wax floor"
msgstr "mum zemin"

#. ~ Description for wax floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "A floor section made entirely out of wax."
msgstr "Tamamen mumdan yapılmış bir zemin bölümü."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "elevator"
msgstr "asansör"

#. ~ Description for elevator
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "The interior section of an elevator."
msgstr "Bir asansörün iç kısmı."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "red floor"
msgstr "kırmızı zemin"

#. ~ Description for red floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "A red section of flooring."
msgstr "Kırmızı bir zemin bölümü."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "green floor"
msgstr "yeşil zemin"

#. ~ Description for green floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "A green section of flooring."
msgstr "Yeşil bir zemin bölümü."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "blue floor"
msgstr "mavi zemin"

#. ~ Description for blue floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "A blue section of flooring."
msgstr "Mavi bir zemin bölümü."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/items/resources/home_improvement.json
msgid "red carpet"
msgid_plural "red carpets"
msgstr[0] "kırmızı halı"
msgstr[1] "kırmızı halılar"

#. ~ Description for red carpet
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "Soft red carpet."
msgstr "Yumuşak kırmızı halı."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/items/resources/home_improvement.json
msgid "yellow carpet"
msgid_plural "yellow carpets"
msgstr[0] "sarı halı"
msgstr[1] "sarı halılar"

#. ~ Description for yellow carpet
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "Soft yellow carpet."
msgstr "Yumuşak sarı halı."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/items/resources/home_improvement.json
msgid "green carpet"
msgid_plural "green carpets"
msgstr[0] "yeşil halı"
msgstr[1] "yeşil halılar"

#. ~ Description for green carpet
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "Soft green carpet."
msgstr "Yumuşak yeşil halı."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/items/resources/home_improvement.json
msgid "purple carpet"
msgid_plural "purple carpets"
msgstr[0] "mor halı"
msgstr[1] "mor halılar"

#. ~ Description for purple carpet
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "Soft purple carpet."
msgstr "Yumuşak mor halı."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "industrial carpet"
msgstr "endüstriyel halı"

#. ~ Description for industrial carpet
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Firm, low-pile, high-durability carpet in a neutral gray color, for laying "
"down on bare concrete."
msgstr ""
"Beton zemine serilmek üzere nötr gri renkte, sağlam, düşük tüylü, yüksek "
"dayanıklılığa sahip halı."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "bunker carpet"
msgstr "sığınak halısı"

#. ~ Description for bunker carpet
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Firm, low-pile, totally non-flammable carpet in a neutral cream color, with "
"an insulation layer beneath."
msgstr ""
"Nötr krem renginde, tamamen yanmaz, sağlam, düşük tüylü halı, altında bir "
"yalıtım katmanı ile."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "linoleum tile"
msgstr "linolyum karo"

#. ~ Description for linoleum tile
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"A section of flooring made out of a tough, rubbery material.  Colored a "
"simple white."
msgstr ""
"Dayanıklı, lastiksi bir malzemeden yapılmış bir zemin bölümü. Basit beyaz "
"renkte."

#. ~ Description for linoleum tile
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "A section of flooring made out of a tough, gray, rubbery material."
msgstr "Dayanıklı, gri, lastiksi bir malzemeden yapılmış bir zemin bölümü."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "painted waxed floor"
msgstr "boyanmış cilalı zemin"

#. ~ Description for painted waxed floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "This section of wax flooring has been painted."
msgstr "Bu cilalı zemin bölümü boyanmıştır."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "radiation platform"
msgstr "radyasyon platformu"

#. ~ Description for radiation platform
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"A dual-purpose platform that exposes items placed on it to a radioactive "
"source by temporarily hoisting the radioactive material stored within, while"
" also safely containing all objects to avoid contaminating its surroundings."
"  Operated from an external console."
msgstr ""
"Üzerine yerleştirilen nesneleri, içinde depolanan radyoaktif malzemeyi "
"geçici olarak kaldırarak radyoaktif bir kaynağa maruz bırakan, aynı zamanda "
"çevresini kirletmemek için tüm nesneleri güvenli bir şekilde içeren çift "
"amaçlı bir platform. Harici bir konsoldan çalıştırılır."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "junk metal floor"
msgstr "hurda metal zemin"

#. ~ Description for junk metal floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"A simple roof and floor of rusty scrap metal bolted and wire-tied to a "
"makeshift frame.  Very fashionable in post-apocalyptic shantytowns.  Hope "
"you like the sound of rain on corrugated metal."
msgstr ""
"Geçici bir çerçeveye cıvatalanmış ve tel ile bağlanmış paslı hurda metalden "
"basit bir çatı ve zemin. Kıyamet sonrası gecekondu mahallelerinde çok moda. "
"Dalgalı metal üzerinde yağmur sesini seviyorsanız, tam size göre."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "dirt"
msgstr "toprak"

#. ~ Description for dirt
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"It's dirt.  Looks like some fine soil for tillage.  Could also be dug out "
"for construction projects."
msgstr ""
"Bu toprak. Ekim için uygun ince bir toprak gibi görünüyor. Ayrıca inşaat "
"projeleri için de kazılabilir."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#: data/json/items/chemicals_and_resources.json
msgid "sand"
msgid_plural "sand"
msgstr[0] "kum"
msgstr[1] "kumlar"

#. ~ Description for sand
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"A large area of fine sand that could be useful in a number of ways, if it "
"was extracted properly.  Dig a shallow pit here to harvest the sand."
msgstr ""
"Uygun şekilde çıkarılırsa birçok şekilde faydalı olabilecek geniş bir ince "
"kum alanı. Kumu toplamak için burada sığ bir çukur kazın."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "mud"
msgstr "çamur"

#. ~ Description for mud
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "An area of wet, slick mud."
msgstr "Islak, kaygan çamur alanı."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "moss"
msgstr "yosun"

#. ~ Description for moss
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "Moist spongy moss."
msgstr "Nemli süngerimsi yosun."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "clay"
msgstr "kil"

#. ~ Description for clay
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"A field full of malleable clay, suitable for kiln firing if it was extracted"
" properly.  Dig a shallow pit here to harvest the clay."
msgstr ""
"Doğru şekilde çıkarılırsa fırında pişirmeye uygun, şekillendirilebilir kil "
"ile dolu bir alan. Kili toplamak için burada sığ bir çukur kazın."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "mound of clay"
msgstr "kil yığını"

#. ~ Description for mound of clay
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "A mound of clay soil."
msgstr "Bir kil toprağı yığını."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "paper floor"
msgstr "kağıt zemin"

#. ~ Description for paper floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "Floor made of pulpy mass, covered in sticky wasp saliva."
msgstr ""
"Hamur haline getirilmiş kütleden yapılmış, yapışkan yaban arısı tükürüğü ile"
" kaplanmış zemin."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "hard paper floor"
msgstr "sert kağıt zemin"

#. ~ Description for hard paper floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Hardened cardboard floor made of chewed up trees and resin mixed with wasp "
"saliva."
msgstr ""
"Çiğnenmiş ağaçlar ve reçine ile yaban arısı tükürüğü karışımından yapılmış "
"sertleştirilmiş karton zemin."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "paper brood cap"
msgstr "kağıt yavru kapağı"

#. ~ Description for paper brood cap
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"A thin paper floor, protecting the pupatig wasp larva until it's ready to "
"emerge."
msgstr ""
"İnce bir kağıt zemin, pupalaşan yaban arısı larvasını çıkmaya hazır olana "
"kadar korur."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-roofs.json
#: data/json/overmap/overmap_terrain/overmap_terrain.json
#: data/json/overmap/overmap_terrain/overmap_terrain_commercial.json
#: data/json/overmap/overmap_terrain/overmap_terrain_evac_center.json
#: data/json/overmap/overmap_terrain/overmap_terrain_hardcoded.json
#: data/json/overmap/overmap_terrain/overmap_terrain_lab.json
#: data/json/overmap/overmap_terrain/overmap_terrain_mall.json
#: data/json/overmap/overmap_terrain/overmap_terrain_military.json
#: data/json/overmap/overmap_terrain/overmap_terrain_residential.json
#: data/json/overmap/overmap_terrain/overmap_terrain_robofachq.json
#: data/json/overmap/overmap_terrain/overmap_terrain_waste_junk.json
#: data/mods/alt_map_key/overmap_terrain.json
msgid "open air"
msgstr "açık hava"

#. ~ Description for open air
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "This is open air."
msgstr "Burası açık hava."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "quarry hole air"
msgstr "taş ocağı deliği havası"

#. ~ Description for quarry hole air
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"This is effectively open air, with a frame bracing to ensure anything around"
" it doesnt collapse into it. Blocks roofs, but deconstructing the bracing "
"would be rather easy."
msgstr ""
"Burası etkili bir şekilde açık hava, etrafındaki her şeyin içine çökmesini "
"önlemek için bir çerçeve ile desteklenmiş. Çatıları engeller, ancak "
"destekleri sökmek oldukça kolay olurdu."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "crude plank bridge"
msgstr "ham tahta köprü"

#. ~ Description for crude plank bridge
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "A gathering of planks over a large hole or air. Not very sturdy."
msgstr ""
"Büyük bir delik veya hava üzerinde toplanmış tahtalar. Çok sağlam değil."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "metal bridge"
msgstr "metal köprü"

#. ~ Description for metal bridge
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Some sturdy metal sheets welded into a makeshift bridge. Suprisingly sturdy."
msgstr ""
"Geçici bir köprü olarak kaynaklanmış bazı sağlam metal levhalar. Şaşırtıcı "
"derecede sağlam."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "adobe floor"
msgstr "kerpiç zemin"

#. ~ Description for adobe floor
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Adobe bricks and mortar smoothed out to make a clean fireproof floor, with a"
" matching roof of adobe."
msgstr ""
"Temiz, yangına dayanıklı bir zemin oluşturmak için düzeltilmiş kerpiç "
"tuğlalar ve harç, aynı şekilde kerpiçten yapılmış bir çatı ile."

#. ~ Description for mound of clay
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "A mound of clay soil.  Dig a shallow pit here to harvest the clay."
msgstr ""
"Bir kil toprağı yığını. Kili çıkarmak için burada sığ bir çukur kazın."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "mound of sand"
msgstr "kum yığını"

#. ~ Description for mound of sand
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "A mound of sand.  Dig a shallow pit here to harvest the sand."
msgstr "Bir kum yığını. Kumu çıkarmak için burada sığ bir çukur kazın."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "bog iron"
msgstr "bataklık demiri"

#. ~ Description for bog iron
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"A wet pit with exposed hints of iron-rich earth.  Dig a shallow pit here to "
"stake your claim on the ore."
msgstr ""
"Demir açısından zengin toprağın ipuçlarının ortaya çıktığı ıslak bir çukur. "
"Cevher üzerinde hak iddia etmek için burada sığ bir çukur kazın."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "alluvial deposit"
msgstr "alüvyon birikintisi"

#. ~ Description for alluvial deposit
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"A patch of wet sediment washed ashore by the steady flow of a river, often "
"containing mineral deposits.  And washed-up litter, thanks to pre-cataclysm "
"humanity.  Dig a shallow pit here to see if you strike paydirt."
msgstr ""
"Bir nehrin sürekli akışıyla kıyıya yıkanmış ıslak tortu parçası, genellikle "
"mineral birikintileri içerir. Ve felaket öncesi insanlığın bıraktığı çöpler."
" Burada sığ bir çukur kazın ve şansınızı deneyin."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#: data/json/overmap/overmap_terrain/overmap_terrain.json
msgid "mound of dirt"
msgstr "toprak yığını"

#. ~ Description for mound of dirt
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"An area of heaped dirt, not easily traversable.  If examined more closely, "
"it's quite favorable for planting seeds and the like."
msgstr ""
"Kolayca geçilemeyen bir toprak yığını alanı. Daha yakından incelendiğinde, "
"tohum ekimi ve benzeri işler için oldukça elverişli."

#. ~ Description for mound of dirt
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"A giant hill of dirt that looks like you could crawl inside for shelter."
msgstr ""
"İçine girip barınak olarak kullanabileceğiniz gibi görünen devasa bir toprak"
" tepe."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "paddy field"
msgstr "pirinç tarlası"

#. ~ Description for paddy field
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"A damp, muddy field used to grow crops that require a lot of water.  The "
"clay holds moisture, making it perfect for the crops."
msgstr ""
"Bol su gerektiren bitkilerin yetiştirildiği nemli, çamurlu bir tarla. Kil, "
"nemi tutar ve bu da onu bitkiler için mükemmel kılar."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "ooze bog"
msgstr "çamur bataklığı"

#. ~ Description for ooze bog
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"A pit filled with muddy water.  With additional work, some clay could be "
"separated from the silt."
msgstr ""
"Çamurlu suyla dolu bir çukur. Ekstra çabayla, kilden birazı siltle "
"ayrılabilir."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "odd fault"
msgstr "tuhaf fay"

#. ~ Description for odd fault
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"An unnaturally humanoid-shaped hole, it seems oddly familiar.  There's a "
"strange sensation to examine it closer, as if it belongs to you somehow."
msgstr ""
"Doğal olmayan bir şekilde insanı andıran bir delik, tuhaf bir şekilde "
"tanıdık geliyor. Sanki bir şekilde size aitmiş gibi, daha yakından inceleme "
"isteği uyandırıyor."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "grave"
msgstr "mezar"

#. ~ Description for grave
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"A dirt grave, with some grass growing on it.  At least some of the dead do "
"actually rest in peace."
msgstr ""
"Üzerinde biraz çimen büyüyen toprak bir mezar. En azından bazı ölüler "
"gerçekten huzur içinde yatıyor."

#. ~ Description for grave
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"A fresh grave, covered with stones, either to keep something from digging it"
" out or to keep one inside from digging out of it.  Two planks mark this "
"place of someone's eternal rest."
msgstr ""
"Taşlarla kaplanmış taze bir mezar, ya bir şeyin onu kazıp çıkarmasını "
"engellemek ya da içindekinin dışarı çıkmasını engellemek için. İki tahta, "
"birinin ebedi dinlenme yerini işaret ediyor."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "pavement"
msgstr "kaldırım"

#. ~ Description for pavement
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"A segment of asphalt, slowly degrading from cracks, frost heaves and lack of"
" maintenance."
msgstr ""
"Çatlaklar, don kabarmaları ve bakım eksikliği nedeniyle yavaşça bozulan bir "
"asfalt parçası."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "yellow pavement"
msgstr "sarı kaldırım"

#. ~ Description for yellow pavement
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"Streaks of carefully aligned yellow paint mark the road to inform drivers "
"not to cross.  No one is enforcing these rules anymore."
msgstr ""
"Özenle hizalanmış sarı boya çizgileri, sürücüleri yolu geçmemeleri konusunda"
" bilgilendirir. Artık kimse bu kuralları uygulamıyor."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "sidewalk"
msgstr "yaya kaldırımı"

#. ~ Description for sidewalk
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"An area of common poured concrete, damaged by frost heaves and large cracks "
"due to lack of maintenance."
msgstr ""
"Don kabarmaları ve bakım eksikliği nedeniyle büyük çatlaklarla zarar görmüş,"
" yaygın dökme betondan bir alan."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#: data/json/items/generic.json
msgid "concrete"
msgid_plural "concrete"
msgstr[0] "beton"
msgstr[1] "betonlar"

#. ~ Description for concrete
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"A newer segment of poured concrete with surface finishes for aesthetics and "
"resistance to freeze-thaw cycles."
msgstr ""
"Estetik ve donma-çözülme döngülerine karşı direnç için yüzey kaplamalarına "
"sahip daha yeni bir dökme beton parçası."

#. ~ Description for concrete
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"A newer segment of poured concrete with surface finishes for aesthetics and "
"resistance to freeze-thaw cycles.  Covered with a streak of yellow paint."
msgstr ""
"Estetik ve donma-çözülme döngülerine karşı direnç için yüzey kaplamalarına "
"sahip daha yeni bir dökme beton parçası. Üzerine sarı boya çizgisi çekilmiş."

#. ~ Description for wooden floor
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"Wooden floor created from boards, packed tightly together and nailed down.  "
"Common in patios."
msgstr ""
"Sıkıca bir araya getirilmiş ve çivilenmiş tahtalardan yapılmış ahşap zemin. "
"Genellikle verandalarda yaygındır."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "underwater wooden floor"
msgstr "su altı ahşap zemin"

#. ~ Description for underwater wooden floor
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "Rotting old floorboards long since repurposed as Davy Jones's patio."
msgstr ""
"Davy Jones'un verandası olarak uzun zaman önce yeniden kullanılan çürüyen "
"eski döşeme tahtaları."

#. ~ Description for metal floor
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"High-quality and tough checkered flooring to reduce risk of slips and falls."
msgstr ""
"Kayma ve düşme riskini azaltmak için yüksek kaliteli ve dayanıklı kareli "
"zemin."

#. ~ Description for junk metal floor
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"A simple floor of rusty scrap metal bolted and wire-tied to a makeshift "
"frame.  Very fashionable in post-apocalyptic shantytowns."
msgstr ""
"Geçici bir çerçeveye cıvatalanmış ve tel ile bağlanmış paslı hurda metalden "
"basit bir zemin. Kıyamet sonrası gecekondu mahallelerinde çok moda."

#. ~ Description for dirt floor
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "Floor consisting of finely mixed earth that has been tamped down."
msgstr "İnce karıştırılmış toprağın sıkıştırılmasıyla oluşan zemin."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "orifice"
msgstr "orifis"

#. ~ Description for orifice
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"A large round orifice with trails of fresh and dried up strange green liquid"
" with a strong acid odor covering its inner sides."
msgstr ""
"İç kısımlarını kaplayan güçlü bir asit kokusuna sahip taze ve kurumuş garip "
"yeşil sıvı izleri olan büyük yuvarlak bir orifis."

#. ~ Description for elevator
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "An elevator section of the flight deck."
msgstr "Uçuş güvertesinin asansör bölümü."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "deck coating"
msgstr "güverte kaplaması"

#. ~ Description for deck coating
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"Thick metal coating of a hull, covered with a military grade epoxy mix.  "
"Used for runways, and can't be melted by jet engine nozzles."
msgstr ""
"Askeri sınıf epoksi karışımı ile kaplanmış kalın metal gövde kaplaması. "
"Pistler için kullanılır ve jet motoru nozulları tarafından eritilemez."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "yellow deck coating"
msgstr "sarı güverte kaplaması"

#. ~ Description for yellow deck coating
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"Thick metal covering of a hull, covered with a military grade epoxy mix, and"
" painted in yellow color."
msgstr ""
"Kalın metal kaplama, askeri sınıf bir epoksi karışımı ile kaplanmış ve sarı "
"renge boyanmış."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "red deck coating"
msgstr "kırmızı güverte kaplaması"

#. ~ Description for red deck coating
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"Thick metal covering of a hull, covered with a military grade epoxy mix, and"
" painted in red color."
msgstr ""
"Kalın metal kaplama, askeri sınıf bir epoksi karışımı ile kaplanmış ve "
"kırmızı renge boyanmış."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "white deck coating"
msgstr "beyaz güverte kaplaması"

#. ~ Description for white deck coating
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"Thick metal covering of a hull, covered with a military grade epoxy mix, and"
" painted in white color."
msgstr ""
"Kalın metal kaplama, askeri sınıf bir epoksi karışımı ile kaplanmış ve beyaz"
" renge boyanmış."

#. ~ Description for concrete floor
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "A bare and cold concrete floor with a streak of yellow paint."
msgstr "Üzerinde sarı boya izi olan çıplak ve soğuk bir beton zemin."

#. ~ Description for concrete floor
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "A bare and cold concrete floor."
msgstr "Çıplak ve soğuk bir beton zemin."

#. ~ Description for adobe floor
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "Adobe bricks and mortar smoothed out to make a clean fireproof floor."
msgstr ""
"Temiz ve yangına dayanıklı bir zemin oluşturmak için düzeltilmiş kerpiç "
"tuğlalar ve harç."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "trash island"
msgstr "çöp adası"

#. ~ Description for trash island
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"A small section of floating trash debris, neatly tied and packed together."
msgstr ""
"Düzenli bir şekilde bağlanmış ve paketlenmiş küçük bir yüzen çöp yığını."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "sandy trash island"
msgstr "kumlu çöp adası"

#. ~ Description for sandy trash island
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid ""
"A small section of floating trash debris, neatly tied and packed together.  "
"This section has been covered with sand and soil, making it more stable and "
"able to sustain certain plants."
msgstr ""
"Düzenli bir şekilde bağlanmış ve paketlenmiş, yüzen çöp kalıntılarından "
"oluşan küçük bir bölüm. Bu bölüm kum ve toprakla kaplanmış, bu da onu daha "
"kararlı hale getirerek belirli bitkilerin yetişmesine olanak tanımıştır."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "walnut tree"
msgstr "ceviz ağacı"

#. ~ Description for walnut tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A massive tree belonging to the 'Juglans' genus.  If you look closely you "
"can see some unharvested walnuts.  You could cut it down with the right "
"tools."
msgstr ""
"'Juglans' cinsine ait devasa bir ağaç. Dikkatlice bakarsanız, hasat "
"edilmemiş cevizleri görebilirsiniz. Doğru aletlerle onu kesebilirsiniz."

#. ~ Description for walnut tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A massive tree belonging to the 'Juglans' genus.  You could cut it down with"
" the right tools."
msgstr ""
"'Juglans' cinsine ait devasa bir ağaç. Doğru aletlerle onu kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "blackjack oak"
msgstr "kara meşe"

#. ~ Description for blackjack oak
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A deciduous tree of the genus 'Quercus', with bark cracked into rectangular "
"black plates split by narrow orange fissures.  You could peel off the bark "
"sections if you examined the tree more closely.  You could cut it down with "
"the right tools."
msgstr ""
"Kabuğu dikdörtgen siyah plakalar halinde çatlamış ve dar turuncu yarıklarla "
"ayrılmış 'Quercus' cinsine ait yaprak döken bir ağaç. Ağacı daha yakından "
"incelerseniz kabuk bölümlerini soyabilirsiniz. Doğru aletlerle onu "
"kesebilirsiniz."

#. ~ Description for blackjack oak
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A deciduous tree of the genus 'Quercus', with bark cracked into rectangular "
"black plates split by narrow orange fissures.  All usable bark has been "
"stripped off.  You could cut it down with the right tools."
msgstr ""
"Kabuğu dikdörtgen siyah plakalar halinde çatlamış ve dar turuncu yarıklarla "
"ayrılmış 'Quercus' cinsine ait yaprak döken bir ağaç. Kullanılabilir tüm "
"kabuklar soyulmuş. Doğru aletlerle onu kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "chestnut tree"
msgstr "kestane ağacı"

#. ~ Description for chestnut tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A massive tree belonging to the 'Castanea' genus.  If you look closely you "
"can see some unharvested chestnuts.  You could cut it down with the right "
"tools."
msgstr ""
"'Castanea' cinsine ait devasa bir ağaç. Dikkatlice bakarsanız, hasat "
"edilmemiş kestaneleri görebilirsiniz. Doğru aletlerle onu kesebilirsiniz."

#. ~ Description for chestnut tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A massive tree belonging to the 'Castanea' genus.  You could cut it down "
"with the right tools."
msgstr ""
"'Castanea' cinsine ait devasa bir ağaç. Doğru araçlarla kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "beech tree"
msgstr "kayın ağacı"

#. ~ Description for beech tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A massive tree belonging to the 'Fagus' genus.  If you look closely you can "
"see some unharvested beech nuts.  You could cut it down with the right "
"tools."
msgstr ""
"'Fagus' cinsine ait devasa bir ağaç. Dikkatlice bakarsanız, toplanmamış "
"kayın fındıklarını görebilirsiniz. Doğru araçlarla kesebilirsiniz."

#. ~ Description for beech tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A massive tree belonging to the 'Fagus' genus.  You could cut it down with "
"the right tools."
msgstr "'Fagus' cinsine ait devasa bir ağaç. Doğru araçlarla kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "hazelnut tree"
msgstr "fındık ağacı"

#. ~ Description for hazelnut tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A stubby tree belonging to the 'Corylus' genus.  If you look closely you can"
" see some unharvested hazelnuts.  You could cut it down with the right "
"tools."
msgstr ""
"'Corylus' cinsine ait bodur bir ağaç. Dikkatlice bakarsanız, toplanmamış "
"fındıkları görebilirsiniz. Doğru araçlarla kesebilirsiniz."

#. ~ Description for hazelnut tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A stubby tree belonging to the 'Corylus' genus.  You could cut it down with "
"the right tools."
msgstr "'Corylus' cinsine ait bodur bir ağaç. Doğru araçlarla kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "oak tree"
msgstr "meşe ağacı"

#. ~ Description for oak tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A massive deciduous tree belonging to the 'Quercus' genus, commonly found "
"throughout New England region.  If you look closely you can see some acorns "
"the squirrels haven't gotten yet.  You could cut it down with the right "
"tools."
msgstr ""
"New England bölgesinde yaygın olarak bulunan, 'Quercus' cinsine ait devasa "
"bir yaprak döken ağaç. Dikkatlice bakarsanız, sincapların henüz almadığı "
"meşe palamutlarını görebilirsiniz. Doğru araçlarla kesebilirsiniz."

#. ~ Description for oak tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A massive deciduous tree belonging to the 'Quercus' genus, commonly found "
"throughout New England region.  You could cut it down with the right tools."
msgstr ""
"New England bölgesinde yaygın olarak bulunan, 'Quercus' cinsine ait devasa "
"bir yaprak döken ağaç. Doğru araçlarla kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "cottonwood tree"
msgstr "kavak ağacı"

#. ~ Description for cottonwood tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A large tree belonging to the 'Populus' genus, commonly found throughout New"
" England region.  You could cut it down with the right tools."
msgstr ""
"'Populus' cinsine ait, genellikle New England bölgesinde bulunan büyük bir "
"ağaç. Doğru aletlerle kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "elm tree"
msgstr "karaağaç"

#. ~ Description for elm tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A large tree belonging to the 'Ulmus' genus, commonly found throughout New "
"England region.  You could cut it down with the right tools."
msgstr ""
"'Ulmus' cinsine ait, genellikle New England bölgesinde bulunan büyük bir "
"ağaç. Doğru aletlerle kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "dead tree"
msgstr "ölü ağaç"

#. ~ Description for dead tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"An indiscernible tree that has withered away, whether by weather, fire or "
"otherworldy.  You could cut it down with the right tools."
msgstr ""
"Hava koşulları, yangın veya başka sebeplerle solmuş, tanınmaz hale gelmiş "
"bir ağaç. Doğru aletlerle kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "young tree"
msgstr "genç ağaç"

#. ~ Description for young tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A relatively young sapling of an indeterminate species.  It could take "
"decades before reaching maturity, so there's no use waiting around."
msgstr ""
"Belirsiz bir türe ait nispeten genç bir fidan. Olgunluğa ulaşması onlarca "
"yıl alabilir, bu yüzden beklemenin bir anlamı yok."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "apple tree"
msgstr "elma ağacı"

#. ~ Description for apple tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"This tree is a member of the 'Malus' genus, producing fruit commonly known "
"as apples.  If you examined the branches more closely, you could probably "
"find a few mature ones in autumn."
msgstr ""
"'Malus' cinsine ait, genellikle elma olarak bilinen meyveler üreten bir "
"ağaç. Dalları daha yakından incelerseniz, muhtemelen sonbaharda birkaç olgun"
" elma bulabilirsiniz."

#. ~ Description for apple tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"This tree is a member of the 'Malus' genus, producing fruit commonly known "
"as apples.  There doesn't appear to be any ripe apples now.  You could also "
"cut it down with the right tools."
msgstr ""
"Bu ağaç, 'Malus' cinsine ait olup, genellikle elma olarak bilinen meyveler "
"üretir. Şu anda olgun elma görünmüyor. Doğru araçlarla onu kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "pear tree"
msgstr "armut ağacı"

#. ~ Description for pear tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"This is 'Pyrus communis', or the common pear tree, which produces viable "
"pears in the fall.  If you examined the branches more closely, you could "
"probably find a few mature ones.  You could also cut it down with the right "
"tools."
msgstr ""
"Bu, 'Pyrus communis' yani yaygın armut ağacıdır ve sonbaharda olgunlaşabilir"
" armutlar üretir. Dalları daha yakından incelerseniz, muhtemelen birkaç "
"olgun olanını bulabilirsiniz. Doğru araçlarla onu kesebilirsiniz."

#. ~ Description for pear tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"This is 'Pyrus communis', or the common pear tree, which produces viable "
"pears in the fall.  Looks like all the ripe pears have been picked.  You "
"could also cut it down with the right tools."
msgstr ""
"Bu, 'Pyrus communis' yani yaygın armut ağacıdır ve sonbaharda olgunlaşabilir"
" armutlar üretir. Görünüşe göre tüm olgun armutlar toplanmış. Doğru "
"araçlarla onu kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "coffee tree"
msgstr "kahve ağacı"

#. ~ Description for coffee tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"This is 'gymnocladus dioicus', or the kentucky coffee tree, which produces "
"roastable coffee pods and brewable leaves in the fall.  If you examined the "
"branches more closely, you could probably find a few mature ones.  You could"
" also cut it down with the right tools."
msgstr ""
"Bu, 'gymnocladus dioicus' yani Kentucky kahve ağacıdır ve sonbaharda "
"kavrulabilir kahve kapsülleri ve demlenebilir yapraklar üretir. Dalları daha"
" yakından incelerseniz, muhtemelen birkaç olgun olanını bulabilirsiniz. "
"Doğru araçlarla onu kesebilirsiniz."

#. ~ Description for coffee tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"This is 'gymnocladus dioicus', or the kentucky coffee tree, which produces "
"roastable coffee pods and brewable leaves in the fall.  Looks like all the "
"ripe pods have been picked.  You could also cut it down with the right "
"tools."
msgstr ""
"Bu, 'gymnocladus dioicus' yani Kentucky kahve ağacıdır ve sonbaharda "
"kavrulabilir kahve kapsülleri ve demlenebilir yapraklar üretir. Görünüşe "
"göre tüm olgun kapsüller toplanmış. Doğru araçlarla onu kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "cherry tree"
msgstr "kiraz ağacı"

#. ~ Description for cherry tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"One of the several species of 'Prunus' trees found in New England, it bears "
"cherries in the summer.  If you examined the foliage more closely, you could"
" probably find some viable clusters.  You could also cut it down with the "
"right tools."
msgstr ""
"New England'da bulunan birkaç 'Prunus' türünden biri olup, yazın kiraz "
"verir. Yaprakları daha yakından incelerseniz, muhtemelen birkaç uygun salkım"
" bulabilirsiniz. Doğru araçlarla onu kesebilirsiniz."

#. ~ Description for cherry tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"One of the several species of 'Prunus' trees found in New England, it bears "
"cherries in the summer.  Looks like all the ripe bunches of cherries have "
"been picked.  You could also cut it down with the right tools."
msgstr ""
"New England'da bulunan birkaç 'Prunus' türünden biri olup, yazın kiraz "
"verir. Görünüşe göre tüm olgun kiraz salkımları toplanmış. Doğru araçlarla "
"onu kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "juniper tree"
msgstr "ardıç ağacı"

#. ~ Description for juniper tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"One of the species of 'Juniperus' that grows in New England, juniper berries"
" grow over two to three years, first flowering.  On the second year "
"producing a green berry, the last, they produce their more famed blue "
"varieties.  If you examined the foliage more closely, you could probably "
"find some viable clusters.  You could also cut it down with the right tools."
msgstr ""
"New England'de yetişen 'Juniperus' türlerinden biri olan ardıç meyveleri, "
"iki ila üç yıl boyunca büyür, ilk olarak çiçek açar. İkinci yılda yeşil bir "
"meyve üretir, son yılda ise daha ünlü mavi çeşitlerini üretirler. Yaprakları"
" daha yakından incelerseniz, muhtemelen bazı olgunlaşmış kümeler "
"bulabilirsiniz. Doğru araçlarla onu kesebilirsiniz de."

#. ~ Description for juniper tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"One of the species of 'Juniperus' that grows in New England, juniper berries"
" grow over two to three years.  In the first year they flower, in the second"
" year they produce a green berry, the last, they produce their more famed "
"blue varieties.  Looks like all the ripe bunches of berries have been "
"picked.  You could also cut it down with the right tools."
msgstr ""
"New England'de yetişen 'Juniperus' türlerinden biri olan ardıç meyveleri, "
"iki ila üç yıl boyunca büyür. İlk yıl çiçek açar, ikinci yılda yeşil bir "
"meyve üretir, son yılda ise daha ünlü mavi çeşitlerini üretirler. Görünüşe "
"göre tüm olgun meyve kümeleri toplanmış. Doğru araçlarla onu kesebilirsiniz "
"de."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "peach tree"
msgstr "şeftali ağacı"

#. ~ Description for peach tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"One of the several species of 'Prunus' trees found in New England, it bears "
"peaches in the summer.  If you examined the branches more closely, you could"
" probably find some mature peaches.  You could also cut it down with the "
"right tools."
msgstr ""
"New England'de bulunan birkaç 'Prunus' türünden biri, yazın şeftali verir. "
"Dalları daha yakından incelerseniz, muhtemelen bazı olgun şeftaliler "
"bulabilirsiniz. Doğru araçlarla onu kesebilirsiniz de."

#. ~ Description for peach tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"One of the several species of 'Prunus' trees found in New England, it bears "
"peaches in the summer.  Looks like all the ripe peaches have been picked.  "
"You could also cut it down with the right tools."
msgstr ""
"New England'de bulunan birkaç 'Prunus' türünden biri, yazın şeftali verir. "
"Görünüşe göre tüm olgun şeftaliler toplanmış. Doğru araçlarla onu "
"kesebilirsiniz de."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "apricot tree"
msgstr "kayısı ağacı"

#. ~ Description for apricot tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A transplanted species of 'Prunus armeniaca', rarely found in New England.  "
"It produces apricots in the summer.  If you examined the spurs more closely,"
" you could probably find some mature apricots.  You could also cut it down "
"with the right tools."
msgstr ""
"New England'de nadiren bulunan 'Prunus armeniaca' türünden bir ağaç. Yazın "
"kayısı üretir. Dalları daha yakından incelerseniz, muhtemelen bazı olgun "
"kayısılar bulabilirsiniz. Doğru araçlarla onu kesebilirsiniz de."

#. ~ Description for apricot tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A transplanted species of 'Prunus armeniaca', rarely found in New England.  "
"It produces apricots in the summer.  Looks like all the ripe apricots have "
"been picked.  You could also cut it down with the right tools."
msgstr ""
"New England'de nadiren bulunan 'Prunus armeniaca' türünden bir ağaç. Yazın "
"kayısı üretir. Görünüşe göre tüm olgun kayısılar toplanmış. Doğru araçlarla "
"onu kesebilirsiniz de."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "plum tree"
msgstr "erik ağacı"

#. ~ Description for plum tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"One of the several species of 'Prunus' trees found in New England, it "
"produces plums in the summer.  If you examined the spurs more closely, you "
"could probably find some ripe plums.  You could also cut it down with the "
"right tools."
msgstr ""
"New England'de bulunan birkaç 'Prunus' türünden biri olan bu ağaç, yazın "
"erik üretir. Dalları daha yakından incelerseniz, muhtemelen olgun erikler "
"bulabilirsiniz. Doğru aletlerle onu kesebilirsiniz de."

#. ~ Description for plum tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"One of the several species of 'Prunus' trees found in New England, it "
"produces plums in the summer.  Looks like all the ripe plums have been "
"picked.  You could also cut it down with the right tools."
msgstr ""
"New England'de bulunan birkaç 'Prunus' türünden biri olan bu ağaç, yazın "
"erik üretir. Görünüşe göre tüm olgun erikler toplanmış. Doğru aletlerle onu "
"kesebilirsiniz de."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "mulberry tree"
msgstr "dut ağacı"

#. ~ Description for mulberry tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"This tree is a member of the 'Morus' genus, producing fruit commonly known "
"as mulberries.  In the summer many berries can be picked.  You could also "
"cut it down with the right tools."
msgstr ""
"Bu ağaç, 'Morus' cinsine ait olup, genellikle dut olarak bilinen meyveler "
"üretir. Yazın birçok dut toplanabilir. Doğru aletlerle onu kesebilirsiniz "
"de."

#. ~ Description for mulberry tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"This tree is a member of the 'Morus' genus, producing fruit commonly known "
"as mulberries.  There doesn't appear to be any ripe mulberries now.  You "
"could also cut it down with the right tools."
msgstr ""
"Bu ağaç, 'Morus' cinsine ait olup, genellikle dut olarak bilinen meyveler "
"üretir. Şu anda olgun dut görünmüyor. Doğru aletlerle onu kesebilirsiniz de."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "elderberry tree"
msgstr "mürver ağacı"

#. ~ Description for elderberry tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"This tree is a member of the 'Sambucus' genus, producing fruit commonly "
"known as elderberries.  In the summer many berries can be picked.  You could"
" also cut it down with the right tools."
msgstr ""
"Bu ağaç, 'Sambucus' cinsine ait olup, genellikle mürver olarak bilinen "
"meyveler üretir. Yazın birçok mürver toplanabilir. Doğru aletlerle onu "
"kesebilirsiniz de."

#. ~ Description for elderberry tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"This tree is a member of the 'Sambucus' genus, producing fruit commonly "
"known as elderberries.  There doesn't appear to be any ripe elderberries "
"now.  You could also cut it down with the right tools."
msgstr ""
"Bu ağaç, 'Sambucus' cinsine ait olup, genellikle mürver olarak bilinen "
"meyveler üretir. Şu anda olgun mürver görünmüyor. Doğru aletlerle onu "
"kesebilirsiniz de."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "pine tree"
msgstr "çam ağacı"

#. ~ Description for pine tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A towering coniferous tree that belongs to the 'Pinus' genus, with the New "
"England species varying from 'P. strobus', 'P. resinosa' and 'P. rigida'.  "
"If you examined the tree more closely, you might find usable sticky whorls "
"and unharvested pinecones.  Also, you could cut it down with the right "
"tools."
msgstr ""
"'Pinus' cinsine ait devasa bir kozalaklı ağaç olup, New England türleri 'P. "
"strobus', 'P. resinosa' ve 'P. rigida' olarak çeşitlilik gösterir. Ağacı "
"daha yakından incelerseniz, kullanılabilir yapışkan dallar ve toplanmamış "
"kozalaklar bulabilirsiniz. Ayrıca, doğru aletlerle onu kesebilirsiniz."

#. ~ Description for pine tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A towering coniferous tree that belongs to the 'Pinus' genus, with the New "
"England species varying from 'P. strobus', 'P. resinosa' and 'P. rigida'.  "
"Some of the branches have been stripped away and many of the pinecones "
"aren't developed fully yet, but given a season, it could be harvestable "
"again.  Also, you could cut it down with the right tools."
msgstr ""
"New England bölgesinde 'P. strobus', 'P. resinosa' ve 'P. rigida' türleriyle"
" çeşitlenen, 'Pinus' cinsine ait devasa bir kozalaklı ağaç. Bazı dalları "
"soyulmuş ve birçok kozalak henüz tam olarak gelişmemiş, ancak bir mevsim "
"sonra tekrar hasat edilebilir. Ayrıca, doğru aletlerle kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "dead pine tree"
msgstr "ölü çam ağacı"

#. ~ Description for dead pine tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A towering coniferous tree that belongs to the 'Pinus' genus, with the New "
"England species varying from 'P. strobus', 'P. resinosa' and 'P. rigida'.  "
"This trees branches are bare, and it appears to be dead.  You could cut it "
"down with the right tools."
msgstr ""
"New England bölgesinde 'P. strobus', 'P. resinosa' ve 'P. rigida' türleriyle"
" çeşitlenen, 'Pinus' cinsine ait devasa bir kozalaklı ağaç. Bu ağacın "
"dalları çıplak ve ölü görünüyor. Doğru aletlerle kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "birch tree"
msgstr "huş ağacı"

#. ~ Description for birch tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A tall deciduous tree of the 'Betula' genus, with the characteristic peeling"
" bark.  Species like 'B. alleghaniensis', 'B. papyrifera', and 'B. "
"populifolia' are the most common in the New England region.  You could tear "
"off some strips of bark if you examined the tree more closely.  You could "
"cut it down with the right tools."
msgstr ""
"'Betula' cinsine ait, karakteristik soyulmuş kabuğu olan uzun bir yaprak "
"döken ağaç. 'B. alleghaniensis', 'B. papyrifera' ve 'B. populifolia' gibi "
"türler New England bölgesinde en yaygın olanlarıdır. Ağacı daha yakından "
"incelerseniz, bazı kabuk şeritlerini koparabilirsiniz. Doğru aletlerle "
"kesebilirsiniz."

#. ~ Description for birch tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A tall deciduous tree of the 'Betula' genus, with the characteristic peeling"
" bark.  Species like 'B. alleghaniensis', 'B. papyrifera', and 'B. "
"populifolia' are the most common in the New England region.  Looks like "
"there isn't enough rhytidome to peel off yet.  You could cut it down with "
"the right tools."
msgstr ""
"'Betula' cinsine ait, karakteristik soyulmuş kabuğu olan uzun bir yaprak "
"döken ağaç. 'B. alleghaniensis', 'B. papyrifera' ve 'B. populifolia' gibi "
"türler New England bölgesinde en yaygın olanlarıdır. Görünüşe göre soyulacak"
" yeterli kabuk yok. Doğru aletlerle kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "willow tree"
msgstr "söğüt ağacı"

#. ~ Description for willow tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A tall, wide deciduous tree of the 'Salix' genus, with long thin leafy "
"branches that hang down like curtains.  You could tear off some bark.  You "
"could cut it down with the right tools."
msgstr ""
"'Salix' cinsine ait, uzun ince yapraklı dalları perde gibi sarkan geniş bir "
"yaprak döken ağaç. Biraz kabuk koparabilirsiniz. Doğru aletlerle "
"kesebilirsiniz."

#. ~ Description for willow tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A tall, wide deciduous tree of the 'Salix' genus, with long thin leafy "
"branches that hang down like curtains.  Looks like all usable bark has been "
"torn off, and new rhytidomes have not formed yet.  You could cut it down "
"with the right tools."
msgstr ""
"'Salix' cinsine ait, uzun ince yapraklı dalları perde gibi sarkan geniş bir "
"yaprak döken ağaç. Görünüşe göre kullanılabilir tüm kabuklar koparılmış ve "
"yeni kabuklar henüz oluşmamış. Doğru aletlerle kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "maple tree"
msgstr "akçaağaç ağacı"

#. ~ Description for maple tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A large deciduous tree of the 'Acer' genus.  The leaves are distinctively "
"shaped with five prongs.  It could be tapped in order to extract maple "
"syrup.  You could cut it down with the right tools."
msgstr ""
"'Acer' cinsine ait büyük bir yaprak döken ağaç. Yaprakları, beş çıkıntılı "
"karakteristik bir şekle sahiptir. Akçaağaç şurubu çıkarmak için musluk "
"takılabilir. Doğru aletlerle kesebilirsiniz."

#. ~ Description for maple tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A large deciduous tree of the 'Acer' genus.  The leaves are distinctively "
"shaped with five prongs.  A spigot is wedged into the trunk, and sweet maple"
" syrup can be extracted.  You could cut it down with the right tools."
msgstr ""
"'Acer' cinsine ait büyük bir yaprak döken ağaç. Yaprakları, beş çıkıntılı "
"karakteristik bir şekle sahiptir. Gövdeye bir musluk takılmış ve tatlı "
"akçaağaç şurubu çıkarılabilir. Doğru aletlerle kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "hickory tree"
msgstr "ceviz ağacı"

#. ~ Description for hickory tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A tall deciduous tree of the 'Carya' genus.  You could look for hickory nuts"
" if you examined the tree more closely.  You could cut it down with the "
"right tools."
msgstr ""
"'Carya' cinsine ait uzun bir yaprak döken ağaç. Ağacı daha yakından "
"incelerseniz ceviz arayabilirsiniz. Doğru aletlerle kesebilirsiniz."

#. ~ Description for hickory tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A tall deciduous tree of the 'Carya' genus.  It looks like the tree has been"
" picked clean of hickory nuts.  You could cut it down with the right tools."
msgstr ""
"'Carya' cinsine ait uzun bir yaprak döken ağaç. Görünüşe göre ağaç "
"cevizlerden tamamen temizlenmiş. Doğru aletlerle kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "pistachio tree"
msgstr "antep fıstığı ağacı"

#. ~ Description for pistachio tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A deciduous tree of the 'Pistacia' genus.  This is a cultivated tree, and is"
" not native to this region.  You could look for pistachio nuts if you "
"examined the tree more closely.  You could cut it down with the right tools."
msgstr ""
"'Pistacia' cinsine ait bir yaprak döken ağaç. Bu, yetiştirilmiş bir ağaçtır "
"ve bu bölgeye özgü değildir. Ağacı daha yakından incelerseniz antep fıstığı "
"arayabilirsiniz. Doğru aletlerle kesebilirsiniz."

#. ~ Description for pistachio tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A deciduous tree of the 'Pistacia' genus.  This is a cultivated tree, and is"
" not native to this region.  Unfortunately, it looks like it has been picked"
" clean of pistachio nuts.  You could cut it down with the right tools."
msgstr ""
"'Pistacia' cinsine ait bir yaprak döken ağaç. Bu, yetiştirilmiş bir ağaçtır "
"ve bu bölgeye özgü değildir. Ne yazık ki, antep fıstıklarından tamamen "
"temizlenmiş görünüyor. Doğru aletlerle kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "almond tree"
msgstr "badem ağacı"

#. ~ Description for almond tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A deciduous tree of the 'Prunus' genus.  This is a cultivated tree, and is "
"not native to this region.  You could look for fresh almonds if you examined"
" the tree more closely.  You could cut it down with the right tools."
msgstr ""
"'Prunus' cinsine ait bir yaprak döken ağaç. Bu, yetiştirilmiş bir ağaçtır ve"
" bu bölgeye özgü değildir. Ağacı daha yakından incelerseniz taze badem "
"arayabilirsiniz. Doğru aletlerle kesebilirsiniz."

#. ~ Description for almond tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A deciduous tree of the 'Prunus' genus.  This is a cultivated tree, and is "
"not native to this region.  There are no almonds left to pick on the tree.  "
"You could cut it down with the right tools."
msgstr ""
"'Prunus' cinsine ait yaprak döken bir ağaç. Bu, yetiştirilmiş bir ağaçtır ve"
" bu bölgeye özgü değildir. Ağaçta toplanacak badem kalmamış. Doğru aletlerle"
" kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "pecan tree"
msgstr "pekan ağacı"

#. ~ Description for pecan tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A tall deciduous tree of the 'Carya' genus.  You could look for pecan nuts "
"if you examined the tree more closely.  You could cut it down with the right"
" tools."
msgstr ""
"'Carya' cinsine ait uzun bir yaprak döken ağaç. Ağacı daha yakından "
"incelerseniz pekan cevizi bulabilirsiniz. Doğru aletlerle kesebilirsiniz."

#. ~ Description for pecan tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A tall deciduous tree of the 'Carya' genus.  It doesn't look like there are "
"any pecan nuts left on the tree.  You could cut it down with the right "
"tools."
msgstr ""
"'Carya' cinsine ait uzun bir yaprak döken ağaç. Ağaçta pekan cevizi kalmamış"
" gibi görünüyor. Doğru aletlerle kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "dead hickory tree"
msgstr "ölü hickory ağacı"

#. ~ Description for dead hickory tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"The dead remnants of a tall deciduous tree of the 'Carya' genus.  Nothing "
"useful can be foraged from this poor, dead tree.  You could cut it down with"
" the right tools."
msgstr ""
"'Carya' cinsine ait uzun bir yaprak döken ağacın ölü kalıntıları. Bu "
"zavallı, ölü ağaçtan toplanacak faydalı bir şey yok. Doğru aletlerle "
"kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
#: data/json/items/comestibles/other.json
msgid "underbrush"
msgid_plural "underbrushes"
msgstr[0] "çalılık"
msgstr[1] "çalılıklar"

#. ~ Description for underbrush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"Small plants and shrubs that decorate the forest.  An observant forager "
"could obtain edible plants, acorns, eggs, and mushrooms from it."
msgstr ""
"Ormanı süsleyen küçük bitkiler ve çalılar. Dikkatli bir toplayıcı, buradan "
"yenilebilir bitkiler, meşe palamudu, yumurta ve mantar elde edebilir."

#: data/json/furniture_and_terrain/terrain-flora.json
#: data/json/furniture_and_terrain/terrain-manufactured.json
#: data/mods/desert_region/desert_terrain.json
msgid "brush."
msgstr "çalı."

#. ~ Description for underbrush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"Small plants and shrubs that decorate the forest.  It has been rummaged "
"through and doesn't have anything useful left to forage from it."
msgstr ""
"Ormanı süsleyen küçük bitkiler ve çalılar. İçinde karıştırılmış ve "
"toplanacak faydalı bir şey kalmamış."

#. ~ Description for underbrush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"Small plants and shrubs that decorate the forest.  It has been rummaged "
"through and doesn't have anything useful left to forage from it.  Frost "
"covers it."
msgstr ""
"Ormanı süsleyen küçük bitkiler ve çalılar. İçinde karıştırılmış ve "
"toplanacak faydalı bir şey kalmamış. Üzerini don kaplamış."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "shrub"
msgstr "çalı"

#. ~ Description for shrub
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small shrub."
msgstr "Küçük bir çalı."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "peanut bush"
msgstr "yer fıstığı çalısı"

#. ~ Description for peanut bush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small bush of crunchy peanuts."
msgstr "Kıtır kıtır yer fıstıklarından oluşan küçük bir çalı."

#. ~ Description for peanut bush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small peanut bush that's fruitless."
msgstr "Meyvesiz küçük bir yer fıstığı çalısı."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "blueberry bush"
msgstr "yaban mersini çalısı"

#. ~ Description for blueberry bush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small bush of sweet blueberries."
msgstr "Tatlı yaban mersinlerinden oluşan küçük bir çalı."

#. ~ Description for blueberry bush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small blueberry bush that's fruitless."
msgstr "Meyvesiz küçük bir yaban mersini çalısı."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "strawberry bush"
msgstr "çilek çalısı"

#. ~ Description for strawberry bush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small bush of juicy strawberries."
msgstr "Sulu çileklerden oluşan küçük bir çalı."

#. ~ Description for strawberry bush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small strawberry bush that's fruitless."
msgstr "Meyvesiz küçük bir çilek çalısı."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "blackberry bush"
msgstr "böğürtlen çalısı"

#. ~ Description for blackberry bush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small bush of delicious blackberries.  Watch out for its thorns!"
msgstr "Lezzetli böğürtlenlerle dolu küçük bir çalı. Dikenlerine dikkat et!"

#. ~ Description for blackberry bush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small blackberry bush that's fruitless.  Watch out for its thorns!"
msgstr "Meyvesiz küçük bir böğürtlen çalısı. Dikenlerine dikkat et!"

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "huckleberry bush"
msgstr "yaban mersini çalısı"

#. ~ Description for huckleberry bush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small bush of huckleberries, often mistaken as blueberries."
msgstr ""
"Genellikle yaban mersini ile karıştırılan küçük bir yaban mersini çalısı."

#. ~ Description for huckleberry bush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small huckleberry bush that's fruitless."
msgstr "Meyvesiz küçük bir yaban mersini çalısı."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "raspberry bush"
msgstr "ahududu çalısı"

#. ~ Description for raspberry bush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small bush of delicious raspberries.  Watch out for its thorns!"
msgstr "Lezzetli ahududularla dolu küçük bir çalı. Dikenlerine dikkat et!"

#. ~ Description for raspberry bush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small raspberry bush that's fruitless.  Watch out for its thorns!"
msgstr "Meyvesiz küçük bir ahududu çalısı. Dikenlerine dikkat et!"

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "grape bush"
msgstr "üzüm çalısı"

#. ~ Description for grape bush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A bush of a different species invaded by vines of grapes."
msgstr "Farklı bir türden bir çalı, üzüm asmalarının istilasına uğramış."

#. ~ Description for grape bush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A bush of a different species invaded by grape vines but they're fruitless."
msgstr ""
"Farklı bir türden bir çalı, üzüm asmalarının istilasına uğramış ama "
"meyvesizler."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "rose bush"
msgstr "gül çalısı"

#. ~ Description for rose bush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A fat bush of beautiful red roses, if only you could get a date!  Watch out "
"for its thorns!"
msgstr ""
"Güzel kırmızı güllerle dolu bir çalı, keşke bir randevu ayarlayabilsen! "
"Dikenlerine dikkat et!"

#. ~ Description for rose bush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A fat rose bush that currently has no blooms.  Watch out for its thorns!"
msgstr ""
"Şu anda çiçek açmamış olan dolgun bir gül çalısı. Dikenlerine dikkat et!"

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "hydrangea bush"
msgstr "ortanca çalısı"

#. ~ Description for hydrangea bush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A fat, bush of fragrant blue hydrangeas."
msgstr "Mis kokulu mavi ortancalarla dolu dolgun bir çalı."

#. ~ Description for hydrangea bush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A fat hydrangea bush that currently has no blooms."
msgstr "Şu anda çiçek açmamış olan dolgun bir ortanca çalısı."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "lilac bush"
msgstr "leylak çalısı"

#. ~ Description for lilac bush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A wide, bush of bright pinkish purple lilacs."
msgstr "Parlak pembe-mor leylaklarla dolu geniş bir çalı."

#. ~ Description for lilac bush
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A wide lilac bush that currently has no blooms."
msgstr "Şu anda çiçek açmamış geniş bir leylak çalısı."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "tree trunk"
msgstr "ağaç gövdesi"

#. ~ Description for tree trunk
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A section of trunk from a tree that has been cut down.  Can be sawn into "
"logs with the right tool."
msgstr ""
"Kesilmiş bir ağacın gövde kısmı. Doğru aletle kütüklere dönüştürülebilir."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "sunken tree trunk"
msgstr "batık ağaç gövdesi"

#. ~ Description for sunken tree trunk
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A section of trunk from a tree that has fallen from the shallows above and "
"ended up down here at some point. It's waterlogged and seems to be partially"
" eaten by worms."
msgstr ""
"Sığlıklardan düşmüş ve bir noktada buraya kadar gelmiş bir ağacın gövde "
"kısmı. Suya doymuş ve kısmen kurtlar tarafından yenmiş gibi görünüyor."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "glub."
msgstr "glub."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "tree stump"
msgstr "ağaç kütüğü"

#. ~ Description for tree stump
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A tree stump, remnant of a tree that has been cut down."
msgstr "Kesilmiş bir ağacın kalıntısı olan ağaç kütüğü."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "woodchips"
msgstr "ağaç yongaları"

#. ~ Description for woodchips
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"Small splinters of wood laid out in a layer to prevent unwanted plants from "
"growing."
msgstr ""
"İstenmeyen bitkilerin büyümesini önlemek için bir katman halinde serilmiş "
"küçük ahşap kıymıkları."

#: data/json/furniture_and_terrain/terrain-flora.json
#: data/json/items/comestibles/other.json
msgid "grass"
msgid_plural "grasses"
msgstr[0] "çim"
msgstr[1] "çimler"

#. ~ Description for grass
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"An area of hardy Kentucky bluegrass about ankle high.  Cutting the grass "
"short enough would destroy the root system, causing this area to turn into a"
" patch of dirt."
msgstr ""
"Bilek boyunda dayanıklı Kentucky mavi çimi alanı. Çimi yeterince kısa kesmek"
" kök sistemini yok eder ve bu alanın toprak yamasına dönüşmesine neden olur."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "white grass"
msgstr "beyaz çim"

#. ~ Description for white grass
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A section of Kentucky bluegrass covered in white latex-based paint, with "
"neat lines designed for recreational sports."
msgstr ""
"Beyaz lateks bazlı boya ile kaplanmış, rekreasyonel sporlar için tasarlanmış"
" düzgün çizgilere sahip bir Kentucky mavi çimi bölümü."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "long grass"
msgstr "uzun çim"

#. ~ Description for long grass
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "Long shaggy grass about shin high."
msgstr "Diz boyunda uzun, dağınık çim."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "tall grass"
msgstr "yüksek çim"

#. ~ Description for tall grass
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "Tall grass about head high."
msgstr "Baş boyunda yüksek çim."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "dead grass"
msgstr "ölü çim"

#. ~ Description for dead grass
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "Long shaggy grass that hasn't been cut recently."
msgstr "Son zamanlarda kesilmemiş uzun, dağınık çim."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "golf green"
msgstr "golf sahası"

#. ~ Description for golf green
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "Grass mowed very short and neat."
msgstr "Çok kısa ve düzgün biçimde biçilmiş çimen."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "golf hole"
msgstr "golf deliği"

#. ~ Description for golf hole
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small plastic cup embedded in the grass."
msgstr "Çimlerin içine yerleştirilmiş küçük bir plastik kupa."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "fern"
msgstr "eğrelti otu"

#. ~ Description for fern
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A short plant with thousands of leaves which grow in a fractal pattern from "
"the stem."
msgstr ""
"Gövdesinden fraktal bir desenle büyüyen binlerce yaprağı olan kısa bir "
"bitki."

#. ~ Description for fern
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A short plant with thousands leaves which grow in a fractal pattern, without"
" any curled shoots."
msgstr ""
"Gövdesinden fraktal bir desenle büyüyen binlerce yaprağı olan kısa bir "
"bitki, kıvrık filizler olmadan."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "cacao tree"
msgstr "kakao ağacı"

#. ~ Description for cacao tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A thick tree belonging to the 'Theobroma' genus, native to Central and South"
" America, that has been genetically engineered to withstand New England's "
"four seasons.  If you examined the trunk of the tree, you could probably "
"find some mature cacao pods.  Even in the face of apocalypse, you can't give"
" up chocolate, of course.  You could cut it down with the right tools."
msgstr ""
"Orta ve Güney Amerika'ya özgü, 'Theobroma' cinsine ait kalın bir ağaç, New "
"England'ın dört mevsimine dayanacak şekilde genetik olarak tasarlanmıştır. "
"Ağacın gövdesini incelerseniz, muhtemelen bazı olgun kakao kabukları "
"bulabilirsiniz. Kıyamet karşısında bile çikolatadan vazgeçemezsiniz, tabii "
"ki. Doğru aletlerle kesebilirsiniz."

#. ~ Description for cacao tree
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A thick tree belonging to the 'Theobroma' genus, native to Central and South"
" America, that has been genetically engineered to withstand New England's "
"four seasons.  Looks like all the ripe cacao pods have been picked.  You "
"could cut it down with the right tools."
msgstr ""
"Orta ve Güney Amerika'ya özgü, 'Theobroma' cinsine ait kalın bir ağaç, New "
"England'ın dört mevsimine dayanacak şekilde genetik olarak tasarlanmıştır. "
"Görünüşe göre tüm olgun kakao kabukları toplanmış. Doğru aletlerle "
"kesebilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "coca plant"
msgstr "koka bitkisi"

#. ~ Description for coca plant
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A tree native to South America, coca leaves have been used as medicine, "
"tonic, and tea for thousands of years.  It was modified to withstand New "
"England weather for medical research, only to be accidentally introduced to "
"the wild.  If you examined the trunk of the tree, you could probably find "
"some mature coca leaves."
msgstr ""
"Güney Amerika'ya özgü bir ağaç olan koka yaprakları binlerce yıldır ilaç, "
"tonik ve çay olarak kullanılmaktadır. Tıbbi araştırmalar için New England "
"havasına dayanacak şekilde değiştirildi, ancak kazara doğaya yayıldı. Ağacın"
" gövdesini incelerseniz, muhtemelen olgun koka yaprakları bulabilirsiniz."

#: data/json/furniture_and_terrain/terrain-flora.json
msgid "harvested coca plant"
msgstr "hasat edilmiş koka bitkisi"

#. ~ Description for harvested coca plant
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A tree native to South America, coca leaves have been used as medicine, "
"tonic, and tea for thousands of years.  Looks like all the coca leaves have "
"been picked."
msgstr ""
"Güney Amerika'ya özgü bir ağaç olan koka yaprakları binlerce yıldır ilaç, "
"tonik ve çay olarak kullanılmaktadır. Görünüşe göre tüm koka yaprakları "
"toplanmış."

#: data/json/furniture_and_terrain/terrain-fungal.json
#: data/mods/No_Fungi/terrain.json
msgid "marloss bush"
msgstr "marloss çalısı"

#. ~ Description for marloss bush
#: data/json/furniture_and_terrain/terrain-fungal.json
msgid ""
"This alien plant superficially resembles a blueberry bush, and hangs with "
"large, juicy pink pomes that emit a heady, fruity aroma."
msgstr ""
"Bu yabancı bitki, yüzeysel olarak bir yaban mersini çalısına benzer ve baş "
"döndürücü, meyvemsi bir aroma yayan büyük, sulu pembe meyvelerle doludur."

#: data/json/furniture_and_terrain/terrain-fungal.json
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "poof!"
msgstr "puf!"

#: data/json/furniture_and_terrain/terrain-fungal.json
msgid "fungal bed"
msgstr "mantar yatağı"

#. ~ Description for fungal bed
#: data/json/furniture_and_terrain/terrain-fungal.json
msgid "Fungus grows thick here, obscuring the ground beneath it."
msgstr "Burada mantar kalın bir şekilde büyüyor ve altındaki zemini gizliyor."

#: data/json/furniture_and_terrain/terrain-fungal.json
msgid "fungal floor"
msgstr "mantar zemini"

#. ~ Description for fungal floor
#: data/json/furniture_and_terrain/terrain-fungal.json
msgid ""
"Grayish mold coats both the floor and the roof here, silent and still.  "
"Stray spores waft through the air."
msgstr ""
"Burada hem zemini hem de tavanı gri küf kaplamış, sessiz ve hareketsiz. "
"Havada dolaşan rastgele sporlar var."

#. ~ Description for fungal floor
#: data/json/furniture_and_terrain/terrain-fungal.json
msgid "Grayish mold coats the floor here, silent and still."
msgstr "Burada zemin gri küf ile kaplanmış, sessiz ve hareketsiz."

#. ~ Description for fungal floor
#: data/json/furniture_and_terrain/terrain-fungal.json
msgid "Grayish mold coats the ground here, silent and still."
msgstr "Burada yer gri küf ile kaplanmış, sessiz ve hareketsiz."

#: data/json/furniture_and_terrain/terrain-fungal.json
#: data/json/monsters/fungus.json data/mods/Limit Fungal Growth/modinfo.json
msgid "fungal wall"
msgid_plural "fungal walls"
msgstr[0] "mantar duvar"
msgstr[1] "mantar duvarlar"

#. ~ Description for fungal wall
#: data/json/furniture_and_terrain/terrain-fungal.json
msgid ""
"Several thick, large tendrils of fungus perforate the wall here, piercing "
"straight through it from the outside.  Despite the apparent damage, the wall"
" is still structurally sound."
msgstr ""
"Burada birkaç kalın, büyük mantar filizi duvarı delip dışarıdan içeriye "
"doğru geçiyor. Görünür hasara rağmen, duvar hala yapısal olarak sağlam."

#. ~ Description for fungal wall
#: data/json/furniture_and_terrain/terrain-fungal.json
msgid ""
"The fungus here has grown thickly and tightly enough to form a solid wall.  "
"It feels very stiff to the touch, and seems to be very strong."
msgstr ""
"Buradaki mantar o kadar kalın ve sık büyümüş ki sağlam bir duvar oluşturmuş."
" Dokunulduğunda çok sert hissediliyor ve oldukça güçlü görünüyor."

#: data/json/furniture_and_terrain/terrain-fungal.json
msgid "fungal mound"
msgstr "mantar yığını"

#. ~ Description for fungal mound
#: data/json/furniture_and_terrain/terrain-fungal.json
msgid "A mound of fungal matter, intertwined in itself."
msgstr "Kendi içine dolanmış bir mantar maddesi yığını."

#: data/json/furniture_and_terrain/terrain-fungal.json
msgid "fungal shrub"
msgstr "mantar çalı"

#. ~ Description for fungal shrub
#: data/json/furniture_and_terrain/terrain-fungal.json
msgid ""
"This shrub has been completely absorbed by the mushrooms.  Its branches "
"droop and have lost much of their structure, and its leaves have vanished, "
"replaced by fleshy gray sacks that visibly expand and contract."
msgstr ""
"Bu çalı tamamen mantarlar tarafından emilmiş. Dalları sarkmış ve yapısının "
"çoğunu kaybetmiş, yaprakları kaybolmuş ve yerini gözle görülür şekilde "
"genişleyip daralan etli gri keseler almış."

#: data/json/furniture_and_terrain/terrain-fungal.json
msgid "fungal tree"
msgstr "mantar ağaç"

#. ~ Description for fungal tree
#: data/json/furniture_and_terrain/terrain-fungal.json
msgid ""
"Once tall and majestic, this tree is now a slave to the fungus like the "
"landscape around it.  Its bark is penetrated by and covered with fungal "
"tendrils, and the canopy has rotted away, leaving only the branches, "
"stretching forlornly to the sky as if to escape the infection overrunning "
"it."
msgstr ""
"Bir zamanlar uzun ve heybetli olan bu ağaç, şimdi etrafındaki manzara gibi "
"mantarın kölesi haline gelmiş. Kabuğu mantar iplikçikleri tarafından "
"delinmiş ve kaplanmış, gölgesi ise çürümüş, sadece dallar kalmış, "
"enfeksiyondan kaçmak istercesine gökyüzüne uzanıyor."

#: data/json/furniture_and_terrain/terrain-fungal.json
msgid "young fungal tree"
msgstr "genç mantar ağacı"

#. ~ Description for young fungal tree
#: data/json/furniture_and_terrain/terrain-fungal.json
msgid "A small sapling poking through the ground, infested by fungal mold."
msgstr "Yerden çıkan küçük bir fidan, mantar küfü tarafından istila edilmiş."

#: data/json/furniture_and_terrain/terrain-fungal.json
#: data/mods/No_Fungi/terrain.json
msgid "marloss tree"
msgstr "marloss ağacı"

#. ~ Description for marloss tree
#: data/json/furniture_and_terrain/terrain-fungal.json
msgid ""
"This tree stands as a stark outlier to the landscape around it.  Despite its"
" infestation, its leaves wave proudly in the wind, colored pinkish-white.  "
"Its branches are heavy with pink fruit that looks both mutated and "
"delicious."
msgstr ""
"Bu ağaç, etrafındaki manzaraya keskin bir zıtlık oluşturuyor. Enfeksiyonuna "
"rağmen, yaprakları rüzgarda gururla dalgalanıyor, pembemsi-beyaz renkte. "
"Dalları, hem mutasyona uğramış hem de lezzetli görünen pembe meyvelerle "
"dolu."

#: data/json/furniture_and_terrain/terrain-liquids.json
msgid "shallow water"
msgstr "sığ su"

#. ~ Description for shallow water
#: data/json/furniture_and_terrain/terrain-liquids.json
msgid ""
"The water isn't too deep here.  With a watertight container, you could "
"gather fresh water from here.  Not safe to drink as is."
msgstr ""
"Buradaki su çok derin değil. Su geçirmez bir kapla buradan taze su "
"toplayabilirsiniz. Olduğu gibi içmek güvenli değil."

#: data/json/furniture_and_terrain/terrain-liquids.json
msgid "deep water"
msgstr "derin su"

#. ~ Description for deep water
#: data/json/furniture_and_terrain/terrain-liquids.json
msgid ""
"You're having trouble seeing the bottom through the deep water here.  With a"
" watertight container, you could gather fresh water from here.  Not safe to "
"drink as is."
msgstr ""
"Buradaki derin suyun dibini görmekte zorlanıyorsunuz. Su geçirmez bir kapla "
"buradan taze su toplayabilirsiniz. Olduğu gibi içmek güvenli değil."

#: data/json/furniture_and_terrain/terrain-liquids.json
msgid "murky shallow water"
msgstr "bulanık sığ su"

#. ~ Description for murky shallow water
#: data/json/furniture_and_terrain/terrain-liquids.json
msgid ""
"The water isn't too deep here but is murky with organic matter.  With a "
"watertight container, you could gather fetid water from here.  Not safe to "
"drink as is."
msgstr ""
"Su burada çok derin değil ama organik maddeyle bulanık. Su geçirmez bir "
"kapla buradan pis su toplayabilirsiniz. Olduğu gibi içmek güvenli değil."

#. ~ Description for murky shallow water
#: data/json/furniture_and_terrain/terrain-liquids.json
msgid ""
"The water isn't too deep here but it is murky with organic matter.  With a "
"watertight container, you could gather fetid water from here.  Not safe to "
"drink as is."
msgstr ""
"Su burada çok derin değil ama organik maddeyle bulanık. Su geçirmez bir "
"kapla buradan pis su toplayabilirsiniz. Olduğu gibi içmek güvenli değil."

#: data/json/furniture_and_terrain/terrain-liquids.json
msgid "flowing shallow water"
msgstr "akan sığ su"

#. ~ Description for flowing shallow water
#: data/json/furniture_and_terrain/terrain-liquids.json
msgid ""
"The streaming water isn't too deep here.  With a watertight container, you "
"could gather fresh water from here.  Not safe to drink as is, although "
"probably safer than stagnant water."
msgstr ""
"Akan su burada çok derin değil. Su geçirmez bir kapla buradan taze su "
"toplayabilirsiniz. Olduğu gibi içmek güvenli değil, ancak muhtemelen durgun "
"sudan daha güvenli."

#: data/json/furniture_and_terrain/terrain-liquids.json
msgid "flowing deep water"
msgstr "akan derin su"

#. ~ Description for flowing deep water
#: data/json/furniture_and_terrain/terrain-liquids.json
msgid ""
"The streaming water looks deep here.  With a watertight container, you could"
" gather fresh water from here.  Not safe to drink as is, although probably "
"safer than stagnant water."
msgstr ""
"Akan su burada derin görünüyor. Su geçirmez bir kapla buradan taze su "
"toplayabilirsiniz. Olduğu gibi içmek güvenli değil, ancak muhtemelen durgun "
"sudan daha güvenli."

#. ~ Description for shallow water
#: data/json/furniture_and_terrain/terrain-liquids.json
msgid ""
"The water isn't too deep here.  With a watertight container, you could "
"gather salt water from here."
msgstr ""
"Su burada çok derin değil. Su geçirmez bir kapla buradan tuzlu su "
"toplayabilirsiniz."

#. ~ Description for deep water
#: data/json/furniture_and_terrain/terrain-liquids.json
msgid ""
"You're having trouble seeing the bottom through the deep water here.  With a"
" watertight container, you could gather salt water from here."
msgstr ""
"Buradaki derin suyun dibini görmekte zorlanıyorsunuz. Su geçirmez bir kapla "
"buradan tuzlu su toplayabilirsiniz."

#: data/json/furniture_and_terrain/terrain-liquids.json
msgid "pool water"
msgstr "havuz suyu"

#. ~ Description for pool water
#: data/json/furniture_and_terrain/terrain-liquids.json
msgid ""
"A deep pool full of water.  Never swim without a lifeguard present.  Even "
"though monsters probably ate them."
msgstr ""
"Su dolu derin bir havuz. Can kurtaran olmadan asla yüzmeyin. Muhtemelen "
"canavarlar onları yemiş olsa da."

#: data/json/furniture_and_terrain/terrain-liquids.json
msgid "shallow pool water"
msgstr "sığ havuz suyu"

#. ~ Description for shallow pool water
#: data/json/furniture_and_terrain/terrain-liquids.json
msgid "A shallow pool of water."
msgstr "Sığ bir su havuzu."

#: data/json/furniture_and_terrain/terrain-liquids.json
msgid "sewage"
msgstr "kanalizasyon"

#. ~ Description for sewage
#: data/json/furniture_and_terrain/terrain-liquids.json
msgid ""
"Gross.  Sewage water flows through here.  As if it needed saying, this isn't"
" safe to drink."
msgstr ""
"İğrenç. Buradan kanalizasyon suyu akıyor. Söylemeye gerek yok, bu su içmek "
"için güvenli değil."

#. ~ Description for lava
#: data/json/furniture_and_terrain/terrain-liquids.json
msgid ""
"An extremely hot, glowing liquid, composed of molten rock and/or metal.  In "
"some places, lava-grilled steak is a delicacy."
msgstr ""
"Aşırı sıcak, parlayan bir sıvı, erimiş kaya ve/veya metalden oluşur. Bazı "
"yerlerde lavda ızgara edilmiş biftek bir lezzet olarak kabul edilir."

#: data/json/furniture_and_terrain/terrain-liquids.json
msgid "submersed water"
msgstr "su altında kalmış"

#. ~ Description for submersed water
#: data/json/furniture_and_terrain/terrain-liquids.json
msgid ""
"You are submerged below the surface of the water, your feet can't touch the "
"ground.  With a watertight container, you could gather fresh water from "
"here.  Not safe to drink as is."
msgstr ""
"Suyun yüzeyinin altına dalmışsınız, ayaklarınız yere değmiyor. Su geçirmez "
"bir kapla buradan taze su toplayabilirsiniz. Olduğu gibi içmek güvenli "
"değil."

#: data/json/furniture_and_terrain/terrain-liquids.json
msgid "lake bed"
msgstr "göl yatağı"

#. ~ Description for lake bed
#: data/json/furniture_and_terrain/terrain-liquids.json
msgid ""
"You are standing at the bottom of a body of fresh water.  With a watertight "
"container, you could gather fresh water from here.  Not safe to drink as is."
msgstr ""
"Tatlı su kütlesinin dibinde duruyorsunuz. Su geçirmez bir kapla buradan taze"
" su toplayabilirsiniz. Olduğu gibi içmek güvenli değil."

#: data/json/furniture_and_terrain/terrain-liquids.json
msgid "water moss"
msgstr "su yosunu"

#. ~ Description for water moss
#: data/json/furniture_and_terrain/terrain-liquids.json
msgid "Moist spongy water moss."
msgstr "Nemli süngerimsi su yosunu."

#: data/json/furniture_and_terrain/terrain-liquids.json
msgid "ocean bed"
msgstr "okyanus tabanı"

#. ~ Description for ocean bed
#: data/json/furniture_and_terrain/terrain-liquids.json
msgid ""
"You are standing at the bottom of a body of salt water.  With a watertight "
"container, you could gather salt water from here.  Not safe to drink as is."
msgstr ""
"Tuzlu su kütlesinin dibinde duruyorsunuz. Su geçirmez bir kapla buradan "
"tuzlu su toplayabilirsiniz. Olduğu gibi içmek güvenli değil."

#: data/json/furniture_and_terrain/terrain-liquids.json
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "bulkhead"
msgstr "perde duvar"

#. ~ Description for bulkhead
#: data/json/furniture_and_terrain/terrain-liquids.json
msgid ""
"The top of a submerged structure.  With a watertight container, you could "
"gather fresh water from here.  Not safe to drink as is."
msgstr ""
"Su altında kalmış bir yapının üstü. Su geçirmez bir kapla buradan tatlı su "
"toplayabilirsiniz. Olduğu gibi içmek güvenli değil."

#. ~ Description for bulkhead
#: data/json/furniture_and_terrain/terrain-liquids.json
msgid ""
"The interior of a submerged structure.  At least this part hasn't flooded "
"yet."
msgstr ""
"Su altında kalmış bir yapının içi. En azından bu kısım henüz su almamış."

#: data/json/furniture_and_terrain/terrain-liquids.json
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "underwater bulkhead"
msgstr "su altı perde duvarı"

#. ~ Description for underwater bulkhead
#: data/json/furniture_and_terrain/terrain-liquids.json
msgid "The interior of a submerged structure.  This part has been flooded."
msgstr "Su altında kalmış bir yapının içi. Bu kısım su almış."

#: data/json/furniture_and_terrain/terrain-liquids.json
msgid "submerged concrete"
msgstr "su altında kalmış beton"

#. ~ Description for submerged concrete
#: data/json/furniture_and_terrain/terrain-liquids.json
msgid ""
"You are standing at the bottom of a body of fresh water on a pad of "
"concrete.  With a watertight container, you could gather fresh water from "
"here.  Not safe to drink as is."
msgstr ""
"Tatlı su kütlesinin dibinde, beton bir zemin üzerinde duruyorsunuz. Su "
"geçirmez bir kapla buradan tatlı su toplayabilirsiniz. Olduğu gibi içmek "
"güvenli değil."

#. ~ Description for submerged concrete
#: data/json/furniture_and_terrain/terrain-liquids.json
msgid ""
"You are standing at the bottom of a body of fresh water on a pad of concrete"
" with yelllow paint.  With a watertight container, you could gather fresh "
"water from here.  Not safe to drink as is."
msgstr ""
"Sarı boyalı bir beton zemin üzerinde tatlı suyun dibinde duruyorsunuz. Su "
"geçirmez bir kap ile buradan tatlı su toplayabilirsiniz. Olduğu gibi içmek "
"güvenli değil."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "gasoline pump"
msgstr "benzin pompası"

#. ~ Description for gasoline pump
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"Precious GASOLINE.  The former world bowed to their petroleum god as it led "
"them to their ruin.  There's plenty left over to fuel your inner road "
"warrior.  If this gas dispenser doesn't give up the goods for free, you may "
"have to pay at a nearby terminal."
msgstr ""
"Değerli BENZİN. Eski dünya, onları felaketlerine götüren petrol tanrılarına "
"boyun eğdi. İçinizdeki yol savaşçısını beslemek için bolca var. Bu benzin "
"dağıtıcısı size bedavadan mal vermiyorsa, yakındaki bir terminalde ödeme "
"yapmanız gerekebilir."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "fuel tank"
msgstr "yakıt tankı"

#. ~ Description for fuel tank
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "A tank filled with gasoline."
msgstr "Benzinle dolu bir tank."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "broken fuel tank"
msgstr "kırık yakıt tankı"

#. ~ Description for broken fuel tank
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "A broken tank which was filled with gasoline."
msgstr "Benzinle dolu olan kırık bir tank."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "smashed gas pump"
msgstr "kırılmış benzin pompası"

#. ~ Description for smashed gas pump
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"The horror!  This gasoline pump has been destroyed, denying you access to "
"the liquid gold."
msgstr ""
"Dehşet! Bu benzin pompası yok edilmiş, sizi sıvı altına erişimden mahrum "
"bırakıyor."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "diesel pump"
msgstr "dizel pompası"

#. ~ Description for diesel pump
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"This is a diesel fuel pump.  This roadside attraction provides all the "
"thick, gloopy liquid POWER you need to move your sensibly oversized "
"APOCOLYPTIC SUPERTRUCK from point A to points beyond.  If it doesn't "
"dispense fuel immediately, try banging on it or grunt your way over the "
"nearby payment terminal."
msgstr ""
"Bu bir dizel yakıt pompası. Bu yol kenarı cazibe merkezi, mantıklı bir "
"şekilde aşırı büyük KIYAMET SÜPER KAMYONUNUZU A noktasından ötesine taşımak "
"için ihtiyaç duyduğunuz tüm kalın, yapışkan sıvı GÜCÜ sağlar. Eğer hemen "
"yakıt vermezse, üzerine vurmayı deneyin veya yakındaki ödeme terminaline "
"doğru homurdanarak gidin."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "smashed diesel pump"
msgstr "kırılmış dizel pompası"

#. ~ Description for smashed diesel pump
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"You're not getting any diesel out of this pump any time soon.  Some "
"barbarian decided to take their frustration out on it."
msgstr ""
"Bu pompadan yakın zamanda dizel alamayacaksınız. Bir barbar, sinirini bu "
"pompadan çıkarmaya karar vermiş."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "ATM"
msgstr "ATM"

#. ~ Description for ATM
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"For your banking convenience, this Automated Teller Machine is fully capable"
" of operating autonomously in the event of complete network failure.  You "
"can deposit funds from cash cards and migrate all of your inflation-adjusted"
" earnings to a single card.  These things have seen better days.  There's "
"been a run on the bank, and this machine has the dents and cracks to prove "
"it."
msgstr ""
"Bankacılık kolaylığınız için, bu Otomatik Vezne Makinesi, tam ağ arızası "
"durumunda bile tamamen otonom olarak çalışabilme kapasitesine sahiptir. "
"Nakit kartlarından para yatırabilir ve enflasyona göre ayarlanmış tüm "
"kazançlarınızı tek bir karta aktarabilirsiniz. Bu makineler daha iyi günler "
"gördü. Bankada bir hücum olmuş ve bu makine üzerindeki ezikler ve çatlaklar "
"bunu kanıtlıyor."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "Critical failure imminent, self destruct activated.  Have a nice day!"
msgstr "Kritik arıza yakın, kendini imha etme etkinleştirildi. İyi günler!"

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "ticket vendor"
msgstr "bilet satıcısı"

#. ~ Description for ticket vendor
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"This machine has a little screen, and slots intended to take your money and "
"provide you with a ticket."
msgstr ""
"Bu makinenin küçük bir ekranı var ve paranızı alıp size bir bilet sağlaması "
"için yuvaları bulunuyor."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "ticket machine"
msgstr "bilet makinesi"

#. ~ Description for ticket machine
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"This machine will provide you access to whatever is beyond it - for the "
"price of a ticket, of course."
msgstr ""
"Bu makine, elbette bir bilet karşılığında, ötesinde ne varsa ona erişim "
"sağlayacak."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "ventilation shutters"
msgstr "havalandırma panjurları"

#. ~ Description for ventilation shutters
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"A large wall mounted panel, covered fragile metal sheets that regulate "
"airflow."
msgstr ""
"Hava akışını düzenleyen, kırılgan metal levhalarla kaplı büyük bir duvara "
"monte panel."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "broken generator"
msgstr "bozuk jeneratör"

#. ~ Description for broken generator
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"This generator is broken and will not help you produce usable electricity."
msgstr ""
"Bu jeneratör bozuk ve size kullanılabilir elektrik üretiminde yardımcı "
"olmayacak."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "missile"
msgstr "füze"

#. ~ Description for missile
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"This is a section of an ICBM, an Intercontinental Ballistic Missile.  This "
"isn't the kind of rocket that goes to the moon."
msgstr ""
"Bu, bir Kıtalararası Balistik Füze (ICBM) bölümüdür. Bu, aya giden türden "
"bir roket değil."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "blown-out missile"
msgstr "patlamış füze"

#. ~ Description for blown-out missile
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"This is a section of an ICBM, an Intercontinental Ballistic Missile.  This "
"isn't the kind of rocket that's going anywhere."
msgstr ""
"Bu, bir Kıtalararası Balistik Füze (ICBM) bölümüdür. Bu, hiçbir yere "
"gitmeyen türden bir roket."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#: data/json/overmap/overmap_terrain/overmap_terrain.json
#: data/json/overmap/overmap_terrain/overmap_terrain_military.json
#: data/mods/alt_map_key/overmap_terrain.json
msgid "radio tower"
msgstr "radyo kulesi"

#. ~ Description for radio tower
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "This is the structure of a radio transmission tower."
msgstr "Bu, bir radyo iletim kulesinin yapısıdır."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "radio controls"
msgstr "radyo kontrolleri"

#. ~ Description for radio controls
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"This console appears to control a nearby radio transmission tower.  It "
"doesn't seem to be fully operational."
msgstr ""
"Bu konsol, yakındaki bir radyo iletim kulesini kontrol ediyor gibi "
"görünüyor. Tam olarak çalışır durumda değil."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "high gauge pipe"
msgstr "yüksek kalibre boru"

#. ~ Description for high gauge pipe
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "This is a section of high gauge pipe."
msgstr "Bu, yüksek kalibre bir boru bölümüdür."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "high gauge pump"
msgstr "yüksek kalibre pompa"

#. ~ Description for high gauge pump
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"This unpowered pump previously would have moved fluids around in a hurry."
msgstr "Bu güçsüz pompa, daha önce sıvıları hızla hareket ettirirdi."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "CVD machine"
msgstr "CVD makinesi"

#. ~ Description for CVD machine
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"The bulk of a highly technical-looking apparatus controlled by a nearby "
"console."
msgstr ""
"Yakındaki bir konsol tarafından kontrol edilen, oldukça teknik görünen bir "
"cihazın büyük kısmı."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "CVD control panel"
msgstr "CVD kontrol paneli"

#. ~ Description for CVD control panel
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"This is a VERY expensive-looking apparatus that's labeled 'Chemical Vapor "
"Deposition Machine'.  With the input of certain exceptionally rare chemicals"
" and elements, one could conceivably coat one's weapon with diamond.  While "
"the process is extremely complicated, a previous user has helpfully "
"sketched: Hydrogen + charcoal = smiley face."
msgstr ""
"Bu, 'Kimyasal Buhar Biriktirme Makinesi' olarak etiketlenmiş, ÇOK pahalı "
"görünen bir cihaz. Belirli son derece nadir kimyasallar ve elementlerin "
"girişi ile, birinin silahını elmasla kaplaması düşünülebilir. Süreç son "
"derece karmaşık olsa da, önceki bir kullanıcı yardımcı olarak şunu çizmiş: "
"Hidrojen + kömür = gülen yüz."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "nanofabricator"
msgstr "nanofabrikatör"

#. ~ Description for nanofabricator
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"A great column of advanced machinery.  Within this self-contained, "
"miniaturized factory, several 3d printers work in tandem with a robotic "
"assembler to manufacture nearly any inorganic object."
msgstr ""
"Gelişmiş makinelerden oluşan büyük bir sütun. Bu kendi kendine yeten, mini "
"fabrikada, birkaç 3D yazıcı, neredeyse her türlü inorganik nesneyi üretmek "
"için bir robotik montajcı ile birlikte çalışır."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "nanofabricator control panel"
msgstr "nanofabrikatör kontrol paneli"

#. ~ Description for nanofabricator control panel
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"A small computer panel attached to a nanofabricator.  It has a single slot "
"for reading templates."
msgstr ""
"Nanofabrikatöre bağlı küçük bir bilgisayar paneli. Şablonları okumak için "
"tek bir yuvası vardır."

#. ~ Description for cloning vat
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"A vat full of solution, probably intended to hold growing clones of people "
"or other life forms."
msgstr ""
"Muhtemelen insan veya diğer yaşam formlarının klonlarını büyütmek için "
"tasarlanmış bir çözelti dolu tank."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "slot machine"
msgstr "slot makinesi"

#. ~ Description for slot machine
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"A machine with a bright screen flashing hypnotic promises of wealth.  If "
"gambling with your life on a daily basis isn't enough for you, you can also "
"gamble with this."
msgstr ""
"Parlak ekranı zenginlik vaatleriyle hipnotize eden bir makine. Eğer günlük "
"hayatınızda risk almak yetmiyorsa, bununla da kumar oynayabilirsiniz."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "water pump"
msgstr "su pompası"

#. ~ Description for water pump
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"Deep well collecting ground water.  Installed water pump allows to draw "
"water from it."
msgstr ""
"Yeraltı suyunu toplayan derin kuyu. Kurulu su pompası, sudan çekilmesini "
"sağlar."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#: data/json/items/furniture.json data/json/vehicleparts/power.json
msgid "plutonium generator"
msgid_plural "plutonium generators"
msgstr[0] "plütonyum jeneratörü"
msgstr[1] "plütonyum jeneratörleri"

#. ~ Description for plutonium generator
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"This imposing apparatus harnesses the power of the atom, configured to "
"provide nearly limitless backup power from the nuclear fuel installed in it."
"  It's not doing much good here though.  It has a complicated security "
"system that is dangerous and difficult to bypass without authorization; a "
"small slot suggests that it can accept some form of ID card."
msgstr ""
"Bu etkileyici cihaz, içine yerleştirilen nükleer yakıttan neredeyse sınırsız"
" yedek güç sağlamak üzere yapılandırılmış atomun gücünü kullanır. Ancak "
"burada pek işe yaramıyor. Yetki olmadan aşılması tehlikeli ve zor olan "
"karmaşık bir güvenlik sistemine sahiptir; küçük bir yuva, bir tür kimlik "
"kartı kabul edebileceğini gösteriyor."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "telecom cabinet"
msgstr "telekom dolabı"

#. ~ Description for telecom cabinet
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"A cabinet full of telecoms equipment.  With the lines down, you might be "
"able to take it apart for its useful electronics."
msgstr ""
"Telekom ekipmanlarıyla dolu bir dolap. Hatlar kesildiğinde, faydalı "
"elektronik parçalarını sökebilirsin."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "damaged telecom cabinet"
msgstr "hasarlı telekom dolabı"

#. ~ Description for damaged telecom cabinet
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"A damaged telecoms cabinet.  Might still be able to salvage some useful "
"electronics scrap from it."
msgstr ""
"Hasarlı bir telekom dolabı. Hâlâ işe yarar bazı elektronik hurdaları "
"kurtarabilirsin."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "HV oil circuit breaker"
msgstr "HV yağ devre kesici"

#. ~ Description for HV oil circuit breaker
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "A circuit breaker that uses oil in its arc suppression chamber."
msgstr "Ark bastırma odasında yağ kullanan bir devre kesici."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "pow!"
msgstr "pat!"

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "small HV oil circuit breaker"
msgstr "küçük HV yağ devre kesici"

#. ~ Description for small HV oil circuit breaker
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "A small circuit breaker that uses oil in its arc suppression chamber."
msgstr "Ark bastırma odasında yağ kullanan küçük bir devre kesici."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "large switchgear"
msgstr "büyük şalt cihazı"

#. ~ Description for large switchgear
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"A switchgear panel.  It's covered in breaker switches, fuses, and gauges."
msgstr ""
"Bir şalt paneli. Kesici anahtarlar, sigortalar ve göstergelerle kaplı."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "small switchgear"
msgstr "küçük şalt"

#. ~ Description for small switchgear
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"A small switchgear panel.  It's covered in breaker switches, fuses, and "
"gauges."
msgstr ""
"Küçük bir şalt paneli. Kesici anahtarlar, sigortalar ve göstergelerle kaplı."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "lightning arrester"
msgstr "yıldırım tutucu"

#. ~ Description for lightning arrester
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"A component designed to protect insulation and conductors in an electrical "
"system by directing lightning through itself and into the ground."
msgstr ""
"Bir elektrik sistemindeki yalıtımı ve iletkenleri korumak için yıldırımı "
"kendisi üzerinden geçirip toprağa yönlendiren bir bileşen."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "disconnect switch"
msgstr "ayırıcı anahtar"

#. ~ Description for disconnect switch
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"A switch used to make sure an electrical system doesn't have any current "
"flowing through it, for maintenance periods."
msgstr ""
"Bakım dönemlerinde bir elektrik sisteminde akım akmadığından emin olmak için"
" kullanılan bir anahtar."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "current transformer"
msgstr "akım transformatörü"

#. ~ Description for current transformer
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "An electronic component used to transform the voltage of a current."
msgstr ""
"Bir akımın voltajını dönüştürmek için kullanılan elektronik bir bileşen."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "potential transformer"
msgstr "potansiyel transformatörü"

#. ~ Description for potential transformer
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "A specialized type of electrical transformer, "
msgstr "Özel bir tür elektrik transformatörü,"

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "conveyor belt"
msgstr "konveyör bant"

#. ~ Description for conveyor belt
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "A conveyor belt.  Used to transport things."
msgstr "Bir konveyör bant. Eşyaları taşımak için kullanılır."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "light machinery"
msgstr "hafif makineler"

#. ~ Description for light machinery
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "Assorted light machinery.  You could scavenge it for parts."
msgstr "Çeşitli hafif makineler. Parçalarını toplamak için kullanılabilir."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "heavy machinery"
msgstr "ağır makineler"

#. ~ Description for heavy machinery
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "Assorted heavy machinery.  You could scavenge it for parts."
msgstr "Çeşitli ağır makineler. Parçalarını toplamak için kullanılabilir."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "old machinery"
msgstr "eski makineler"

#. ~ Description for old machinery
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "Assorted old machinery.  You could scavenge it for parts."
msgstr "Çeşitli eski makineler. Parçalarını toplamak için kullanılabilir."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "electronic machinery"
msgstr "elektronik makineler"

#. ~ Description for electronic machinery
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "Assorted electronic machinery.  You could scavenge it for parts."
msgstr "Çeşitli elektronik makineler. Parçalar için yağmalayabilirsiniz."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "milking machine"
msgstr "sağım makinesi"

#. ~ Description for milking machine
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "A machine used in the dairy industry to milk cows."
msgstr "Süt endüstrisinde inekleri sağmak için kullanılan bir makine."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "bulk tank"
msgstr "büyük tank"

#. ~ Description for bulk tank
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "A heavy, high capacity tank."
msgstr "Ağır, yüksek kapasiteli tank."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "root cellar"
msgstr "kiler"

#. ~ Description for root cellar
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "A cellar dug into the earth for storing food in a cool environment."
msgstr "Yiyecekleri serin bir ortamda saklamak için toprağa kazılmış kiler."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "covered well"
msgstr "kapalı kuyu"

#. ~ Description for covered well
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"Deep well collecting ground water.  Requires a method to draw water from."
msgstr ""
"Yeraltı suyunu toplayan derin kuyu. Suyu çekmek için bir yöntem gerektirir."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "improvised shelter"
msgstr "improvis edilmiş barınak"

#. ~ Description for improvised shelter
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"Improvised shelter providing little bit of protection, that can be used to "
"take refuge from the elements, or conceal you from view."
msgstr ""
"Doğa koşullarından korunmak veya görünmez olmak için kullanılabilecek, az da"
" olsa koruma sağlayan doğaçlama barınak."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "pine lean-to"
msgstr "çam yapraklı sundurma"

#. ~ Description for pine lean-to
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"A small shelter roofed with pine leaves, that can be used to take refuge "
"from the elements."
msgstr ""
"Doğa koşullarından korunmak için kullanılabilecek, çam yapraklarıyla örtülü "
"küçük bir barınak."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "unfinished niter bed"
msgstr "tamamlanmamış güherçile yatağı"

#. ~ Description for unfinished niter bed
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"A wet heap of fertilizer and plant matter covered in soil for traditional "
"saltpeter production.  In about a season, enough potassium nitrate will "
"leach through and crystallize to be harvestable."
msgstr ""
"Geleneksel güherçile üretimi için toprakla kaplanmış ıslak bir gübre ve "
"bitki yığını. Yaklaşık bir mevsim sonra, yeterli miktarda potasyum nitrat "
"sızarak kristalleşecek ve hasat edilebilir hale gelecek."

#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "mature niter bed"
msgstr "olgun güherçile yatağı"

#. ~ Description for mature niter bed
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid ""
"This heap of nitrated compost has leached out and crystallized a bunch of "
"niter.  Dig here to extract it."
msgstr ""
"Bu güherçileli kompost yığını sızarak bir miktar güherçile "
"kristalleştirmiştir. Çıkarmak için burada kazın."

#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "mechanical winch"
msgstr "mekanik vinç"

#. ~ Description for mechanical winch
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a gate control winch.  If it's functioning, it can be used to open "
"or close a nearby gate or door."
msgstr ""
"Bu bir kapı kontrol vinci. Çalışıyorsa, yakındaki bir kapı veya kapıyı açmak"
" veya kapatmak için kullanılabilir."

#. ~ Description for mechanical winch
#. ~ Description for control lever
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a gate control winch.  If it's functioning, it can be used to open "
"or close a nearby gate."
msgstr ""
"Bu bir kapı kontrol vinci. Çalışıyorsa, yakındaki bir kapıyı açmak veya "
"kapatmak için kullanılabilir."

#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "control lever"
msgstr "kontrol kolu"

#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "rope and pulley"
msgstr "halat ve makara"

#. ~ Description for rope and pulley
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "A system of ropes and pulleys that allows to pull up heavy doors."
msgstr ""
"Ağır kapıları yukarı çekmeye olanak tanıyan bir halat ve makara sistemi."

#. ~ Description for rope and pulley
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"A system of ropes and pulleys that allows to pull up heavy doors or gates."
msgstr ""
"Ağır kapıları veya kapıları yukarı çekmeye olanak tanıyan bir halat ve "
"makara sistemi."

#: data/json/furniture_and_terrain/terrain-mechanisms.json
#: data/json/npcs/robofac/NPC_ROBOFAC_INTERCOM.json
msgid "intercom"
msgstr "interkom"

#. ~ Description for intercom
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"An intercom panel.  For when you want to scare the crap out of someone, or "
"just talk to them over the intercom system, if you're boring like that."
msgstr ""
"Bir interkom paneli. Birini korkutmak istediğinizde ya da sadece interkom "
"sistemi üzerinden konuşmak istediğinizde kullanabilirsiniz, eğer bu kadar "
"sıkıcıysanız."

#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "card reader"
msgstr "kart okuyucu"

#. ~ Description for card reader
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a smartcard reader.  It sports the stylized symbol of an atom inside"
" a flask that is universally known to indicate SCIENCE.  An ominous red LED "
"reminds you of a robot gone haywire from an old sci-fi flick.  You could "
"swipe a scientific ID badge near it if you do not fear the machine."
msgstr ""
"Bu bir akıllı kart okuyucu. İçinde bir şişe bulunan atomun stilize edilmiş "
"sembolünü taşır, bu sembol evrensel olarak BİLİM'i belirtir. Kötü bir bilim "
"kurgu filminden fırlamış gibi duran tehditkâr kırmızı LED, sizi bir robotun "
"kontrolden çıkmış haliyle hatırlatır. Makineden korkmuyorsanız, bilimsel bir"
" kimlik kartını yaklaştırabilirsiniz."

#. ~ Description for card reader
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a smartcard reader.  It sports the stylized symbol of an atom inside"
" a flask that is universally known to indicate SCIENCE.  The stark red LED "
"blinks askance at your geek cred.  You could swipe a scientific ID badge "
"near it to unlock the gates to discovery."
msgstr ""
"Bu bir akıllı kart okuyucu. İçinde bir şişe bulunan atomun stilize edilmiş "
"sembolünü taşır, bu sembol evrensel olarak BİLİM'i belirtir. Keskin kırmızı "
"LED, geek itibarınızı sorgularcasına yanıp söner. Keşif kapılarını açmak "
"için bilimsel bir kimlik kartını yaklaştırabilirsiniz."

#. ~ Description for card reader
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a smartcard reader.  The universal symbol of an eagle driving a "
"tank, biting a grenade pin stands rampant in front of an American flag.  A "
"small, red LED remains constant, as if watching you, waiting.  You could "
"swipe a military ID card in front of the reader if you dared."
msgstr ""
"Bu bir akıllı kart okuyucu. Bir tank süren kartalın, Amerikan bayrağı önünde"
" bir el bombası pimi ısırdığı evrensel sembolü öne çıkar. Küçük, kırmızı LED"
" sabit bir şekilde yanar, sizi izliyormuş gibi, bekliyormuş gibi. "
"Cesaretiniz varsa, okuyucunun önüne askeri bir kimlik kartı sürebilirsiniz."

#. ~ Description for card reader
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a smartcard reader.  The symbol of a gear in front of a bulging "
"bicep is emblazoned on the matte black surface with an illegible heavy "
"industrial company title.  A red LED blinks on the card reader.  Perhaps an "
"industrial ID card could still open it."
msgstr ""
"Bu bir akıllı kart okuyucu. Şişkin bir pazı önünde bir dişli sembolü, mat "
"siyah yüzeyde okunaksız ağır sanayi şirketi unvanıyla birlikte işlenmiş. "
"Kart okuyucuda kırmızı bir LED yanıp sönüyor. Belki bir endüstriyel kimlik "
"kartı hala açabilir."

#. ~ Description for card reader
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This looks like the console controlling the security door, there's a pretty "
"big reading surface on it.  You can see \"Fp\" soberly printed above the "
"reader.  You have no idea what could open it."
msgstr ""
"Bu, güvenlik kapısını kontrol eden konsola benziyor, üzerinde oldukça büyük "
"bir okuma yüzeyi var. Okuyucunun üzerinde \"Fp\" ifadesi sade bir şekilde "
"basılmış. Ne ile açılabileceği hakkında hiçbir fikrin yok."

#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "broken card reader"
msgstr "bozuk kart okuyucu"

#. ~ Description for broken card reader
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is a smartcard reader, but it doesn't seem to be functioning.  Probably"
" because there's no more blinking red LED."
msgstr ""
"Bu bir akıllı kart okuyucu, ancak çalışıyor gibi görünmüyor. Muhtemelen "
"kırmızı LED artık yanıp sönmediği için."

#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "elevator controls"
msgstr "asansör kontrolleri"

#. ~ Description for elevator controls
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"This is the control face for an elevator.  You could press the appropriate "
"button to take you to your choice of floor."
msgstr ""
"Bu, bir asansörün kontrol paneli. İstediğiniz kata gitmek için uygun düğmeye"
" basabilirsiniz."

#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "powerless controls"
msgstr "güçsüz kontroller"

#. ~ Description for powerless controls
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "This is the control face for an elevator.  It's currently unpowered."
msgstr "Bu, bir asansörün kontrol paneli. Şu anda güçsüz."

#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "dark pedestal"
msgstr "karanlık kaide"

#. ~ Description for dark pedestal
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"A dark stone pedestal covered in ancient, unintelligible symbols.  Looks "
"ominous."
msgstr ""
"Antik, anlaşılmaz sembollerle kaplı karanlık bir taş kaide. Uğursuz "
"görünüyor."

#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "light pedestal"
msgstr "ışık kaidesi"

#. ~ Description for light pedestal
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "A light stone pedestal covered in ancient, unintelligible symbols."
msgstr "Antik, anlaşılmaz sembollerle kaplı bir ışık taş kaidesi."

#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "yellow switch"
msgstr "sarı düğme"

#. ~ Description for yellow switch
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "A yellow switch.  Should you activate it?"
msgstr "Sarı bir düğme. Onu etkinleştirmeli misiniz?"

#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "cyan switch"
msgstr "camgöbeği düğme"

#. ~ Description for cyan switch
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "A cyan switch.  Should you activate it?"
msgstr "Camgöbeği bir düğme. Onu etkinleştirmeli misiniz?"

#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "purple switch"
msgstr "mor düğme"

#. ~ Description for purple switch
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "A purple switch.  Should you activate it?"
msgstr "Mor bir düğme. Onu etkinleştirmeli misiniz?"

#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "checkered switch"
msgstr "dama desenli düğme"

#. ~ Description for checkered switch
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "A checkered switch.  Should you activate it?"
msgstr "Dama desenli bir düğme. Onu etkinleştirmeli misiniz?"

#: data/json/furniture_and_terrain/terrain-mechanisms.json
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "nuclear reactor core"
msgstr "nükleer reaktör çekirdeği"

#. ~ Description for nuclear reactor core
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"Naval A1B reactor, used in Gerald R. Ford–class aircraft carriers, and can "
"produce enough steam to generate 125 megawatts of energy."
msgstr ""
"Gerald R. Ford sınıfı uçak gemilerinde kullanılan Deniz A1B reaktörü, 125 "
"megavat enerji üretecek kadar buhar üretebilir."

#: data/json/furniture_and_terrain/terrain-migo.json
msgid "resin wall"
msgstr "reçine duvar"

#. ~ Description for resin wall
#: data/json/furniture_and_terrain/terrain-migo.json
msgid ""
"This wall is made of a glistening, nearly opaque, plastic-like substance.  "
"Deep within the material making it up, you can barely see a network of "
"pulsating green conduits, snaking like blood vessels through it.  The "
"material is hard, warm to the touch, and slightly damp."
msgstr ""
"Bu duvar, parlayan, neredeyse opak, plastik benzeri bir maddeden "
"yapılmıştır. İçini oluşturan malzemenin derinliklerinde, kan damarları gibi "
"içinden geçen yeşil, nabız atan bir ağ zar zor görülebilir. Malzeme sert, "
"dokunulduğunda sıcak ve hafif nemlidir."

#: data/json/furniture_and_terrain/terrain-migo.json
msgid "boom!"
msgstr "patlama!"

#: data/json/furniture_and_terrain/terrain-migo.json
msgid "resin cage"
msgstr "reçine kafes"

#. ~ Description for resin cage
#: data/json/furniture_and_terrain/terrain-migo.json
msgid ""
"This resin wall opens into a series of small honeycomb-like hexagons, "
"allowing the passage of air and light.  While still made of the same sturdy "
"material, it is thinner and more delicate in appearance."
msgstr ""
"Bu reçine duvar, hava ve ışığın geçişine izin veren küçük petek benzeri "
"altıgenler serisine açılır. Aynı sağlam malzemeden yapılmış olmasına rağmen,"
" daha ince ve narin bir görünüme sahiptir."

#: data/json/furniture_and_terrain/terrain-migo.json
msgid "resin floor"
msgstr "reçine zemin"

#. ~ Description for resin floor
#: data/json/furniture_and_terrain/terrain-migo.json
msgid ""
"This nearly opaque, plastic-like floor has a gentle curve from wall to wall,"
" but in the central areas is quite flat.  The material is hard, warm to the "
"touch, and slightly damp."
msgstr ""
"Bu neredeyse opak, plastik benzeri zemin, duvardan duvara hafif bir eğriye "
"sahiptir, ancak merkezi alanlarda oldukça düzdür. Malzeme sert, "
"dokunulduğunda sıcak ve hafif nemlidir."

#. ~ Description for resin floor
#: data/json/furniture_and_terrain/terrain-migo.json
msgid ""
"This nearly opaque, plastic-like floor is smooth and flat.  The material is "
"hard, warm to the touch, and slightly damp."
msgstr ""
"Bu neredeyse opak, plastik benzeri zemin pürüzsüz ve düzdür. Malzeme sert, "
"dokunulduğunda sıcak ve hafif nemlidir."

#: data/json/furniture_and_terrain/terrain-migo.json
msgid "resin roof"
msgstr "reçine çatı"

#. ~ Description for resin roof
#: data/json/furniture_and_terrain/terrain-migo.json
msgid ""
"A wide, domed section of nearly opaque, plastic-like material.  When the "
"light hits it, a network of multicolored conduits like blood vessels can be "
"seen snaking through its glistening interior."
msgstr ""
"Neredeyse opak, plastik benzeri malzemeden geniş, kubbeli bir bölüm. Işık "
"vurduğunda, kan damarları gibi çok renkli kanalların parıldayan iç kısmında "
"dolandığı görülebilir."

#: data/json/furniture_and_terrain/terrain-migo.json
msgid "closed resin portal"
msgstr "kapalı reçine portalı"

#. ~ Description for closed resin portal
#: data/json/furniture_and_terrain/terrain-migo.json
msgid ""
"A tricuspid hatch of some sort of damp, flexible, resinous material.  This "
"one is closed tightly, but it looks like a firm push would cause it to snap "
"open."
msgstr ""
"Nemli, esnek, reçineli bir malzemeden yapılmış üç kapaklı bir kapak. Bu "
"kapak sıkıca kapalı, ancak sağlam bir itme ile açılacak gibi görünüyor."

#: data/json/furniture_and_terrain/terrain-migo.json
msgid "open resin portal"
msgstr "açık reçine portalı"

#. ~ Description for open resin portal
#: data/json/furniture_and_terrain/terrain-migo.json
msgid ""
"A tricuspid hatch of some sort of damp, flexible, resinous material.  This "
"one is open, the flaps held out by some sort of stringy mucus-like "
"substance."
msgstr ""
"Nemli, esnek, reçineli bir malzemeden yapılmış üç kapaklı bir kapak. Bu "
"kapak açık, kanatlar ipliksi, sümüksü bir madde ile dışarıda tutuluyor."

#: data/json/furniture_and_terrain/terrain-migo.json
msgid "resin-lined hole"
msgstr "reçine kaplı delik"

#. ~ Description for resin-lined hole
#: data/json/furniture_and_terrain/terrain-migo.json
msgid "An open hole in the resin wall, large enough to pass through."
msgstr "Reçine duvarında, geçiş için yeterince büyük açık bir delik."

#: data/json/furniture_and_terrain/terrain-nether.json
msgid "dimensional portal"
msgstr "boyutsal portal"

#. ~ Description for dimensional portal
#: data/json/furniture_and_terrain/terrain-nether.json
msgid ""
"The portal that started it all.  A dimly shimmering, completely opaque mist,"
" jet black at the edges, and deep red in the center.  A nuclear explosive "
"placed inside may destabilize and close it.  Alternatively, you may be able "
"to close it from the other side."
msgstr ""
"Her şeyin başladığı portal. Kenarları jet siyahı, merkezi koyu kırmızı olan,"
" hafifçe parlayan, tamamen opak bir sis. İçine yerleştirilen bir nükleer "
"patlayıcı, portalı dengesizleştirip kapatabilir. Alternatif olarak, diğer "
"taraftan kapatmayı deneyebilirsiniz."

#: data/json/furniture_and_terrain/terrain-railroads.json
msgid "gravel"
msgstr "çakıl"

#. ~ Description for gravel
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid ""
"A small mallet that a judge uses to call - er, wait.  Oh, gravel!  Gravel is"
" a collection of small stones often used for roads, as railroad ballast, and"
" in many other applications."
msgstr ""
"Bir hakimin kullandığı küçük tokmak - ya da dur, çakıl! Çakıl, genellikle "
"yollar, demiryolu balastı ve birçok başka uygulama için kullanılan küçük "
"taşların bir koleksiyonudur."

#: data/json/furniture_and_terrain/terrain-railroads.json
msgid "railroad track"
msgstr "demiryolu hattı"

#. ~ Description for railroad track
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid ""
"Trains used to chug along on these.  These rail tracks stand unused in the "
"face of the Cataclysm."
msgstr ""
"Trenler bunların üzerinde tıngır mıngır giderdi. Bu demiryolu hatları, "
"Felaket karşısında kullanılmaz hale geldi."

#: data/json/furniture_and_terrain/terrain-railroads.json
msgid "railroad tie"
msgstr "demiryolu traversi"

#. ~ Description for railroad tie
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid "This crosstie is used to support the rails."
msgstr "Bu travers, rayları desteklemek için kullanılır."

#. ~ Description for railroad track
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid ""
"Trains used to chug along on these.  These rail tracks stand unused in the "
"face of the Cataclysm.  A crosstie sits underneath, supporting the rails."
msgstr ""
"Trenler bunların üzerinde tıngır mıngır giderdi. Bu demiryolu hatları, "
"Felaket karşısında kullanılmaz hale geldi. Bir travers, rayların altında "
"oturur ve onları destekler."

#: data/json/furniture_and_terrain/terrain-railroads.json
msgid "buffer stop"
msgstr "tampon durdurucu"

#. ~ Description for buffer stop
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid ""
"A tiny blockade on the train tracks, meant to signify the end of a track, or"
" mark a 'no-go' zone for trains."
msgstr ""
"Tren rayları üzerinde, bir hattın sonunu belirtmek veya trenler için bir "
"'geçilmez' bölgeyi işaretlemek amacıyla kullanılan küçük bir engel."

#: data/json/furniture_and_terrain/terrain-railroads.json
msgid "railroad crossing signal"
msgstr "demiryolu geçidi sinyali"

#. ~ Description for railroad crossing signal
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid ""
"Traffic lights meant to light and make noise when a train approaches, to "
"prevent people from turning into meaty mush while they cross the tracks.  "
"Won't stop people from turning into meaty mush by other means, though."
msgstr ""
"Bir tren yaklaştığında ışık ve ses çıkararak insanların rayları geçerken "
"etli püreye dönüşmesini önlemek için tasarlanmış trafik lambaları. Ancak, "
"insanların başka yollarla etli püreye dönüşmesini engellemez."

#: data/json/furniture_and_terrain/terrain-railroads.json
msgid "crossbuck"
msgstr "çapraz demir"

#. ~ Description for crossbuck
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid ""
"A traffic sign intended to indicate a level railway crossing.  If the trains"
" were still running."
msgstr ""
"Bir demiryolu geçidini belirtmek için tasarlanmış bir trafik işareti. "
"Trenler hala çalışıyor olsaydı."

#: data/json/furniture_and_terrain/terrain-railroads.json
#: data/json/items/generic.json
msgid "small railroad track"
msgid_plural "small railroad tracks"
msgstr[0] "küçük demiryolu hattı"
msgstr[1] "küçük demiryolu hatları"

#. ~ Description for small railroad track
#: data/json/furniture_and_terrain/terrain-railroads.json
msgid ""
"Like a railroad track, only smaller.  You could probably run a small vehicle"
" on this."
msgstr ""
"Bir demiryolu hattı gibi, sadece daha küçük. Muhtemelen küçük bir aracı "
"bunun üzerinde sürebilirsiniz."

#: data/json/furniture_and_terrain/terrain-recreational.json
msgid "sandbox"
msgstr "kum havuzu"

#. ~ Description for sandbox
#: data/json/furniture_and_terrain/terrain-recreational.json
msgid ""
"Children used to play in this sandbox.  The population of lice probably "
"diminished considerably now that they no longer do."
msgstr ""
"Çocuklar bu kum havuzunda oynardı. Artık oynamadıkları için bit popülasyonu "
"muhtemelen oldukça azaldı."

#: data/json/furniture_and_terrain/terrain-recreational.json
msgid "slide"
msgstr "kaydırak"

#. ~ Description for slide
#: data/json/furniture_and_terrain/terrain-recreational.json
msgid "A children's slide.  Too small to slide on comfortably anymore."
msgstr "Bir çocuk kaydırağı. Artık rahatça kaymak için çok küçük."

#: data/json/furniture_and_terrain/terrain-recreational.json
msgid "monkey bars"
msgstr "maymun barları"

#. ~ Description for monkey bars
#: data/json/furniture_and_terrain/terrain-recreational.json
msgid ""
"A set of monkey bars, to be used by children to train their arms by hanging "
"from the bars, and have fun."
msgstr ""
"Çocukların kollarını eğitmek ve eğlenmek için çubuklardan sarkarak "
"kullanabilecekleri bir maymun barları seti."

#: data/json/furniture_and_terrain/terrain-recreational.json
msgid "backboard"
msgstr "pota tahtası"

#. ~ Description for backboard
#: data/json/furniture_and_terrain/terrain-recreational.json
msgid "A basketball backboard."
msgstr "Bir basketbol pota tahtası."

#. ~ Description for backboard
#: data/json/furniture_and_terrain/terrain-recreational.json
msgid "A metal backboard."
msgstr "Bir metal pota tahtası."

#. ~ Description for this should never actually show up, it's a pseudo terrain
#: data/json/furniture_and_terrain/terrain-regional-pseudo.json
msgid "this should never actually show up, it's a pseudo terrain"
msgstr "bu asla görünmemeli, bu bir sahte arazi"

#. ~ Description for this should never actually show up, it's a pseudo terrain
#: data/json/furniture_and_terrain/terrain-regional-pseudo.json
msgid ""
"this should never actually show up, it's a pseudo terrain.  For use where "
"people have trampled away grass, or otherwise cleared plant life."
msgstr ""
"bu asla görünmemeli, bu bir sahte arazi. İnsanların çimleri ezdiği veya "
"bitki örtüsünü temizlediği yerlerde kullanılmak üzere."

#. ~ Description for this should never actually show up, it's a pseudo terrain
#: data/json/furniture_and_terrain/terrain-regional-pseudo.json
msgid ""
"this should never actually show up, it's a pseudo terrain.  For use where "
"clean, curated grass is the only expected terrain - modified by whatever the"
" biome equivalent is"
msgstr ""
"bu asla görünmemeli, bu bir sahte arazi. Temiz, düzenlenmiş çimlerin tek "
"beklenen arazi olduğu yerlerde kullanılmak üzere - biyom eşdeğeri ne ise "
"onunla değiştirilmiş"

#. ~ Description for this should never actually show up, it's a pseudo terrain
#: data/json/furniture_and_terrain/terrain-regional-pseudo.json
msgid ""
"this should never actually show up, it's a pseudo terrain.  For use where "
"plants have been planted and grass/groundcover kept clear"
msgstr ""
"bu asla görünmemeli, bu bir sahte arazi. Bitkilerin dikildiği ve çim/yer "
"örtüsünün temiz tutulduğu yerlerde kullanılmak üzere"

#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "rain gutter"
msgstr "yağmur oluğu"

#. ~ Description for rain gutter
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "Channels water from the roof towards the ground, it looks flimsy."
msgstr "Çatıdan suyu yere doğru yönlendirir, kırılgan görünüyor."

#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "gutter drop"
msgstr "oluk düşüşü"

#. ~ Description for gutter drop
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid ""
"Funnels water from gutter system towards the ground, it looks flimsy.  You "
"may be able to climb down here."
msgstr ""
"Su oluk sisteminden yere doğru suyu yönlendirir, kırılgan görünüyor. Buradan"
" aşağıya inebilirsin."

#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "downspout"
msgstr "oluk borusu"

#. ~ Description for downspout
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid ""
"A length of gutter running from the roof to the ground, you could place a "
"container underneath it to collect rainwater.  It looks flimsy.  You may be "
"able to climb down here."
msgstr ""
"Çatıdan yere kadar uzanan bir oluk parçası, altına yağmur suyu toplamak için"
" bir kap yerleştirebilirsin. Kırılgan görünüyor. Buradan aşağıya "
"inebilirsin."

#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "flat roof"
msgstr "düz çatı"

#. ~ Description for flat roof
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A flat, gray section of rooftop."
msgstr "Düz, gri bir çatı bölümü."

#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "tar paper flat roof"
msgstr "katran kağıdı kaplı düz çatı"

#. ~ Description for tar paper flat roof
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A flat, gray section of rooftop covered with tar paper."
msgstr "Katran kağıdı ile kaplı düz, gri bir çatı bölümü."

#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "shingle flat roof"
msgstr "kiremit kaplı düz çatı"

#. ~ Description for shingle flat roof
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A flat section of rooftop covered in shingles."
msgstr "Kiremitlerle kaplı düz bir çatı bölümü."

#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "thatched roof"
msgstr "saman çatılı çatı"

#. ~ Description for thatched roof
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A section of roof made out of straw."
msgstr "Samanla yapılmış bir çatı bölümü."

#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "metal flat roof"
msgstr "metal düz çatı"

#. ~ Description for metal flat roof
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A section of flat, sheet metal rooftop."
msgstr "Düz, sac metalden yapılmış bir çatı bölümü."

#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "tile flat roof"
msgstr "kiremit düz çatı"

#. ~ Description for tile flat roof
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A section of tiled, flat rooftop."
msgstr "Düz, kiremitli bir çatı bölümü."

#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "skylight"
msgstr "çatı penceresi"

#. ~ Description for skylight
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid ""
"A giant sheet of glass inserted into the roof, lets light pass through."
msgstr "Çatıya yerleştirilmiş dev bir cam levha, ışığın geçmesine izin verir."

#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "rock roof"
msgstr "kaya çatı"

#. ~ Description for rock roof
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A section of flat natural rock."
msgstr "Düz doğal kaya bölümü."

#. ~ Description for flat roof
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A flat surface made of pulpy mass, covered in sticky wasp saliva."
msgstr ""
"Yapışkan yaban arısı tükürüğüyle kaplanmış, hamurumsu kütleden yapılmış düz "
"bir yüzey."

#. ~ Description for flat roof
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid ""
"A flat surface made of hardened pulpy mass, covered in sticky wasp saliva."
msgstr ""
"Sertleştirilmiş hamur kütlesinden yapılmış, yapışkan yaban arısı tükürüğüyle"
" kaplanmış düz bir yüzey."

#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "web bridge"
msgstr "ağ köprüsü"

#. ~ Description for web bridge
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "A hammock like bridge spun from spider silk."
msgstr "Örümcek ipeğinden örülmüş hamak benzeri köprü."

#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "treetop"
msgstr "ağaç tepesi"

#. ~ Description for treetop
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "The upper branches of a tree.  There's just enough room to perch here."
msgstr "Bir ağacın üst dalları. Burada tünemek için yeterince yer var."

#: data/json/furniture_and_terrain/terrain-roofs.json
msgid "dead treetop"
msgstr "ölü ağaç tepesi"

#. ~ Description for dead treetop
#: data/json/furniture_and_terrain/terrain-roofs.json
msgid ""
"The bare upper branches of a dead tree.  There's just enough room to perch "
"here."
msgstr ""
"Ölü bir ağacın çıplak üst dalları. Burada tünemek için yeterince yer var."

#: data/json/furniture_and_terrain/terrain-traps.json
msgid "shallow pit"
msgstr "sığ çukur"

#. ~ Description for shallow pit
#: data/json/furniture_and_terrain/terrain-traps.json
msgid ""
"A pit that could be dug even deeper or filled up.  Also useful as a starting"
" foundation for some constructions."
msgstr ""
"Daha da derin kazılabilecek veya doldurulabilecek bir çukur. Ayrıca bazı "
"yapılar için başlangıç temeli olarak da kullanışlı."

#. ~ Description for pit
#: data/json/furniture_and_terrain/terrain-traps.json
msgid ""
"A steep hole that could seriously injure something if it fell in, "
"potentially fatal if it was filled with sharp and dangerous things.  Deep "
"enough for more advanced construction projects, and possibly to reach "
"groundwater if constructed properly."
msgstr ""
"Bir şeyin içine düşmesi durumunda ciddi şekilde yaralanabileceği, keskin ve "
"tehlikeli şeylerle doldurulursa potansiyel olarak ölümcül olabilecek dik bir"
" delik. Daha gelişmiş inşaat projeleri için yeterince derin ve doğru şekilde"
" inşa edilirse yeraltı suyuna ulaşmak için de kullanılabilir."

#: data/json/furniture_and_terrain/terrain-traps.json
msgid "corpse filled pit"
msgstr "ceset dolu çukur"

#. ~ Description for corpse filled pit
#: data/json/furniture_and_terrain/terrain-traps.json
msgid ""
"A giant trench full of corpses, maybe even a mass graveyard.  The bodies "
"could be dug out but none of it looks remotely usable."
msgstr ""
"Devasa bir hendek, belki de bir toplu mezarlık, cesetlerle dolu. Cesetler "
"çıkarılabilir ama hiçbiri kullanılabilir gibi görünmüyor."

#: data/json/furniture_and_terrain/terrain-traps.json
msgid "covered pit"
msgstr "örtülü çukur"

#. ~ Description for covered pit
#: data/json/furniture_and_terrain/terrain-traps.json
msgid ""
"A deep pit with a two by four placed across it, looks sturdy enough to cross"
" safely or the plank could be removed to turn it back into trap fall."
msgstr ""
"Üzerine ikiye dört bir tahta yerleştirilmiş derin bir çukur, güvenli bir "
"şekilde geçmek için yeterince sağlam görünüyor ya da tahtayı çıkararak "
"tekrar bir tuzak haline getirilebilir."

#. ~ Description for spiked pit
#: data/json/furniture_and_terrain/terrain-traps.json
msgid ""
"A narrow trench full of very pointy things that would easily puncture a "
"body."
msgstr ""
"Bir bedeni kolayca delip geçebilecek kadar sivri şeylerle dolu dar bir "
"hendek."

#: data/json/furniture_and_terrain/terrain-traps.json
msgid "covered spiked pit"
msgstr "örtülü dikenli çukur"

#. ~ Description for covered spiked pit
#: data/json/furniture_and_terrain/terrain-traps.json
msgid ""
"Menacing with sharp spears along the bottom, this pit has a plank across it "
"to allow someone or something to cross safely.  The two by four could be "
"removed to revert it back into a trap."
msgstr ""
"Alt kısmında keskin mızraklarla tehditkar bir şekilde duran bu çukurun "
"üzerinden güvenli bir şekilde geçilmesi için bir tahta yerleştirilmiş. İkiye"
" dört olan tahta çıkarılarak tekrar bir tuzağa dönüştürülebilir."

#. ~ Description for glass pit
#: data/json/furniture_and_terrain/terrain-traps.json
msgid ""
"Looks like a ton of broken glass was dumped into this pit, maybe not fatal "
"to fall in but wouldn't be pleasant to try to crawl out."
msgstr ""
"Bu çukura bir ton kırık cam dökülmüş gibi görünüyor, içine düşmek ölümcül "
"olmayabilir ama çıkmaya çalışmak da hoş olmazdı."

#: data/json/furniture_and_terrain/terrain-traps.json
msgid "covered glass pit"
msgstr "örtülü cam çukur"

#. ~ Description for covered glass pit
#: data/json/furniture_and_terrain/terrain-traps.json
msgid ""
"A two by four has been placed carefully to allow traversal over this ditch "
"full of large glass shards.  The wooden board could be removed so it "
"couldn't be safely crossed."
msgstr ""
"Büyük cam parçalarıyla dolu bu hendekten geçişi sağlamak için dikkatlice bir"
" ikiye dört tahta yerleştirilmiş. Tahta çıkarılarak güvenli bir geçiş "
"imkansız hale getirilebilir."

#: data/json/furniture_and_terrain/terrain-traps.json
msgid "slime"
msgstr "yapışkan madde"

#. ~ Description for slime
#: data/json/furniture_and_terrain/terrain-traps.json
msgid ""
"A disgusting and slippery mess that could be used to stash things because "
"who'd want to touch it?"
msgstr ""
"Kimsenin dokunmak istemeyeceği iğrenç ve kaygan bir karışıklık, bu yüzden "
"içine bir şeyler saklamak için kullanılabilir."

#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "solid bark wall"
msgstr "sağlam kabuk duvarı"

#. ~ Description for solid bark wall
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid ""
"A solid wall of bark, enclosing the trunk of a massive tree.  It will "
"probably burn quite well."
msgstr ""
"Devasa bir ağacın gövdesini çevreleyen sağlam bir kabuk duvarı. Muhtemelen "
"oldukça iyi yanar."

#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "chipped bark wall"
msgstr "kırık kabuk duvarı"

#. ~ Description for chipped bark wall
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid ""
"A solid wall of bark enclosing the trunk of a massive tree.  Some of it has "
"been broken away."
msgstr ""
"Devasa bir ağacın gövdesini çevreleyen sağlam bir kabuk duvarı. Bir kısmı "
"kırılmış."

#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "broken bark wall"
msgstr "yıkık kabuk duvarı"

#. ~ Description for broken bark wall
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid ""
"A formerly solid wall of bark, now almost completely destroyed and waiting "
"to collapse."
msgstr ""
"Eskiden sağlam olan bir kabuk duvarı, şimdi neredeyse tamamen yıkılmış ve "
"çökmeyi bekliyor."

#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "solid wood wall"
msgstr "sağlam ahşap duvar"

#. ~ Description for solid wood wall
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "A solid wall of naturally grown wood.  Likely very flammable."
msgstr ""
"Doğal olarak büyümüş sağlam bir ahşap duvar. Muhtemelen oldukça yanıcı."

#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "bark"
msgstr "kabuk"

#. ~ Description for bark
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "A solid piece of bark covers the floor here."
msgstr "Burada zemini kaplayan sağlam bir kabuk parçası var."

#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "branches with leaves"
msgstr "yapraklı dallar"

#. ~ Description for branches with leaves
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "Thin branches emerge here, covered with thick, large leaves."
msgstr "Burada ince dallar ortaya çıkıyor, kalın ve büyük yapraklarla kaplı."

#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "root floor"
msgstr "kök zemin"

#. ~ Description for root floor
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "A dirt floor covered with roots."
msgstr "Köklerle kaplı bir toprak zemin."

#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "downward root slope"
msgstr "aşağıya doğru kök eğimi"

#. ~ Description for downward root slope
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "A downward-facing slope of root-covered dirt."
msgstr "Köklerle kaplı toprakta aşağıya doğru bakan bir eğim."

#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "upward root slope"
msgstr "yukarıya doğru kök eğimi"

#. ~ Description for upward root slope
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "An upward-facing slope of root-covered dirt."
msgstr "Köklerle kaplı toprakta yukarıya doğru bakan bir eğim."

#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "closed bramble roots"
msgstr "kapalı böğürtlen kökleri"

#. ~ Description for closed bramble roots
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid ""
"A bramble of roots can be seen here, covering a hole.  They could easily be "
"pulled apart."
msgstr ""
"Burada bir delik kaplayan bir kök böğürtleni görülebilir. Kolayca "
"ayrılabilirler."

#: data/json/furniture_and_terrain/terrain-triffid.json
msgid "open bramble roots"
msgstr "açık böğürtlen kökleri"

#. ~ Description for open bramble roots
#: data/json/furniture_and_terrain/terrain-triffid.json
msgid ""
"A bramble of roots can be seen here, they have been pulled apart to reveal a"
" hole."
msgstr ""
"Burada bir kök böğürtleni görülebilir, bir delik açığa çıkarmak için "
"ayrılmışlar."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "plastered wooden wall"
msgstr "sıvalı ahşap duvar"

#. ~ Description for plastered wooden wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"The stereotypical wall with wooden support structure filled with insulation "
"and drywalled.  Paint job is the all too common and neutral off-white or "
"cream color, it could use more vibrant paint.  The underlying material is "
"still somewhat flammable."
msgstr ""
"Ahşap destek yapısı, yalıtım ve alçıpanla doldurulmuş, klişe bir duvar. Boya"
" işi, çok yaygın ve nötr bir kırık beyaz veya krem renginde, daha canlı bir "
"boya kullanılabilir. Alt malzeme hala biraz yanıcı."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "half-built wooden wall"
msgstr "yarım inşa edilmiş ahşap duvar"

#. ~ Description for half-built wooden wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"An incomplete wall of refined wood, dotted with carefully placed nails to "
"provide proper support.  It requires some more two by fours and nails before"
" it'd be considered a suitable wall."
msgstr ""
"Dikkatlice yerleştirilmiş çivilerle uygun destek sağlamak için noktalı, "
"rafine ahşaptan yapılmış eksik bir duvar. Uygun bir duvar olarak kabul "
"edilmesi için biraz daha ikiye dört ve çiviye ihtiyaç var."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "half-built domestic wall"
msgstr "yarım inşa edilmiş ev duvarı"

#. ~ Description for half-built domestic wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"Wooden slats nailed across the bare skeleton of what will eventually be a "
"modern interior wall.  The finishing touches would typically be drywall or "
"plaster, or whatever one can improvise out of local materials."
msgstr ""
"Modern bir iç duvarın çıplak iskeletine çakılmış ahşap çıtalar. Son "
"dokunuşlar tipik olarak alçıpan veya sıva olur ya da yerel malzemelerle ne "
"yapılabilirse."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "pony wall"
msgstr "alçak duvar"

#. ~ Description for pony wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A short divider wall with wooden support structure with drywall.  Paint job "
"is the all too common and neutral off-white or cream color.  Appears as "
"though the material is flammable."
msgstr ""
"Alçıpan ile ahşap destek yapısına sahip kısa bir bölme duvarı. Boya işi, çok"
" yaygın ve nötr olan kirli beyaz veya krem rengindedir. Malzemenin yanıcı "
"olduğu görülüyor."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "red wall"
msgstr "kırmızı duvar"

#. ~ Description for red wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "Wall painted red."
msgstr "Kırmızıya boyanmış duvar."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "white wall"
msgstr "beyaz duvar"

#. ~ Description for white wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "Wall painted white."
msgstr "Beyaza boyanmış duvar."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "blue wall"
msgstr "mavi duvar"

#. ~ Description for blue wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "Wall painted blue."
msgstr "Maviye boyanmış duvar."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "green wall"
msgstr "yeşil duvar"

#. ~ Description for green wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "Wall painted green."
msgstr "Yeşile boyanmış duvar."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "yellow wall"
msgstr "sarı duvar"

#. ~ Description for yellow wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "Wall painted yellow."
msgstr "Sarıya boyanmış duvar."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "pink wall"
msgstr "pembe duvar"

#. ~ Description for pink wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "Wall painted pink."
msgstr "Pembeye boyanmış duvar."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "purple wall"
msgstr "mor duvar"

#. ~ Description for purple wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "Wall painted purple."
msgstr "Mora boyanmış duvar."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "half-built brick wall"
msgstr "yarı inşa edilmiş tuğla duvar"

#. ~ Description for half-built brick wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"Half of a brick wall, looks like it still requires some more resources and "
"effort before being considered a real wall."
msgstr ""
"Yarı inşa edilmiş bir tuğla duvar, gerçek bir duvar olarak kabul edilmeden "
"önce biraz daha kaynak ve çaba gerektiriyor gibi görünüyor."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "bash!"
msgstr "pat!"

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "brick wall"
msgstr "tuğla duvar"

#. ~ Description for brick wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A solid brick wall, sturdy enough to support a roof with enough walls and "
"keep out any unwanted visitors."
msgstr ""
"Sağlam bir tuğla duvar, yeterince duvarla bir çatı destekleyecek kadar "
"sağlam ve istenmeyen ziyaretçileri dışarıda tutacak kadar güçlü."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "stone wall"
msgstr "taş duvar"

#. ~ Description for stone wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A sturdy stone wall."
msgstr "Sağlam bir taş duvar."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "half-built stone wall"
msgstr "yarı inşa edilmiş taş duvar"

#. ~ Description for half-built stone wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"Half of a sturdy stone wall.  Some work still needs to be done before this "
"stone wall is complete."
msgstr ""
"Sağlam bir taş duvarın yarısı. Bu taş duvarın tamamlanması için hala biraz "
"çalışmaya ihtiyaç var."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "smoothed rock"
msgstr "düzleştirilmiş kaya"

#. ~ Description for smoothed rock
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A block of stone that's been smoothed and shaped, commonly granite or marble"
" for funerary chapels and mausoleums."
msgstr ""
"Düzleştirilmiş ve şekillendirilmiş bir taş bloğu, genellikle cenaze "
"şapelleri ve türbeler için granit veya mermer."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "half-built adobe wall"
msgstr "yarı inşa edilmiş kerpiç duvar"

#. ~ Description for half-built adobe wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"Half of an adobe brick wall, looks like it still requires some more "
"resources and effort before being considered a real wall."
msgstr ""
"Bir kerpiç tuğla duvarın yarısı, gerçek bir duvar olarak kabul edilmeden "
"önce hala biraz daha kaynak ve çaba gerektiriyor gibi görünüyor."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "adobe wall"
msgstr "kerpiç duvar"

#. ~ Description for adobe wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A solid adobe brick wall, sturdy enough to support a roof with enough walls "
"and keep out any unwanted visitors."
msgstr ""
"Çatı destekleyecek kadar sağlam ve istenmeyen misafirleri dışarıda tutacak "
"kadar güçlü, katı kerpiç tuğla duvar."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "concrete wall"
msgstr "beton duvar"

#. ~ Description for concrete wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"An aesthetically pleasing design with simple lines, this type of concrete "
"was used with a weaker chemical mixture in order to have faster setting "
"times.  Not ideal for multi-story buildings, but still capable of supporting"
" a roof."
msgstr ""
"Basit çizgilerle estetik açıdan hoş bir tasarım, bu tür beton daha hızlı "
"kuruma süreleri için daha zayıf bir kimyasal karışımla kullanılmıştır. Çok "
"katlı binalar için ideal değil, ancak yine de bir çatı destekleyebilir."

#. ~ Description for bulkhead
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"An industrially fabricated thick sheet carefully positioned, this wall is "
"capable of resisting extreme elements as well as hostile forces."
msgstr ""
"Endüstriyel olarak üretilmiş kalın bir levha dikkatlice konumlandırılmış, bu"
" duvar aşırı hava koşullarına ve düşman güçlere karşı direnç gösterebilir."

#. ~ Description for underwater bulkhead
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"An industrially fabricated thick sheet carefully positioned, this wall is "
"capable of resisting extreme elements as well as hostile forces.  Seems to "
"have sprung a leak, however."
msgstr ""
"Endüstriyel olarak üretilmiş kalın bir levha dikkatlice konumlandırılmış, bu"
" duvar aşırı hava koşullarına ve düşman güçlere karşı direnç gösterebilir. "
"Ancak, sızdırmaya başlamış gibi görünüyor."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "simple concrete wall"
msgstr "basit beton duvar"

#. ~ Description for simple concrete wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A durable and uniform concrete wall, quite drab without decoration.  More "
"than capable of supporting a roof, as well as keeping out most anything, "
"save for vehicles."
msgstr ""
"Dekorasyonsuz oldukça sade, dayanıklı ve düzgün bir beton duvar. Çatı "
"desteklemenin yanı sıra araçlar hariç hemen hemen her şeyi dışarıda "
"tutabilecek kapasitede."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "half-built simple concrete wall"
msgstr "yarı inşa edilmiş basit beton duvar"

#. ~ Description for half-built simple concrete wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A partially poured concrete wall that could probably keep anything behind it"
" quite safe if it were finished."
msgstr ""
"Tamamlanmış olsaydı arkasındaki her şeyi oldukça güvende tutabilecek kısmen "
"dökülmüş bir beton duvar."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "reinforced concrete wall"
msgstr "güçlendirilmiş beton duvar"

#. ~ Description for reinforced concrete wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"An extremely resilient wall, filled with concrete and rebar.  Best suited "
"for supporting multi-level buildings, only serious explosives and high-speed"
" impacts would be capable of damaging this wall."
msgstr ""
"Beton ve demirle doldurulmuş son derece dayanıklı bir duvar. Çok katlı "
"binaları desteklemek için en uygun olanı, sadece ciddi patlayıcılar ve "
"yüksek hızlı darbeler bu duvara zarar verebilir."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "scrrrash!"
msgstr "çatırtı!"

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "half-built reinforced concrete wall"
msgstr "yarı inşa edilmiş güçlendirilmiş beton duvar"

#. ~ Description for half-built reinforced concrete wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"Poured concrete with methodically placed rebar sticking out, which isn't "
"practical for supporting roofs or shelter.  It appears to need more "
"resources before being considered complete."
msgstr ""
"Dikkatlice yerleştirilmiş demir çubuklarla dökülmüş beton, çatıları veya "
"barınakları desteklemek için pratik değildir. Tamamlanmış olarak kabul "
"edilmesi için daha fazla kaynağa ihtiyaç duyuyor gibi görünüyor."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "rebar cage"
msgstr "demir çubuk kafesi"

#. ~ Description for rebar cage
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A structural support system made of rebar that appears to be the early "
"stages of a reinforced concrete wall, just missing the poured concrete."
msgstr ""
"Dökülmüş betonu eksik olan, güçlendirilmiş beton duvarın erken aşamalarında "
"görünen demir çubuklardan yapılmış bir yapısal destek sistemi."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "simple metal wall"
msgstr "basit metal duvar"

#. ~ Description for simple metal wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A relatively simple wall made of scraped together metal.  It's still capable"
" of blocking intruders and supporting a roof with adjacent walls."
msgstr ""
"Bir araya getirilmiş metalden yapılmış nispeten basit bir duvar. Hâlâ "
"davetsiz misafirleri engelleyebilir ve bitişik duvarlarla bir çatı "
"destekleyebilir."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "half-built simple metal wall"
msgstr "yarı inşa edilmiş basit metal duvar"

#. ~ Description for half-built simple metal wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A partially built makeshift wall of metal that could potentially support a "
"roof if it were completed."
msgstr ""
"Tamamlanırsa bir çatı destekleyebilecek potansiyele sahip, kısmen inşa "
"edilmiş geçici bir metal duvar."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "screen mesh wall"
msgstr "tel örgü duvar"

#. ~ Description for screen mesh wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A rather flimsy tall wall made of 2x4s and screen mesh, suitable for keeping"
" the bugs out."
msgstr ""
"Böcekleri dışarıda tutmak için uygun, 2x4'lerden ve tel örgüden yapılmış "
"oldukça dayanıksız yüksek bir duvar."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "wooden wall"
msgstr "ahşap duvar"

#. ~ Description for wooden wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A finished wall of planks and support beams, capable of supporting an upper "
"level or roof.  Still highly flammable."
msgstr ""
"Üst kat veya çatı destekleyebilen, tamamlanmış bir tahta ve destek kirişleri"
" duvarı. Hâlâ oldukça yanıcı."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "chipped wood wall"
msgstr "çatlamış ahşap duvar"

#. ~ Description for chipped wood wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A wall of aligned two by fours that's starting to crack and break open.  "
"Some cut wood and a number of nails could patch this up quick."
msgstr ""
"Çatlamaya ve açılmaya başlayan, hizalanmış ikiye dörtlüklerden oluşan bir "
"duvar. Biraz kesilmiş ahşap ve birkaç çivi ile hızlıca onarılabilir."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "broken wood wall"
msgstr "kırık ahşap duvar"

#. ~ Description for broken wood wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A number of planks are missing and the structure is beginning to sag and "
"fall apart.  It's going to need quite a bit of work to repair this wall."
msgstr ""
"Birçok tahta eksik ve yapı sarkmaya ve dağılmaya başlıyor. Bu duvarı onarmak"
" için oldukça fazla iş gerekecek."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "underwater wooden wall"
msgstr "su altı ahşap duvar"

#. ~ Description for underwater wooden wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A decaying old section of wooden wall, soaked through and leaking.  It will "
"likely crumble to bits if damaged."
msgstr ""
"Tamamen suya batmış ve sızdıran, çürüyen eski bir ahşap duvar bölümü. Hasar "
"görürse muhtemelen parçalanacaktır."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "half-built log wall"
msgstr "yarım inşa edilmiş kütük duvarı"

#. ~ Description for half-built log wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A half-constructed wall of notched logs that interlock to provide stability."
"  Needs a few more logs to hold up a roof.  Looks flammable."
msgstr ""
"Birbirine kenetlenen ve stabilite sağlayan yarım inşa edilmiş kütük duvarı. "
"Çatıyı desteklemek için birkaç kütüğe daha ihtiyaç var. Yanıcı görünüyor."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "log wall"
msgstr "kütük duvarı"

#. ~ Description for log wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A tall wall of timber suitable for housing and insulating from the weather."
"  Quite flammable."
msgstr ""
"Barınma ve hava koşullarından yalıtım için uygun, yüksek bir ahşap duvar. "
"Oldukça yanıcı."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "chipped log wall"
msgstr "çentikli kütük duvarı"

#. ~ Description for chipped log wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A moderately damaged wall, could probably be patched up with some planks and"
" nails."
msgstr ""
"Orta derecede hasar görmüş bir duvar, muhtemelen birkaç tahta ve çivi ile "
"onarılabilir."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "broken log wall"
msgstr "kırık kütük duvarı"

#. ~ Description for broken log wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A destroyed wood wall, with only a supporting log left, ready to collapse.  "
"Looks repairable if the damage was replaced and patched together with nails "
"and planks."
msgstr ""
"Yalnızca destekleyici bir kütüğün kaldığı, yıkılmış bir ahşap duvar, çökmeye"
" hazır. Hasar değiştirilip çiviler ve tahtalarla birleştirilirse "
"onarılabilir görünüyor."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "palisade wall"
msgstr "palisade duvarı"

#. ~ Description for palisade wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"An age-old type of fortification consisting of hefty lumber staked into the "
"ground and cabled together."
msgstr ""
"Yere çakılmış ve birbirine bağlanmış kalın kerestelerden oluşan, eski bir "
"tahkimat türü."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "wattle-and-daub wall"
msgstr "örgü ve sıva duvar"

#. ~ Description for wattle-and-daub wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A relatively primitive wall made by daubing together a lattice of wooden "
"strips using some combination of wet soil, clay, sand, animal dung and "
"straw."
msgstr ""
"Ahşap şeritlerden oluşan bir kafesin, ıslak toprak, kil, kum, hayvan gübresi"
" ve saman karışımıyla sıvanarak oluşturulduğu nispeten ilkel bir duvar."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "broken wattle-and-daub wall"
msgstr "kırık örgü ve sıva duvar"

#. ~ Description for broken wattle-and-daub wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"This wattle-and-daub wall section has been destroyed, leaving mostly just "
"frame, and is barely held together."
msgstr ""
"Bu örgü ve sıva duvar bölümü yıkılmış, geriye çoğunlukla sadece çerçeve "
"kalmış ve zar zor bir arada duruyor."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "half-built wattle-and-daub wall"
msgstr "yarı inşa edilmiş örgü ve sıva duvar"

#. ~ Description for half-built wattle-and-daub wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"This wattle-and-daub wall has some of the wooden strip lattice in place, and"
" still requires the rest of the lattice and supporting wet compound to be "
"filled in."
msgstr ""
"Bu örgü ve sıva duvarın bazı ahşap şerit kafesleri yerleştirilmiş, ancak "
"hala kafesin geri kalanı ve destekleyici ıslak bileşiğin doldurulması "
"gerekiyor."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "smooth dirt wall"
msgstr "düzgün toprak duvar"

#. ~ Description for smooth dirt wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A solid wall of compressed dirt, mixed with… something to keep it stable.  "
"Its surface glistens slightly, and it smells like rotten milk."
msgstr ""
"Sıkıştırılmış topraktan yapılmış, kararlılığını korumak için bir şeyle "
"karıştırılmış sağlam bir duvar. Yüzeyi hafifçe parlıyor ve çürük süt gibi "
"kokuyor."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "heavy rumbling!"
msgstr "ağır bir gümbürtü!"

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "junk metal wall"
msgstr "hurda metal duvar"

#. ~ Description for junk metal wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A wall of rusty scrap metal bolted and wire-tied to a sturdy frame.  Very "
"fashionable in post-apocalyptic shantytowns.  Can support a roof."
msgstr ""
"Paslı hurda metallerden yapılmış, sağlam bir çerçeveye cıvatalanmış ve tel "
"ile bağlanmış bir duvar. Kıyamet sonrası gecekondu kasabalarında oldukça "
"moda. Bir çatı destekleyebilir."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "rammed earth wall"
msgstr "sıkıştırılmış toprak duvar"

#. ~ Description for rammed earth wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A solid wall of compressed dirt, sturdy enough to support a roof with enough"
" walls and keep out some unwanted visitors."
msgstr ""
"Sıkıştırılmış topraktan yapılmış sağlam bir duvar, yeterince duvarla bir "
"çatı destekleyebilir ve istenmeyen bazı ziyaretçileri dışarıda tutabilir."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "junk metal barrier"
msgstr "hurda metal bariyer"

#. ~ Description for junk metal barrier
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A short wall of rusty scrap metal bolted and wire-tied to a makeshift frame."
"  Very fashionable in post-apocalyptic shantytowns.  This one isn't quite "
"strong enough to support a roof, but could be reinforced."
msgstr ""
"Paslı hurda metallerden yapılmış, geçici bir çerçeveye cıvatalanmış ve tel "
"ile bağlanmış kısa bir duvar. Kıyamet sonrası gecekondu kasabalarında "
"oldukça moda. Bu, bir çatı destekleyecek kadar güçlü değil, ancak "
"güçlendirilebilir."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "glass wall"
msgstr "cam duvar"

#. ~ Description for glass wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A barrier made of glass, it's nothing complicated, and looks extremely "
"fragile.  Some contain glass break sensors or window sensors that trigger if"
" the glass is tampered."
msgstr ""
"Camdan yapılmış bir bariyer, karmaşık bir şey değil ve son derece kırılgan "
"görünüyor. Bazılarında cam kırılma sensörleri veya camla oynandığında "
"tetiklenen pencere sensörleri bulunur."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "laminated glass"
msgstr "lamine cam"

#. ~ Description for laminated glass
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"Laminated glass is composed layers of glass and plastic held together by an "
"interlayer."
msgstr ""
"Lamine cam, cam ve plastik katmanlarının bir ara tabaka ile bir arada "
"tutulmasıyla oluşur."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "ballistic glass"
msgstr "balistik cam"

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "reinforced glass"
msgstr "güçlendirilmiş cam"

#. ~ Description for reinforced glass
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A thicker pane of glass with thin metal wires embedded throughout, "
"strengthening the structural properties.  It's a lot stronger than drywall, "
"but it's not made to support a roof and is weaker than concrete."
msgstr ""
"İnce metal tellerle güçlendirilmiş, daha kalın bir cam tabakası. Yapısal "
"özelliklerini güçlendirir. Alçıpanlardan çok daha güçlüdür, ancak bir çatıyı"
" desteklemek için yapılmamıştır ve betondan daha zayıftır."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "reinforced glass with closed shutters"
msgstr "kapalı panjurlu güçlendirilmiş cam"

#. ~ Description for reinforced glass with closed shutters
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A secondary layer of protection over reinforced glass, these metal shutters "
"are typically used to ward off criminals or protect against damage from "
"extreme weather.  Looks like it can only be opened from the inside.  Even "
"with the installed shutters, it isn't feasible in supporting a roof."
msgstr ""
"Güçlendirilmiş cam üzerinde ek bir koruma katmanı olan bu metal panjurlar, "
"genellikle suçluları uzak tutmak veya aşırı hava koşullarından korunmak için"
" kullanılır. Sadece içeriden açılabilir gibi görünüyor. Takılı panjurlara "
"rağmen, bir çatıyı desteklemek için uygun değildir."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "reinforced glass with open shutters"
msgstr "açık panjurlu güçlendirilmiş cam"

#. ~ Description for reinforced glass with open shutters
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"Hanging metal shutters that haven't been deployed, exposing the reinforced "
"glass.  It appears as though the metal shutters can only be activated from "
"the inside."
msgstr ""
"Henüz açılmamış metal panjurlar, güçlendirilmiş camı ortaya çıkarır. Metal "
"panjurların sadece içeriden etkinleştirilebileceği anlaşılıyor."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "metal bars"
msgstr "metal çubuklar"

#. ~ Description for metal bars
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"Thick, heavy bars from the floor to the ceiling, interlaced wall to wall.  "
"Not made to support roofs, but great for blocking paths."
msgstr ""
"Zeminden tavana kadar uzanan, duvardan duvara iç içe geçmiş kalın, ağır "
"çubuklar. Çatıyı desteklemek için yapılmamıştır, ancak yolları engellemek "
"için harikadır."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "paper wall"
msgstr "kağıt duvar"

#. ~ Description for paper wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A huge wall of pulpy mass, covered in sticky wasp saliva.  You could smash "
"it down effortlessly."
msgstr ""
"Yapışkan yaban arısı tükürüğü ile kaplı, büyük bir hamur kütlesi. Kolayca "
"parçalayabilirsiniz."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "layered paper wall"
msgstr "katmanlı kağıt duvarı"

#. ~ Description for layered paper wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A thick wall of layered tree pulp and wasp saliva, hardened to withstand the"
" elements.  You could break through this, but it won't be easy."
msgstr ""
"Ağaç hamuru ve yaban arısı tükürüğünden oluşan kalın bir duvar, doğa "
"koşullarına dayanacak şekilde sertleşmiş. Bunu kırabilirsiniz, ama kolay "
"olmayacak."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "root wall"
msgstr "kök duvarı"

#. ~ Description for root wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A dirt wall covered with roots."
msgstr "Köklerle kaplı bir toprak duvar."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "wax wall"
msgstr "balmumu duvarı"

#. ~ Description for wax wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A wall made entirely out of wax."
msgstr "Tamamen balmumundan yapılmış bir duvar."

#: data/json/furniture_and_terrain/terrain-walls.json
#: data/json/overmap/overmap_terrain/overmap_terrain.json
#: data/json/overmap/overmap_terrain/overmap_terrain_hardcoded.json
#: data/json/overmap/overmap_terrain/overmap_terrain_microlab.json
#: data/json/overmap/overmap_terrain/overmap_terrain_necropolis.json
#: data/mods/alt_map_key/overmap_terrain.json
msgid "solid rock"
msgstr "katı kaya"

#. ~ Description for solid rock
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"It's solid rock, could be full of all kinds of interesting things.  Best "
"grab your pickaxe or equivalent digging implement, and strike the earth!"
msgstr ""
"Bu katı kaya, her türlü ilginç şeyle dolu olabilir. En iyisi kazmanızı veya "
"eşdeğer bir kazı aletinizi alın ve toprağa vurun!"

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "red stone"
msgstr "kırmızı taş"

#. ~ Description for red stone
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A red stone."
msgstr "Bir kırmızı taş."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "green stone"
msgstr "yeşil taş"

#. ~ Description for green stone
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A green stone."
msgstr "Bir yeşil taş."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "blue stone"
msgstr "mavi taş"

#. ~ Description for blue stone
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A blue stone."
msgstr "Bir mavi taş."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "iron ore vein"
msgstr "demir cevheri damarı"

#. ~ Description for iron ore vein
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "Solid rock, with an exposed seam of reddish-brown iron ore."
msgstr ""
"Kırmızımsı kahverengi demir cevheri içeren, yüzeyi açıkta olan sağlam kaya."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "banded-iron ore vein"
msgstr "şeritli demir cevheri damarı"

#. ~ Description for banded-iron ore vein
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "Solid rock, with an exposed seam of brown-red banded-iron ore."
msgstr ""
"Kahverengi-kırmızı şeritli demir cevheri içeren, yüzeyi açıkta olan sağlam "
"kaya."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "copper ore vein"
msgstr "bakır cevheri damarı"

#. ~ Description for copper ore vein
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "Solid rock, with an exposed seam of green copper ore."
msgstr "Yeşil bakır cevheri içeren, yüzeyi açıkta olan sağlam kaya."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "tetrahedrite ore vein"
msgstr "tetrahedrit cevher damarı"

#. ~ Description for tetrahedrite ore vein
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "Solid rock, with an exposed seam of grey tetrahedrite ore."
msgstr "Katı kaya, gri tetrahedrit cevheri içeren açık bir damar."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "chalcopyrite ore vein"
msgstr "kalkopirit cevher damarı"

#. ~ Description for chalcopyrite ore vein
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "Solid rock, with an exposed seam of light-green chalcopyrite ore."
msgstr "Katı kaya, açık yeşil kalkopirit cevheri içeren açık bir damar."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "lead ore vein"
msgstr "kurşun cevher damarı"

#. ~ Description for lead ore vein
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "Solid rock, with an exposed dull gray and yellow seam of lead ore."
msgstr "Katı kaya, mat gri ve sarı kurşun cevheri içeren açık bir damar."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "galena ore vein"
msgstr "galen cevher damarı"

#. ~ Description for galena ore vein
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "Solid rock, with an exposed dull gray seam of galena ore."
msgstr "Katı kaya, mat gri galen cevheri içeren açık bir damar."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "galenau ore vein"
msgstr "galenau cevher damarı"

#. ~ Description for galenau ore vein
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "Solid rock, with an exposed yellow-grey seam of galenau ore."
msgstr "Katı kaya, sarı-gri galenau cevheri içeren açık bir damar."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "tin ore vein"
msgstr "kalay cevheri damarı"

#. ~ Description for tin ore vein
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"Solid rock, with dark gray hints of what you're fairly certain is an ore of "
"tin."
msgstr ""
"Koyu gri kalay cevheri olduğuna oldukça emin olduğunuz ipuçlarıyla dolu katı"
" kaya."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "coppin ore vein"
msgstr "bakır-kalay cevheri damarı"

#. ~ Description for coppin ore vein
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "Solid rock, with a seeming mixture of copper and tin ore."
msgstr "Bakır ve kalay cevheri karışımı gibi görünen katı kaya."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "bronzium ore vein"
msgstr "bronzium cevheri damarı"

#. ~ Description for bronzium ore vein
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"Solid rock, with a seeming mixture of copper and tin ore. Faintly resembles "
"crude bronze."
msgstr ""
"Bakır ve kalay cevheri karışımı gibi görünen katı kaya. Hafifçe ham bronza "
"benziyor."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "silver ore vein"
msgstr "gümüş cevheri damarı"

#. ~ Description for silver ore vein
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"Solid rock, with an exposed gray gleam of silver ore.  There might be a few "
"bits of native silver hidden within, but most of it will need to be "
"processed."
msgstr ""
"Gümüş cevherinin açık gri parıltısına sahip katı kaya. İçinde birkaç parça "
"doğal gümüş gizlenmiş olabilir, ancak çoğunun işlenmesi gerekecek."

#: data/json/furniture_and_terrain/terrain-walls.json
#: data/json/overmap/overmap_terrain/overmap_terrain.json
msgid "gold vein"
msgstr "altın damarı"

#. ~ Description for gold vein
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"Hot damn, you've struck gold!  Gleaming through the rock in its native form,"
" it's almost enough to make one forget how much less valuable it is after "
"the end of the world."
msgstr ""
"Vay canına, altın buldunuz! Kayadan doğal formunda parlıyor, dünyanın "
"sonundan sonra ne kadar az değerli olduğunu unutturacak kadar etkileyici."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "electrumite ore vein"
msgstr "elektrumit cevheri damarı"

#. ~ Description for electrumite ore vein
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "Solid rock, with an exposed silvered yellow gleam of electrumite ore."
msgstr ""
"Katı kaya, üzerinde elektrumit cevherinin gümüş sarısı parıltısı görünen."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "little column"
msgstr "küçük sütun"

#. ~ Description for little column
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A small support column."
msgstr "Küçük bir destek sütunu."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "half-built column"
msgstr "yarı inşa edilmiş sütun"

#. ~ Description for half-built column
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"An empty wooden frame in the shape of a column, built around a concrete and "
"rebar foundation.  It isn't capable of supporting roofs or shelter, and "
"appears to need more resources before being considered complete."
msgstr ""
"Beton ve demir çubuk temeli etrafında inşa edilmiş, sütun şeklinde boş bir "
"ahşap çerçeve. Çatıları veya barınakları destekleme kapasitesine sahip değil"
" ve tamamlanmış olarak kabul edilmesi için daha fazla kaynağa ihtiyaç "
"duyuyor gibi görünüyor."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "column"
msgstr "sütun"

#. ~ Description for column
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A concrete column."
msgstr "Bir beton sütun."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "large metal support"
msgstr "büyük metal destek"

#. ~ Description for large metal support
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A heavy-duty metal support beam."
msgstr "Ağır hizmet tipi bir metal destek kirişi."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "small metal support"
msgstr "küçük metal destek"

#. ~ Description for small metal support
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A metal support beam."
msgstr "Bir metal destek kirişi."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "field stone wall"
msgstr "tarla taşı duvarı"

#. ~ Description for field stone wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A sturdy dry stone wall.  Just rocks fitted together without mortar."
msgstr ""
"Sağlam bir kuru taş duvar. Harç kullanılmadan sadece taşlar birbirine "
"oturtulmuş."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "field stone half-wall"
msgstr "tarla taşı yarım duvar"

#. ~ Description for field stone half-wall
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A half height sturdy dry stone wall.  Just rocks fitted together without "
"mortar.  Complete as is or with extensive work it could be doubled in "
"height."
msgstr ""
"Yarım yükseklikte sağlam bir kuru taş duvar. Harç kullanılmadan sadece "
"taşlar birbirine oturtulmuş. Olduğu gibi tamamlanabilir veya kapsamlı bir "
"çalışma ile yüksekliği iki katına çıkarılabilir."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "pillar"
msgstr "sütun"

#. ~ Description for pillar
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A concrete column that helps keep the mine's ceiling and walls from "
"collapsing."
msgstr ""
"Madenin tavanını ve duvarlarını çökmeden korumaya yardımcı olan bir beton "
"sütun."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "wooden fortification"
msgstr "ahşap tahkimat"

#. ~ Description for wooden fortification
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A wooden wall with a firing hole carved out of it, which you can fire "
"through unimpeded if you're adjacent to it.  It doesn't take much out of "
"incoming fire, but it's better than nothing."
msgstr ""
"Üzerine ateş edebileceğiniz bir ateş deliği oyulmuş ahşap bir duvar. Yanında"
" olduğunuzda gelen ateşi çok fazla engellemez, ama hiç yoktan iyidir."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "underwater wooden fortification"
msgstr "su altı ahşap tahkimat"

#. ~ Description for underwater wooden fortification
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A waterlogged gunport from the age of sail.  If you have a speargun to fire "
"through it with, it might still serve as light cover against any unexpected "
"encounters with gun-toting sharks."
msgstr ""
"Yelken çağından kalma suya doymuş bir top mazgalı. Eğer içinden ateş "
"edebileceğiniz bir zıpkınınız varsa, silahlı köpekbalıklarıyla beklenmedik "
"karşılaşmalara karşı hafif bir koruma sağlayabilir."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "log fortification"
msgstr "kütük tahkimat"

#. ~ Description for log fortification
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"Stout timbers with a firing hole carved into it, letting you fire unimpeded "
"if you're adjacent to it.  Provides pretty good cover, but might falter "
"against higher-end firepower."
msgstr ""
"Yanında olduğunuzda kesintisiz ateş etmenizi sağlayan bir ateş deliği "
"oyulmuş sağlam kütükler. Oldukça iyi bir koruma sağlar, ancak yüksek güçlü "
"ateş gücüne karşı zayıf kalabilir."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "field stone fortification"
msgstr "tarla taşı tahkimatı"

#. ~ Description for field stone fortification
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A sturdy dry stone wall with a firing hole chiseled out, letting you fire "
"unhindered when adjacent to it.  Basic as it may be, simple stones provide "
"effective cover."
msgstr ""
"Yanında olduğunuzda kesintisiz ateş etmenizi sağlayan bir ateş deliği "
"yontulmuş sağlam bir kuru taş duvar. Basit olabilir, ancak basit taşlar "
"etkili bir koruma sağlar."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "stone fortification"
msgstr "taş tahkimat"

#. ~ Description for stone fortification
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A sturdy stone wall with a firing hole chiseled out, letting you fire "
"unhindered when adjacent to it.  An excellent source of cover against "
"anything short of siege weapons."
msgstr ""
"Yanında olduğunuzda kesintisiz ateş etmenizi sağlayan bir ateş deliği "
"yontulmuş sağlam bir taş duvar. Kuşatma silahları dışında her şeye karşı "
"mükemmel bir koruma kaynağıdır."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "brick fortification"
msgstr "tuğla tahkimat"

#. ~ Description for brick fortification
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A solid brick wall with a firing hole built into it, providing an opening to"
" shoot through unimpeded while adjacent to it.  A sturdy source of cover "
"against incoming fire."
msgstr ""
"Yanında olduğunuzda kesintisiz ateş etmenizi sağlayan bir ateş deliği "
"bulunan sağlam bir tuğla duvar. Gelen ateşe karşı sağlam bir koruma "
"kaynağıdır."

#: data/json/furniture_and_terrain/terrain-walls.json
msgid "adobe fortification"
msgstr "kerpiç tahkimat"

#. ~ Description for adobe fortification
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"A solid adobe brick wall with a firing hole built into it, providing an "
"opening to fire through when adjacent to it.  Fairly solid cover against "
"muskets and most small arms alike."
msgstr ""
"Yanında durulduğunda ateş etmek için bir açıklık sağlayan, ateş deliği "
"bulunan sağlam bir kerpiç tuğla duvar. Tüfeklere ve çoğu küçük silaha karşı "
"oldukça sağlam bir koruma sağlar."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "window"
msgstr "pencere"

#. ~ Description for window
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A giant sheet of glass inserted into a window, typically found on the side "
"of shops to showcase goods."
msgstr ""
"Genellikle mağazaların yan tarafında malları sergilemek için kullanılan, "
"pencereye yerleştirilmiş dev bir cam levha."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "taped window"
msgstr "bantlanmış pencere"

#. ~ Description for taped window
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"Duct tape covers this window, blocking sunlight and visibility.  You could "
"remove the duct tape by cutting it off."
msgstr ""
"Bu pencere, güneş ışığını ve görünürlüğü engelleyen koli bandıyla kaplanmış."
" Bandı keserek çıkarabilirsiniz."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "window with curtains"
msgstr "perdeli pencere"

#. ~ Description for window with curtains
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A window with fancy curtains on the inside that can be drawn closed to block"
" visibility and shut out any light."
msgstr ""
"İç kısmında şık perdeler bulunan, görünürlüğü engellemek ve ışığı kesmek "
"için kapatılabilen bir pencere."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "You pry open the window."
msgstr "Pencereyi zorlayarak açıyorsunuz."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "You pry, but cannot pry open the window."
msgstr "Zorlamanıza rağmen pencereyi açamıyorsunuz."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "window without curtains"
msgstr "perdesiz pencere"

#. ~ Description for window without curtains
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A smaller window typically found in residential homes.  You could install a "
"curtain rod and drapes if you had the supplies and skill."
msgstr ""
"Genellikle konutlarda bulunan daha küçük bir pencere. Malzeme ve beceriniz "
"varsa bir perde çubuğu ve perde takabilirsiniz."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "open window without curtains"
msgstr "perdesiz açık pencere"

#. ~ Description for open window without curtains
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A smaller window typically found in residential homes.  It's open and can be"
" crawled through."
msgstr ""
"Genellikle konutlarda bulunan daha küçük bir pencere. Açık ve içinden "
"sürünerek geçilebilir."

#. ~ Description for taped window
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A smaller window typically found in residential homes.  This one has been "
"blocked out with duct tape.  You could remove the duct tape by cutting it "
"off."
msgstr ""
"Genellikle konutlarda bulunan daha küçük bir pencere. Bu, koli bandıyla "
"kapatılmış. Koli bandını keserek çıkarabilirsiniz."

#. ~ Description for taped window
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"An empty window.  This one has been blocked out with duct tape.  You could "
"remove the duct tape by cutting it off."
msgstr ""
"Boş bir pencere. Bu, koli bandıyla kapatılmış. Koli bandını keserek "
"çıkarabilirsiniz."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "taped glass wall"
msgstr "bantlanmış cam duvar"

#. ~ Description for taped glass wall
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A glass wall.  This one has been blocked out with duct tape.  You could "
"remove the duct tape by cutting it off."
msgstr ""
"Bir cam duvar. Bu, koli bandıyla kapatılmış. Koli bandını keserek "
"çıkarabilirsiniz."

#. ~ Description for taped window
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A window with fancy curtains on the inside.  This one has been blocked out "
"with duct tape.  You could remove the duct tape by cutting it off."
msgstr ""
"İçeride şık perdeleri olan bir pencere. Bu, koli bandıyla kapatılmış. Koli "
"bandını keserek çıkarabilirsiniz."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "open window with curtains"
msgstr "perdeli açık pencere"

#. ~ Description for open window with curtains
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A window with fancy curtains on the inside that can be drawn closed to block"
" visibility and shut out any light.  It's open and you can crawl through."
msgstr ""
"İçeride şık perdeleri olan, görünürlüğü engellemek ve ışığı kesmek için "
"kapatılabilen bir pencere. Açık ve içinden sürünerek geçebilirsin."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "window with closed curtains"
msgstr "kapalı perdeli pencere"

#. ~ Description for window with closed curtains
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A window with fancy curtains that have been drawn shut, blocking sunlight "
"and visibility.  The curtains can only be opened on the inside.  If you "
"examined the curtains more closely, you could peek through the drapes or "
"tear down everything.  Or you could just smash the window open."
msgstr ""
"Görünürlüğü ve güneş ışığını engelleyen, kapatılmış şık perdeleri olan bir "
"pencere. Perdeler sadece içeriden açılabilir. Perdeleri daha yakından "
"incelersen, aralarından göz atabilir veya her şeyi yırtabilirsin. Ya da "
"pencereyi kırarak açabilirsin."

#. ~ Description for taped window
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"Duct tape covers this window, blocking out any sunlight and visibility.  You"
" could remove the duct tape by cutting it off."
msgstr ""
"Bu pencereyi kaplayan bant, güneş ışığını ve görünürlüğü engelliyor. Bandı "
"keserek çıkarabilirsin."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "empty window"
msgstr "boş pencere"

#. ~ Description for empty window
#. ~ Description for empty domestic window
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"An empty window frame consisting of two by fours and nails.  You could "
"install a sheet of glass, or even board it up for protection.  You could "
"also convert it into a wall if you took the time to construct it."
msgstr ""
"İki dört ve çivilerden oluşan boş bir pencere çerçevesi. Bir cam levha "
"takabilir veya koruma için kapatabilirsin. Zaman ayırırsan, duvara da "
"dönüştürebilirsin."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "empty domestic window"
msgstr "boş ev penceresi"

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "window frame"
msgstr "pencere çerçevesi"

#. ~ Description for window frame
#. ~ Description for domestic window frame
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A wooden window frame that has shattered glass around it.  You'll probably "
"get hurt if you crawled through the sharp and jagged shards.  You could "
"smash out the remaining pieces, or take your time and quietly clean them up."
msgstr ""
"Etrafında kırık camlar olan ahşap bir pencere çerçevesi. Keskin ve sivri cam"
" parçalarından geçersen muhtemelen yaralanırsın. Kalan parçaları kırabilir "
"veya zaman ayırıp sessizce temizleyebilirsin."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "glass crunching!"
msgstr "cam kırılması!"

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "domestic window frame"
msgstr "ev tipi pencere çerçevesi"

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "boarded up window"
msgstr "tahtalarla kapatılmış pencere"

#. ~ Description for boarded up window
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A glass window that has been covered with nailed down planks, blocking "
"sunlight and visibility.  It's not much stronger, but it could be further "
"reinforced with strategically placed two by fours."
msgstr ""
"Çivilerle sabitlenmiş tahtalarla kapatılmış bir cam pencere, güneş ışığını "
"ve görüşü engelliyor. Çok daha güçlü değil, ancak stratejik olarak "
"yerleştirilmiş ikiye dörtlüklerle daha da güçlendirilebilir."

#. ~ Description for boarded up window
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"An empty window frame that has been covered with nailed down planks, "
"blocking sunlight and visibility.  It's not much stronger, but it could be "
"further reinforced with strategically placed two by fours."
msgstr ""
"Çivilerle sabitlenmiş tahtalarla kapatılmış boş bir pencere çerçevesi, güneş"
" ışığını ve görüşü engelliyor. Çok daha güçlü değil, ancak stratejik olarak "
"yerleştirilmiş ikiye dörtlüklerle daha da güçlendirilebilir."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "reinforced boarded up window"
msgstr "güçlendirilmiş tahtalarla kapatılmış pencere"

#. ~ Description for reinforced boarded up window
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A heavily fortified glass window with carefully placed planks across the "
"glass to block vision.  Adding a few spikes and metal plating would further "
"increase its durability."
msgstr ""
"Camın üzerine dikkatlice yerleştirilmiş tahtalarla görüşü engelleyen, ağır "
"şekilde güçlendirilmiş bir cam pencere. Birkaç çivi ve metal kaplama eklemek"
" dayanıklılığını daha da artıracaktır."

#. ~ Description for reinforced boarded up window
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A heavily fortified window with carefully placed planks across the open "
"frame to block vision.  Adding a few spikes and metal plating would further "
"increase its durability."
msgstr ""
"Açık çerçeve üzerine dikkatlice yerleştirilmiş tahtalarla görüşü engelleyen,"
" ağır şekilde güçlendirilmiş bir pencere. Birkaç çivi ve metal kaplama "
"eklemek dayanıklılığını daha da artıracaktır."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "armored boarded up window"
msgstr "zırhlı tahtalarla kapatılmış pencere"

#. ~ Description for armored boarded up window
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"This once normal glass window now menaces with spikes along the edges, with "
"laboriously placed metal sheeting to further strengthen the wooden "
"reinforcements underneath."
msgstr ""
"Bir zamanlar normal olan bu cam pencere, kenarlarında çivilerle tehditkar "
"hale gelmiş, altındaki ahşap güçlendirmeleri daha da sağlamlaştırmak için "
"özenle yerleştirilmiş metal levhalarla güçlendirilmiştir."

#. ~ Description for armored boarded up window
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"This once normal window frame now menaces with spikes along the edges, with "
"laboriously placed metal sheeting to further strengthen the wooden "
"reinforcements underneath."
msgstr ""
"Bir zamanlar normal olan bu pencere çerçevesi, kenarlarında çivilerle "
"tehditkar hale gelmiş, altındaki ahşap güçlendirmeleri daha da "
"sağlamlaştırmak için özenle yerleştirilmiş metal levhalarla "
"güçlendirilmiştir."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "window frame with metal bars"
msgstr "metal çubuklu pencere çerçevesi"

#. ~ Description for window frame with metal bars
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A window frame with thick security grilles, making it impossible to crawl "
"through.  Typically installed for high-value stores, or at least stores in "
"bad neighborhoods."
msgstr ""
"Kalın güvenlik parmaklıklarına sahip bir pencere çerçevesi, içinden geçmeyi "
"imkansız hale getiriyor. Genellikle yüksek değerli mağazalar için veya en "
"azından kötü mahallelerdeki mağazalar için kurulur."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "window with metal bars"
msgstr "metal çubuklu pencere"

#. ~ Description for window with metal bars
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A giant sheet of glass inserted into a window with thick security grilles, "
"making it impossible to crawl through.  Typically installed for high-value "
"stores, or at least stores in bad neighborhoods.  This one has a small "
"sticker in a corner stating, 'Protected by AtmoWeb, leading AI in "
"terminating crime'."
msgstr ""
"Kalın güvenlik parmaklıklarına sahip bir pencereye yerleştirilmiş dev bir "
"cam levha, içinden geçmeyi imkansız hale getiriyor. Genellikle yüksek "
"değerli mağazalar için veya en azından kötü mahallelerdeki mağazalar için "
"kurulur. Bu pencerenin bir köşesinde 'Suçları Sonlandırmada Lider AI, "
"AtmoWeb Tarafından Korunmaktadır' yazan küçük bir çıkartma var."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "window with metal bars and curtains"
msgstr "metal çubuklu ve perdeli pencere"

#. ~ Description for window with metal bars and curtains
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A barred window with fancy curtains that have been drawn shut, blocking "
"sunlight and visibility.  The curtains can only be opened on the inside.  If"
" you examined the curtains more closely, you could peek through the drapes "
"or tear down everything."
msgstr ""
"Güneş ışığını ve görünürlüğü engelleyen, kapatılmış şık perdeleri olan "
"parmaklıklı bir pencere. Perdeler sadece içeriden açılabilir. Perdeleri daha"
" yakından incelerseniz, perdelerin arasından bakabilir veya her şeyi "
"yırtabilirsiniz."

#. ~ Description for window with metal bars and curtains
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A giant sheet of glass inserted into a window with thick security grilles, "
"making it impossible to crawl through.  Typically installed for high-value "
"stores, or at least stores in bad neighborhoods.  This one has been "
"retrofitted with curtains."
msgstr ""
"Kalın güvenlik parmaklıklarına sahip bir pencereye yerleştirilmiş dev bir "
"cam levha, içinden geçmeyi imkansız hale getiriyor. Genellikle yüksek "
"değerli mağazalar için veya en azından kötü mahallelerdeki mağazalar için "
"kurulur. Bu pencere perdelerle donatılmıştır."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "high stained glass window"
msgstr "yüksek vitray pencere"

#. ~ Description for high stained glass window
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"Breathtaking craftsmanship of stained glass featuring an elegant emerald "
"landscape."
msgstr "Zümrüt bir manzarayı tasvir eden nefes kesici vitray işçiliği."

#. ~ Description for high stained glass window
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"Breathtaking craftsmanship of stained glass featuring an otherworldly "
"radiant ruby flower blooming."
msgstr ""
"Diğer dünyadan gelen ışıldayan bir yakut çiçeğinin açılışını tasvir eden "
"nefes kesici vitray işçiliği."

#. ~ Description for high stained glass window
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"Breathtaking craftsmanship of stained glass featuring an alluring azure "
"oceanic abyss."
msgstr ""
"Büyüleyici bir mavi okyanus uçurumunu tasvir eden nefes kesici vitray "
"işçiliği."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "Window with metal grate"
msgstr "Metal parmaklıklı pencere"

#. ~ Description for Window with metal grate
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"Metal bars made into a grate for a window, highly durable and will stand "
"against any foe."
msgstr ""
"Pencere için yapılmış metal çubuklardan oluşan bir ızgara, son derece "
"dayanıklıdır ve her düşmana karşı duracaktır."

#. ~ Description for Window with metal grate
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"Metal bars made into a grate for a window with a closed curtain, highly "
"durable and will stand against any foe."
msgstr ""
"Kapalı perde ile pencere için yapılmış metal çubuklardan oluşan bir ızgara, "
"son derece dayanıklıdır ve her düşmana karşı duracaktır."

#. ~ Description for Window with metal grate
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"Metal bars made into a grate for a window with a opened curtain, highly "
"durable and will stand against any foe."
msgstr ""
"Açık perde ile pencere için yapılmış metal çubuklardan oluşan bir ızgara, "
"son derece dayanıklıdır ve her düşmana karşı duracaktır."

#. ~ Description for Window with metal grate
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"Metal bars made into a grate for a window with a opened curtain, Highly "
"durability and will stand against any foe"
msgstr ""
"Açık perde ile pencere için yapılmış metal çubuklardan oluşan bir ızgara, "
"son derece dayanıklıdır ve her düşmana karşı duracaktır."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "plastic window"
msgstr "Plastik pencere"

#. ~ Description for plastic window
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A makeshift window comprising a sheet of translucent, rigid plastic secured "
"in a wooden frame.  It'll do in a pinch."
msgstr ""
"Ahşap bir çerçeveye sabitlenmiş yarı saydam, sert plastik bir levhadan "
"oluşan geçici bir pencere. Acil durumda iş görür."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "open plastic window"
msgstr "Açık plastik pencere"

#. ~ Description for open plastic window
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"An opened makeshift window comprising a sheet of translucent, rigid plastic "
"secured in a wooden frame.  It'll do in a pinch."
msgstr ""
"Ahşap bir çerçeveye sabitlenmiş yarı saydam, sert plastik bir levhadan "
"oluşan açık bir geçici pencere. Acil durumda iş görür."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "plastic window with closed curtains"
msgstr "kapalı perdeli plastik pencere"

#. ~ Description for plastic window with closed curtains
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A makeshift window with a closed curtain.  Comprising a sheet of "
"translucent, rigid plastic secured in a wooden frame.  There are sheets "
"drawn across it to block the light.  It'll do in a pinch."
msgstr ""
"Kapalı perdeli geçici bir pencere. Şeffaf, sert plastik bir levhadan oluşur "
"ve ahşap bir çerçeveye sabitlenmiştir. Işığı engellemek için üzerine "
"çekilmiş perdeler vardır. Acil durumlar için iş görür."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "plastic window with curtains"
msgstr "perdeli plastik pencere"

#. ~ Description for plastic window with curtains
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A makeshift window with an opened curtain.  Comprising a sheet of "
"translucent, rigid plastic secured in a wooden frame, with sheets strung "
"about it to block the light as required.  It'll do in a pinch."
msgstr ""
"Açık perdeli geçici bir pencere. Şeffaf, sert plastik bir levhadan oluşur ve"
" ahşap bir çerçeveye sabitlenmiştir, gerektiğinde ışığı engellemek için "
"üzerine çekilmiş perdeler vardır. Acil durumlar için iş görür."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "open plastic window with curtains"
msgstr "açık perdeli plastik pencere"

#. ~ Description for open plastic window with curtains
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"An opened makeshift window with an opened curtain.  Comprising a sheet of "
"translucent, rigid plastic secured in a wooden frame, with sheets strung "
"about it to block the light as required.  It'll do in a pinch."
msgstr ""
"Açık perdeli, açık geçici bir pencere. Şeffaf, sert plastik bir levhadan "
"oluşur ve ahşap bir çerçeveye sabitlenmiştir, gerektiğinde ışığı engellemek "
"için üzerine çekilmiş perdeler vardır. Acil durumlar için iş görür."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "reinforced plastic window"
msgstr "güçlendirilmiş plastik pencere"

#. ~ Description for reinforced plastic window
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A makeshift window comprising three sheets of translucent, rigid plastic "
"secured in a wooden frame.  It'll do in a pinch."
msgstr ""
"Üç adet şeffaf, sert plastik levhadan oluşan ve ahşap bir çerçeveye "
"sabitlenmiş geçici bir pencere. Acil durumlar için iş görür."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "open reinforced plastic window"
msgstr "açık güçlendirilmiş plastik pencere"

#. ~ Description for open reinforced plastic window
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"An open makeshift window comprising three sheets of translucent, rigid "
"plastic secured in a wooden frame.  It'll do in a pinch."
msgstr ""
"Üç adet şeffaf, sert plastik levhadan oluşan ve ahşap bir çerçeveye "
"sabitlenmiş açık geçici bir pencere. Acil durumlar için iş görür."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "reinforced plastic window with closed curtains"
msgstr "kapalı perdeli güçlendirilmiş plastik pencere"

#. ~ Description for reinforced plastic window with closed curtains
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A makeshift window with a closed curtain.  Comprising three sheets of "
"translucent, rigid plastic secured in a wooden frame.  It'll do in a pinch."
msgstr ""
"Geçici bir pencere, kapalı bir perde ile. Üç adet yarı saydam, sert plastik "
"levhadan oluşur ve ahşap bir çerçeveye sabitlenmiştir. Acil durumlar için iş"
" görür."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "reinforced plastic window with curtains"
msgstr "perdeli güçlendirilmiş plastik pencere"

#. ~ Description for reinforced plastic window with curtains
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A makeshift window with an opened curtain.  Comprising three sheets of "
"translucent, rigid plastic secured in a wooden frame.  It'll do in a pinch."
msgstr ""
"Geçici bir pencere, açık bir perde ile. Üç adet yarı saydam, sert plastik "
"levhadan oluşur ve ahşap bir çerçeveye sabitlenmiştir. Acil durumlar için iş"
" görür."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "open reinforced plastic window with curtains"
msgstr "açık perdeli güçlendirilmiş plastik pencere"

#. ~ Description for open reinforced plastic window with curtains
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"An open makeshift window with a opened curtain.  Comprising three sheets of "
"translucent, rigid plastic secured in a wooden frame.  It'll do in a pinch."
msgstr ""
"Açık bir geçici pencere, açık bir perde ile. Üç adet yarı saydam, sert "
"plastik levhadan oluşur ve ahşap bir çerçeveye sabitlenmiştir. Acil durumlar"
" için iş görür."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "Skylight frame"
msgstr "Çatı penceresi çerçevesi"

#. ~ Description for Skylight frame
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "A wooden skylight frame."
msgstr "Ahşap bir çatı penceresi çerçevesi."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "Tempered glass window"
msgstr "Temperli cam pencere"

#. ~ Description for Tempered glass window
#. ~ Description for Tempered glass window open
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "A giant sheet of tempered glass inserted into a window frame."
msgstr "Bir pencere çerçevesine yerleştirilmiş devasa bir temperli cam levha."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "Tempered glass window open"
msgstr "Temperli cam pencere açık"

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "tempered glass window with a curtain"
msgstr "perdeli temperli cam pencere"

#. ~ Description for tempered glass window with a curtain
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A tempered window with fancy curtains on the inside that are closed to block"
" visibility and shut out any light."
msgstr ""
"İç kısmında şatafatlı perdeler bulunan, görünürlüğü engellemek ve ışığı "
"kesmek için kapalı olan temperli pencere."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "Tempered glass window with a curtain"
msgstr "Perdeli temperli cam pencere"

#. ~ Description for Tempered glass window with a curtain
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A tempered window with fancy curtains on the inside that can be drawn closed"
" to block visibility and shut out any light."
msgstr ""
"İç kısmında şatafatlı perdeler bulunan, görünürlüğü engellemek ve ışığı "
"kesmek için kapatılabilen temperli pencere."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "porthole"
msgstr "lumboz"

#. ~ Description for porthole
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A thick round window surrounded with a strong metal frame, the window is "
"sealed closed."
msgstr ""
"Güçlü bir metal çerçeve ile çevrili kalın yuvarlak pencere, pencere sıkıca "
"kapatılmış."

#: data/json/furniture_and_terrain/terrain-windows.json
msgid "underwater porthole"
msgstr "su altı lumbozu"

#. ~ Description for underwater porthole
#: data/json/furniture_and_terrain/terrain-windows.json
msgid ""
"A thick round window surrounded with a strong metal frame, the window seems "
"to be leaking a bit."
msgstr ""
"Güçlü bir metal çerçeve ile çevrili kalın yuvarlak pencere, pencere biraz "
"sızdırıyor gibi görünüyor."

#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
msgid "wooden stairs"
msgstr "ahşap merdivenler"

#. ~ Description for wooden stairs
#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
msgid "A wooden staircase leading down."
msgstr "Aşağıya inen ahşap bir merdiven."

#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
msgid "half-built wooden stairs"
msgstr "yarı inşa edilmiş ahşap merdivenler"

#. ~ Description for half-built wooden stairs
#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
msgid ""
"Half of a wooden staircase.  Some work still needs to be done before this "
"staircase is complete."
msgstr ""
"Ahşap bir merdivenin yarısı. Bu merdivenin tamamlanması için hala biraz "
"çalışma gerekiyor."

#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
msgid "broken wooden stairs"
msgstr "kırık ahşap merdivenler"

#. ~ Description for broken wooden stairs
#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
msgid ""
"A number of planks are missing and the structure is beginning to sag and "
"fall apart.  It's going to need quite a bit of work to repair this "
"staircase."
msgstr ""
"Birçok tahta eksik ve yapı sarkmaya ve parçalanmaya başlamış. Bu merdiveni "
"onarmak için oldukça fazla çalışma gerekecek."

#. ~ Description for wooden stairs
#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
msgid "A wooden staircase leading up"
msgstr "Yukarıya çıkan ahşap bir merdiven"

#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
msgid "stairs"
msgstr "merdivenler"

#. ~ Description for stairs
#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
msgid "A flight of stairs leading down with no roof."
msgstr "Çatısı olmayan, aşağıya inen bir merdiven."

#. ~ Description for stairs
#. ~ Description for underwater stairs
#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
msgid "A flight of stairs leading down."
msgstr "Aşağıya inen bir merdiven."

#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
msgid "underwater stairs"
msgstr "su altı merdivenleri"

#. ~ Description for stairs
#. ~ Description for underwater stairs
#. ~ Description for low stairs (beginning section)
#. ~ Description for low stairs (end section)
#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
msgid "A flight of stairs leading up."
msgstr "Yukarıya çıkan bir merdiven."

#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
msgid "manhole"
msgstr "rögar kapağı"

#. ~ Description for manhole
#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
msgid ""
