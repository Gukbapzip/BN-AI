msgstr ""
"Hem pişirme hem de servis için yapılmış seramik bir tencere, özellikle tek "
"kap yemekleri için."

#: data/json/items/generic/dining_kitchen.json
msgid "stock pot"
msgid_plural "stock pots"
msgstr[0] "stok tenceresi"
msgstr[1] "stok tencereleri"

#. ~ Description for {'str': 'stock pot'}
#: data/json/items/generic/dining_kitchen.json
