msgstr[0] "yangın çıkarıcı ev yapımı roket"
msgstr[1] "yangın çıkarıcı ev yapımı roketler"

#. ~ Description for {'str': 'incendiary homemade rocket'}
#: data/json/items/ammo.json
msgid ""
