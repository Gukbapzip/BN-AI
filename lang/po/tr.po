#, c-format
msgid "The %s shocks you!"
msgstr "%s, sizi şok ediyor!"

#: src/monattack.cpp
#, c-format
msgid "The %s shocks <npcname>!"
msgstr "%s, <npcname>'i şok ediyor!"

#: src/monattack.cpp
msgid "beep-beep."
msgstr "bip-bip."

#: src/monattack.cpp
msgid "a chk!"
msgstr "bir chk!"

#: src/monattack.cpp
msgid "boop!"
msgstr "boop!"

