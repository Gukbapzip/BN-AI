msgstr[0] "demir cirit"
msgstr[1] "demir ciritler"

#. ~ Description for {'str': 'iron javelin'}
#: data/json/items/melee/spears_and_polearms.json
msgid ""
"An iron-tipped wooden throwing spear.  The grip area has been carved and "
"covered for better grip."
msgstr ""
"Demir uçlu ahşap bir fırlatma mızrağı. Kavrama alanı daha iyi tutuş için "
"oyulmuş ve kaplanmıştır."

#: data/json/items/melee/spears_and_polearms.json
