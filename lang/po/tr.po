msgstr "Tepsiden eti hasat ediyorsunuz."

#. ~ Use action not_ready_msg for {'str': 'dehydrating meat tray'}.
#: data/json/items/tool/cooking.json
msgid "The meat isn't done drying yet."
msgstr "Et henüz kuruma işlemini tamamlamadı."

#. ~ Description for {'str': 'dehydrating meat tray'}
#: data/json/items/tool/cooking.json
msgid "A tray of dehydrating meat. Harvest it once it's fully dried out."
msgstr "Kuruyan et tepsisi. Tamamen kuruduğunda hasat edin."

#: data/json/items/tool/cooking.json
msgid "dehydrating vegetable tray"
msgid_plural "dehydrating vegetable trays"
msgstr[0] "sebze kurutma tepsisi"
msgstr[1] "sebze kurutma tepsileri"

#. ~ Use action msg for {'str': 'dehydrating vegetable tray'}.
#: data/json/items/tool/cooking.json
msgid "You harvest the vegetables off of the tray."
msgstr "Tepsiden sebzeleri hasat ediyorsunuz."

#. ~ Use action not_ready_msg for {'str': 'dehydrating vegetable tray'}.
#: data/json/items/tool/cooking.json
msgid "The vegetables aren't done drying yet."
msgstr "Sebzeler henüz kuruma işlemini tamamlamadı."

#. ~ Description for {'str': 'dehydrating vegetable tray'}
#: data/json/items/tool/cooking.json
msgid ""
"A tray of dehydrating vegetables. Harvest it once it's fully dried out."
msgstr "Kuruyan sebze tepsisi. Tamamen kuruduğunda hasat edin."

#: data/json/items/tool/cooking.json
msgid "dehydrating fruit tray"
msgid_plural "dehydrating fruit trays"
msgstr[0] "meyve kurutma tepsisi"
msgstr[1] "meyve kurutma tepsileri"

#. ~ Use action msg for {'str': 'dehydrating fruit tray'}.
#: data/json/items/tool/cooking.json
msgid "You harvest the fruit off of the tray."
msgstr "Tepsiden meyveyi hasat ediyorsunuz."

#. ~ Use action not_ready_msg for {'str': 'dehydrating fruit tray'}.
#: data/json/items/tool/cooking.json
msgid "The fruit isn't done drying yet."
msgstr "Meyve henüz kuruma işlemini tamamlamadı."

#. ~ Description for {'str': 'dehydrating fruit tray'}
#: data/json/items/tool/cooking.json
msgid "A tray of dehydrating fruit. Harvest it once it's fully dried out."
msgstr "Kuruyan meyve tepsisi. Tamamen kuruduğunda hasat et."

