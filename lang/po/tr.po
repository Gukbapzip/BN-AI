msgstr[1] "dökme demir tencereler"

#. ~ Description for {'str': 'cast-iron pot'}
#: data/json/items/generic/dining_kitchen.json
msgid ""
"This hefty black pot is made from cast iron and coated in a sturdy enamel."
msgstr ""
"Bu ağır siyah tencere, dökme demirden yapılmış ve sağlam bir emaye ile "
