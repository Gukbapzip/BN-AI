msgstr[1] "süvari kılıcı sahteleri"

#. ~ Description for {'str': 'cavalry saber fake'}
#: data/json/items/melee/swords_and_blades.json
msgid ""
"This is a dull, cheap replica of a curved sword associated with cavalry, "
"from the Early Modern period onwards."
msgstr ""
"Bu, Erken Modern dönemden itibaren süvariyle ilişkilendirilen kavisli bir "
"kılıcın donuk, ucuz bir replikasıdır."

#: data/json/items/melee/swords_and_blades.json
msgid "kris"
msgid_plural "krises"
msgstr[0] "kris"
msgstr[1] "krisler"

#. ~ Description for {'str': 'kris', 'str_pl': 'krises'}
#: data/json/items/melee/swords_and_blades.json
msgid ""
"This wavy bladed dagger comes from Southeast Asia.  The design of the blade "
"causes it to make broad, painful wounds."
msgstr ""
"Bu dalgalı bıçaklı hançer Güneydoğu Asya'dan gelmektedir. Bıçağın tasarımı "
"geniş ve acı verici yaralar açmasına neden olur."

#: data/json/items/melee/swords_and_blades.json
msgid "kris fake"
msgid_plural "kris fakes"
msgstr[0] "kris sahte"
msgstr[1] "kris sahteleri"

#. ~ Description for {'str': 'kris fake'}
#: data/json/items/melee/swords_and_blades.json
msgid ""
"This is a dull, cheap replica of a wavy bladed dagger that comes from "
"Southeast Asia."
msgstr ""
"Bu, Güneydoğu Asya'dan gelen dalgalı bıçaklı bir hançerin donuk, ucuz bir "
"replikasıdır."

#: data/json/items/melee/swords_and_blades.json
msgid "kukri"
msgid_plural "kukris"
msgstr[0] "kukri"
msgstr[1] "kukriler"

#. ~ Description for {'str': 'kukri'}
#: data/json/items/melee/swords_and_blades.json
