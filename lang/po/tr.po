msgstr "Kuruyan balık tepsisi. Tamamen kuruduğunda hasat et."

#: data/json/items/tool/cooking.json
msgid "dehydrating tainted meat tray"
msgid_plural "dehydrating tainted meat trays"
msgstr[0] "bozulmuş et kurutma tepsisi"
msgstr[1] "bozulmuş et kurutma tepsileri"

#. ~ Use action msg for {'str': 'dehydrating tainted meat tray'}.
