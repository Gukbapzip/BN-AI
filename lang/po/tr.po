msgid_plural "homemade hot dogs"
msgstr[0] "ev yapımı sosisli sandviç"
msgstr[1] "ev yapımı sosisli sandviçler"

#: data/json/items/comestibles/offal_dishes.json
msgid "fried offal"
msgid_plural "fried offal"
msgstr[0] "kızarmış sakatat"
msgstr[1] "kızarmış sakatatlar"

#. ~ Conditional name for {'str_sp': 'fried offal'} when VITAMIN matches
#. human_flesh_vitamin
