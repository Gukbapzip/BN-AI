msgstr ""
"Bu kase, ağzı oluşturan açıklığıyla aptal bir kurbağa kafası şeklindedir."

#: data/json/items/generic/dining_kitchen.json
msgid "There are cute farm animals decorating this bowl."
msgstr "Bu kaseyi süsleyen sevimli çiftlik hayvanları var."

