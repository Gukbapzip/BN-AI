#: data/json/professions.json
msgctxt "profession_male"
msgid "Landscaper"
msgstr "Peyzajcı"

#: data/json/professions.json
msgctxt "profession_female"
msgid "Landscaper"
msgstr "Peyzajcı"

#. ~ Profession (male Landscaper) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You used to mow lawns and trim hedges for the wealthy.  Contract work was "
"getting scarce even before the zombies came, but now you've got nothing left"
" but your tools and expertise."
msgstr ""
"Zenginler için çim biçiyor ve çitleri buduyordunuz. Sözleşmeli işler, "
"zombiler gelmeden önce bile azalmaya başlamıştı, ama şimdi elinizde sadece "
"aletleriniz ve uzmanlığınız kaldı."

