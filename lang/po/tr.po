#: data/json/professions.json
msgctxt "profession_male"
msgid "Escapee"
msgstr "Kaçak"

#: data/json/professions.json
msgctxt "profession_female"
msgid "Escapee"
msgstr "Kaçak"

#. ~ Profession (male Escapee) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You've been held in this alien hellhole for a couple days, picking at the "
"walls until you found a loose piece you could fashion into a shiv.  You're "
"getting dizzy from the stifling heat and fumes, it's now or never."
msgstr ""
"Bu uzaylı cehenneminde birkaç gündür tutuluyorsun, duvarları kazıyarak bir "
"şiv haline getirebileceğin gevşek bir parça bulana kadar uğraştın. Boğucu "
"sıcak ve dumanlardan başın dönüyor, ya şimdi ya hiç."

#. ~ Profession (female Escapee) description
#: data/json/professions.json
msgctxt "prof_desc_female"
