msgid_plural "debug grenades"
msgstr[0] "hata ayıklama bombası"
msgstr[1] "hata ayıklama bombaları"

#. ~ Description for {'str': 'debug grenade'}
#: data/mods/CrazyCataclysm/crazy_items.json
msgid ""
"Attached to this grenade is a tag with 'debug' written on it.  Does not seem"
" to work like a grenade, handle with care."
msgstr ""
"Bu bombaya 'hata ayıklama' yazılı bir etiket iliştirilmiş. Bir bomba gibi "
"çalışmıyor gibi görünüyor, dikkatli kullanın."

#: data/mods/CrazyCataclysm/crazy_items.json
