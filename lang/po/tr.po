msgstr "<npcname> biraz kan kaybediyor."

#: src/player_hardcoded_effects.cpp
msgid "You feel a little strange."
msgstr "Kendini biraz garip hissediyorsun."

#: src/player_hardcoded_effects.cpp
msgid "The world takes on a dreamlike quality."
msgstr "Dünya rüya gibi bir kalite kazanıyor."

#: src/player_hardcoded_effects.cpp
msgid "You have a sudden nostalgic feeling."
msgstr "Aniden nostaljik bir hisse kapılıyorsun."

#: src/player_hardcoded_effects.cpp
msgid "Everything around you is starting to breathe."
msgstr "Etrafındaki her şey nefes almaya başlıyor."

#: src/player_hardcoded_effects.cpp
msgid "Something feels very, very wrong."
msgstr "Bir şeyler çok, çok yanlış hissediliyor."

#: src/player_hardcoded_effects.cpp
msgid "You feel sick to your stomach."
msgstr "Miden bulanıyor."

#: src/player_hardcoded_effects.cpp
msgid "\"I think it's starting to kick in.\""
msgstr "\"Sanırım etkisini göstermeye başlıyor.\""

#: src/player_hardcoded_effects.cpp
msgid "\"Oh God, what's happening?\""
msgstr "\"Aman Tanrım, neler oluyor?\""

#: src/player_hardcoded_effects.cpp
msgid "\"Of course… it's all fractals!\""
msgstr "\"Tabii ki… hepsi fraktal!\""

#: src/player_hardcoded_effects.cpp
msgid "\"Huh?  What was that?\""
msgstr "\"Hı? Bu neydi?\""

#: src/player_hardcoded_effects.cpp
msgid "Fractal patterns dance across your vision."
msgstr "Fraktal desenler görüş alanınızda dans ediyor."

#: src/player_hardcoded_effects.cpp
msgid "Dancing fractals distract you."
msgstr "Dans eden fraktallar sizi oyalıyor."

#: src/player_hardcoded_effects.cpp
msgid "Everything looks SO boring now."
msgstr "Her şey şimdi ÇOK sıkıcı görünüyor."

#: src/player_hardcoded_effects.cpp
msgid "Things are returning to normal."
msgstr "Her şey normale dönüyor."

#: src/player_hardcoded_effects.cpp
msgid "Your thoughts are unclear."
msgstr "Düşünceleriniz net değil."

#: src/player_hardcoded_effects.cpp
msgid "Your face is stiff from the cold."
msgstr "Yüzünüz soğuktan donmuş."

#: src/player_hardcoded_effects.cpp
msgid "You quiver from the cold."
msgstr "Soğuktan titriyorsunuz."

#: src/player_hardcoded_effects.cpp
msgid "Your torso is freezing cold.  You should put on a few more layers."
msgstr "Göğsünüz buz gibi soğuk. Birkaç kat daha giymelisiniz."

#: src/player_hardcoded_effects.cpp
msgid "Your shivering makes you unsteady."
msgstr "Titremeniz sizi dengesiz yapıyor."

#: src/player_hardcoded_effects.cpp
msgid "Your left arm is shivering."
msgstr "Sol kolunuz titriyor."

#: src/player_hardcoded_effects.cpp
msgid "Your left arm trembles from the cold."
msgstr "Sol kolunuz soğuktan titriyor."

#: src/player_hardcoded_effects.cpp
msgid "Your right arm is shivering."
msgstr "Sağ kolunuz titriyor."

#: src/player_hardcoded_effects.cpp
msgid "Your right arm trembles from the cold."
msgstr "Sağ kolunuz soğuktan titriyor."

#: src/player_hardcoded_effects.cpp
msgid "Your left hand feels like ice."
msgstr "Sol eliniz buz gibi."

#: src/player_hardcoded_effects.cpp
msgid "Your left hand quivers in the cold."
msgstr "Sol eliniz soğukta titriyor."

#: src/player_hardcoded_effects.cpp
msgid "Your right hand feels like ice."
msgstr "Sağ eliniz buz gibi."

#: src/player_hardcoded_effects.cpp
msgid "Your right hand quivers in the cold."
msgstr "Sağ eliniz soğukta titriyor."

#: src/player_hardcoded_effects.cpp
msgid "Your left leg trembles against the relentless cold."
msgstr "Sol bacağınız amansız soğuktan titriyor."

#: src/player_hardcoded_effects.cpp
msgid "Your legs uncontrollably shake from the cold."
msgstr "Bacaklarınız soğuktan kontrolsüzce titriyor."

#: src/player_hardcoded_effects.cpp
msgid "Your right leg trembles against the relentless cold."
msgstr "Sağ bacağınız amansız soğuktan titriyor."

#: src/player_hardcoded_effects.cpp
msgid "Your left foot feels frigid."
msgstr "Sol ayağınız buz gibi hissediyor."

#: src/player_hardcoded_effects.cpp
msgid "Your left foot is as nimble as a block of ice."
msgstr "Sol ayağınız bir buz kütlesi kadar çevik."

#: src/player_hardcoded_effects.cpp
msgid "Your freezing left foot messes up your balance."
msgstr "Donmuş sol ayağınız dengenizi bozuyor."

#: src/player_hardcoded_effects.cpp
msgid "Your right foot feels frigid."
msgstr "Sağ ayağınız buz gibi hissediyor."

#: src/player_hardcoded_effects.cpp
msgid "Your right foot is as nimble as a block of ice."
msgstr "Sağ ayağınız bir buz kütlesi kadar çevik."

#: src/player_hardcoded_effects.cpp
msgid "Your freezing right foot messes up your balance."
msgstr "Donmuş sağ ayağınız dengenizi bozuyor."

#: src/player_hardcoded_effects.cpp
msgid "Your head is pounding from the heat."
msgstr "Başınız sıcaktan zonkluyor."

#: src/player_hardcoded_effects.cpp
msgid "You are sweating profusely."
msgstr "Çok terliyorsun."

#: src/player_hardcoded_effects.cpp
msgid "Your left hand's too sweaty to grip well."
msgstr "Sol elin çok terli, iyi kavrayamıyorsun."

#: src/player_hardcoded_effects.cpp
msgid "Your right hand's too sweaty to grip well."
msgstr "Sağ elin çok terli, iyi kavrayamıyorsun."

#: src/player_hardcoded_effects.cpp
msgid "Your left leg is cramping up."
msgstr "Sol bacağın kramp giriyor."

#: src/player_hardcoded_effects.cpp
msgid "Your right leg is cramping up."
msgstr "Sağ bacağın kramp giriyor."

#: src/player_hardcoded_effects.cpp
msgid "Your left foot is swelling in the heat."
msgstr "Sol ayağın sıcakta şişiyor."

#: src/player_hardcoded_effects.cpp
msgid "Your right foot is swelling in the heat."
msgstr "Sağ ayağın sıcakta şişiyor."

#: src/player_hardcoded_effects.cpp
msgid "The heat is making you see things."
msgstr "Sıcak seni halüsinasyon görmeye zorluyor."

#: src/player_hardcoded_effects.cpp
msgid "You have trouble grasping with your numb fingers."
msgstr "Uyuşmuş parmaklarınla kavramakta zorlanıyorsun."

#: src/player_hardcoded_effects.cpp
msgid "Your foot has gone numb."
msgstr "Ayağın uyuştu."

#: src/player_hardcoded_effects.cpp
msgid "Your face feels numb."
msgstr "Yüzünüz uyuşmuş gibi hissediyor."

#: src/player_hardcoded_effects.cpp
msgid "Your flesh crawls; insects tear through the flesh and begin to emerge!"
msgstr ""
"Tüyleriniz diken diken oluyor; böcekler etinizi yırtarak çıkmaya başlıyor!"

#: src/player_hardcoded_effects.cpp
msgid "Insects begin to emerge from <npcname>'s skin!"
msgstr "Böcekler <npcname>'ın derisinden çıkmaya başlıyor!"

#. ~ %s is bodypart in accusative.
#: src/player_hardcoded_effects.cpp
#, c-format
msgid "You start scratching your %s!"
msgstr "%s'ınızı kaşımaya başlıyorsunuz!"

#. ~ 1$s is NPC name, 2$s is bodypart in accusative.
#: src/player_hardcoded_effects.cpp
#, c-format
msgid "%1$s starts scratching their %2$s!"
msgstr "%1$s, %2$s'ını kaşımaya başlıyor!"

#: src/player_hardcoded_effects.cpp
msgid "Why waste your time on that insignificant speck?"
msgstr "Neden zamanınızı o önemsiz nokta üzerinde harcıyorsunuz?"

#: src/player_hardcoded_effects.cpp
msgid ""
"You feel something reaching out to you, before reality around you frays!"
msgstr ""
"Etrafınızdaki gerçeklik çözülmeden önce size ulaşmaya çalışan bir şey "
"hissediyorsunuz!"

#: src/player_hardcoded_effects.cpp
msgid "You pass out from the strain of something bearing down on your mind."
msgstr "Zihninize baskı yapan bir şeyin yükünden bayılıyorsunuz."

#: src/player_hardcoded_effects.cpp
msgid "You feel something probing your mind, but it is rebuffed!"
msgstr "Zihninizi yoklayan bir şey hissediyorsunuz, ama geri püskürtülüyor!"

#: src/player_hardcoded_effects.cpp
msgid "A terrifying image in the back out your mind paralyzes you."
msgstr "Zihninizin arkasındaki korkunç bir görüntü sizi felç ediyor."

#: src/player_hardcoded_effects.cpp
msgid "You feel a buzzing in the back of your mind, but it passes."
msgstr "Zihninizin arkasında bir uğultu hissediyorsunuz, ama geçiyor."

#: src/player_hardcoded_effects.cpp
msgid "You feel something scream in the back of your mind!"
msgstr "Zihninizin arkasında bir şey çığlık atıyor!"

#: src/player_hardcoded_effects.cpp
msgid "Your vision is filled with bright lights…"
msgstr "Görüşünüz parlak ışıklarla doluyor…"

#: src/player_hardcoded_effects.cpp
msgid "A wave of nausea passes over you."
msgstr "Üzerinizden bir mide bulantısı dalgası geçiyor."

#: src/player_hardcoded_effects.cpp
msgid "Shifting shapes dance on the edge of your vision."
msgstr "Görüşünüzün kenarında şekiller dans ediyor."

#: src/player_hardcoded_effects.cpp
msgid "You feel weird for a moment, but it passes."
msgstr "Bir an garip hissediyorsunuz, ama geçiyor."

#: src/player_hardcoded_effects.cpp
msgid "Glowing lights surround you, and you teleport."
msgstr "Etrafınızı parlayan ışıklar sarıyor ve teleport oluyorsunuz."

#: src/player_hardcoded_effects.cpp
msgid "You are beset with a vision of a prowling beast."
msgstr "Bir avcı hayvanın vizyonu sizi sarıyor."

#: src/player_hardcoded_effects.cpp
msgid "Your surroundings are permeated with a foul scent."
msgstr "Çevreniz kötü bir koku ile doluyor."

#: src/player_hardcoded_effects.cpp
msgid "A monster appears nearby!"
msgstr "Yakınlarda bir canavar beliriyor!"

#: src/player_hardcoded_effects.cpp
msgid "A portal opens nearby, and a monster crawls through!"
msgstr "Yakınlarda bir portal açılıyor ve bir canavar sürünerek geçiyor!"

#: src/player_hardcoded_effects.cpp
msgid "You shudder suddenly."
msgstr "Aniden ürperiyorsun."

#: src/player_hardcoded_effects.cpp
msgid "You smell mold, and your skin itches."
msgstr "Küf kokusu alıyorsun ve cildin kaşınıyor."

#: src/player_hardcoded_effects.cpp
msgid "We have many colonists awaiting passage."
msgstr "Geçiş bekleyen birçok kolonistimiz var."

#: src/player_hardcoded_effects.cpp
msgid "A blue flash of radiation permeates your vision briefly!"
msgstr "Mavi bir radyasyon parlaması kısa bir süreliğine görüşünü kaplıyor!"

#: src/player_hardcoded_effects.cpp
msgid "You're suddenly covered in ectoplasm."
msgstr "Aniden ektoplazma ile kaplanıyorsun."

#: src/player_hardcoded_effects.cpp
msgid "A strange sound reverberates around the edges of reality."
msgstr "Gerçekliğin kenarlarında garip bir ses yankılanıyor."

#. ~ a humming sound
#: src/player_hardcoded_effects.cpp src/trapfunc.cpp
msgid "hrmmm"
msgstr "hrmmm"

#. ~ a loud humming sound
#: src/player_hardcoded_effects.cpp src/trapfunc.cpp
msgid "HRMMM"
msgstr "HRMMM"

#. ~ a very loud humming sound
#: src/player_hardcoded_effects.cpp src/trapfunc.cpp
msgid "VRMMMMMM"
msgstr "VRMMMMMM"

#: src/player_hardcoded_effects.cpp
msgid "Your asthma attack stops."
msgstr "Astım atağınız duruyor."

#: src/player_hardcoded_effects.cpp
msgid ""
"Your asthma overcomes you.\n"
"You asphyxiate."
msgstr "Astımınız sizi alt ediyor."

#: src/player_hardcoded_effects.cpp
msgid "You wheeze and gasp for air."
msgstr "Hırıltılı nefes alıyor ve hava için çırpınıyorsunuz."

#: src/player_hardcoded_effects.cpp
msgid "Your head aches faintly."
msgstr "Başınız hafifçe ağrıyor."

#: src/player_hardcoded_effects.cpp
msgid "Your vision is getting fuzzy."
msgstr "Görüşünüz bulanıklaşıyor."

#: src/player_hardcoded_effects.cpp
msgid "Your vision goes black!"
msgstr "Görüşünüz kararıyor!"

#: src/player_hardcoded_effects.cpp
msgid "Your bowels ache."
msgstr "Bağırsaklarınız ağrıyor."

#: src/player_hardcoded_effects.cpp
msgid "Your veins itch."
msgstr "Damarlarınız kaşınıyor."

#: src/player_hardcoded_effects.cpp
msgid "Your muscles feel like they're knotted and tired."
msgstr "Kaslarınız düğümlenmiş ve yorgun gibi hissediyor."

#: src/player_hardcoded_effects.cpp
msgid ""
"You're experiencing loss of basic motor skills and blurred vision.  Your "
"mind recoils in horror, unable to communicate with your spinal column."
msgstr ""
"Temel motor becerilerinizi kaybediyor ve bulanık görüyorsunuz. Zihniniz "
"dehşet içinde geri çekiliyor, omuriliğinizle iletişim kuramıyor."

#: src/player_hardcoded_effects.cpp
msgid "You stagger and fall!"
msgstr "Sendeleyip düşüyorsun!"

#: src/player_hardcoded_effects.cpp
msgid "There's some kind of big machine in the sky."
msgstr "Gökyüzünde bir tür büyük makine var."

#: src/player_hardcoded_effects.cpp
msgid "It's some kind of electric snake, coming right at you!"
msgstr "Üzerine doğru gelen bir tür elektrikli yılan!"

#: src/player_hardcoded_effects.cpp
msgid ""
"Order us some golf shoes, otherwise we'll never get out of this place alive."
msgstr "Bize golf ayakkabıları sipariş et, yoksa buradan canlı çıkamayacağız."

#: src/player_hardcoded_effects.cpp
msgid "The possibility of physical and mental collapse is now very real."
msgstr "Fiziksel ve zihinsel çöküş olasılığı artık çok gerçek."

#: src/player_hardcoded_effects.cpp
msgid "No one should be asked to handle this trip."
msgstr "Kimse bu yolculuğu üstlenmek zorunda kalmamalı."

#: src/player_hardcoded_effects.cpp
msgid ""
"Your heart spasms painfully and stops, dragging you back to reality as you "
"die."
msgstr ""
"Kalbin acı verici bir şekilde spazm yapar ve durur, ölürken seni gerçekliğe "
"geri çeker."

#: src/player_hardcoded_effects.cpp
msgid ""
"You dissolve into beautiful paroxysms of energy.  Life fades from your "
"nebulae and you are no more."
msgstr ""
"Güzel enerji paroksizmalarına çözülüyorsun. Hayat, nebula'larından siliniyor"
" ve artık yoksun."

#. ~ %s is bodypart name.
#: src/player_hardcoded_effects.cpp
#, c-format
msgid "Your %s wound begins to feel better!"
msgstr "%s yaran daha iyi hissetmeye başlıyor!"

#: src/player_hardcoded_effects.cpp
msgid "You succumb to the infection."
msgstr "Enfeksiyona yenik düşüyorsun."

#: src/player_hardcoded_effects.cpp
msgid "You feel well rested."
msgstr "Kendinizi iyi dinlenmiş hissediyorsunuz."

#: src/player_hardcoded_effects.cpp
msgid ""
"You feel physically rested, but you haven't been able to catch up on your "
"missed sleep yet."
msgstr ""
"Fiziksel olarak dinlenmiş hissediyorsunuz, ancak henüz kaçırdığınız uykuyu "
"telafi edemediniz."

