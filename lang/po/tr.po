#: src/overmap.cpp src/skill.cpp
msgid "invalid"
msgstr "geçersiz"

#: src/overmap.cpp
#, c-format
msgid ""
"This is automated emergency shelter beacon %d%d.  Supplies, amenities and "
"shelter are stocked."
msgstr ""
"Bu otomatik acil durum barınağı işaretçisi %d%d.  Malzemeler, olanaklar ve "
