msgid_plural "oranges"
msgstr[0] "portakal"
msgstr[1] "portakallar"

#. ~ Description for orange
#: data/json/items/comestibles/raw_fruit.json
msgid "Sweet citrus fruit.  Also comes in juice form."
msgstr "Tatlı narenciye meyvesi. Ayrıca meyve suyu formunda da bulunur."

#: data/json/items/comestibles/raw_fruit.json
#: data/mods/Aftershock/items/seed.json
msgid "lemon"
msgid_plural "lemons"
msgstr[0] "limon"
msgstr[1] "limonlar"

#. ~ Description for lemon
#: data/json/items/comestibles/raw_fruit.json
msgid "Very sour citrus.  Can be eaten if you really want."
msgstr "Çok ekşi narenciye. Gerçekten isterseniz yenebilir."

#: data/json/items/comestibles/raw_fruit.json
msgid "blueberries"
msgid_plural "blueberries"
msgstr[0] "yaban mersini"
msgstr[1] "yaban mersinleri"

#. ~ Description for {'str_sp': 'blueberries'}
#: data/json/items/comestibles/raw_fruit.json
msgid "They're blue, but that doesn't mean they're sad."
msgstr "Mavidirler, ama bu üzgün oldukları anlamına gelmez."

#: data/json/items/comestibles/raw_fruit.json
msgid "strawberries"
msgid_plural "strawberries"
msgstr[0] "çilek"
msgstr[1] "çilekler"

#. ~ Description for {'str_sp': 'strawberries'}
#: data/json/items/comestibles/raw_fruit.json
msgid "Tasty, juicy berry.  Often found growing wild in fields."
msgstr ""
"Lezzetli, sulu bir meyve. Genellikle tarlalarda yabani olarak yetişir."

#: data/json/items/comestibles/raw_fruit.json
msgid "cranberries"
msgid_plural "cranberries"
msgstr[0] "turna yemişi"
msgstr[1] "turna yemişleri"

#. ~ Description for {'str_sp': 'cranberries'}
#: data/json/items/comestibles/raw_fruit.json
msgid "Sour red berries.  Good for your health."
msgstr "Ekşi kırmızı meyveler. Sağlığınız için iyidir."

#: data/json/items/comestibles/raw_fruit.json
msgid "raspberries"
msgid_plural "raspberries"
msgstr[0] "ahududu"
msgstr[1] "ahududular"

#. ~ Description for {'str_sp': 'raspberries'}
#: data/json/items/comestibles/raw_fruit.json
msgid "A sweet red berry."
msgstr "Tatlı bir kırmızı meyve."

#: data/json/items/comestibles/raw_fruit.json
msgid "huckleberries"
msgid_plural "huckleberries"
msgstr[0] "ayı üzümü"
msgstr[1] "ayı üzümleri"

#. ~ Description for {'str_sp': 'huckleberries'}
#: data/json/items/comestibles/raw_fruit.json
msgid "Huckleberries, often times confused for blueberries."
msgstr "Çoğu zaman yaban mersini ile karıştırılan ayı üzümü."

#: data/json/items/comestibles/raw_fruit.json
msgid "mulberries"
msgid_plural "mulberries"
msgstr[0] "dut"
msgstr[1] "dutlar"

#. ~ Description for {'str_sp': 'mulberries'}
#: data/json/items/comestibles/raw_fruit.json
msgid ""
"Mulberries, this red variety is unique to east North America and is "
"described to have the strongest flavor of any variety in the world."
msgstr ""
"Karadutlar, bu kırmızı çeşidi Doğu Kuzey Amerika'ya özgüdür ve dünyadaki "
"herhangi bir çeşidin en güçlü lezzetine sahip olduğu söylenir."

#: data/json/items/comestibles/raw_fruit.json
msgid "elderberries"
msgid_plural "elderberries"
msgstr[0] "mürver"
msgstr[1] "mürverler"

#. ~ Description for {'str_sp': 'elderberries'}
#: data/json/items/comestibles/raw_fruit.json
msgid "Elderberries, toxic when eaten raw but great when cooked."
msgstr "Mürverler, çiğ yenildiğinde toksiktir ancak pişirildiğinde harikadır."

#: data/json/items/comestibles/raw_fruit.json
msgid "rose hips"
msgid_plural "rose hips"
msgstr[0] "kuşburnu"
msgstr[1] "kuşburnuları"

#. ~ Description for {'str_sp': 'rose hips'}
#: data/json/items/comestibles/raw_fruit.json
msgid "The fruit of a pollinated rose flower."
msgstr "Tozlaşmış bir gül çiçeğinin meyvesi."

#: data/json/items/comestibles/raw_fruit.json
msgid "juice pulp"
msgid_plural "juice pulps"
msgstr[0] "meyve suyu posası"
msgstr[1] "meyve suyu posaları"

#. ~ Description for juice pulp
#: data/json/items/comestibles/raw_fruit.json
