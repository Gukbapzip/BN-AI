msgid "Time to complete: "
msgstr "Tamamlanma süresi:"

#: src/consumption.cpp
msgid "That doesn't look edible."
msgstr "Bu yenilebilir görünmüyor."

#: src/consumption.cpp
msgid "That doesn't look edible to you."
msgstr "Bu sana yenilebilir görünmüyor."

#: src/consumption.cpp
msgid "That doesn't look edible in its current form."
msgstr "Bu, şu anki haliyle yenilebilir görünmüyor."

#: src/consumption.cpp
msgid "This is full of dirt after being on the ground."
msgstr "Bu, yerde kaldıktan sonra toprakla dolu."

#: src/consumption.cpp src/iuse.cpp src/iuse_actor.cpp
msgid "You can't do that while underwater."
msgstr "Suyun altındayken bunu yapamazsın."

#: src/consumption.cpp
#, c-format
msgid "You need a %s to consume that!"
msgstr "Onu tüketmek için bir %s'a ihtiyacınız var!"

#: src/consumption.cpp
msgid "We can't eat that.  It's not right for us."
msgstr "Bunu yiyemeyiz. Bu bizim için uygun değil."

#: src/consumption.cpp
msgid "Ugh, you can't drink that!"
msgstr "Iyy, bunu içemezsin!"

#: src/consumption.cpp
msgid "Eww.  Inedible plant stuff!"
msgstr "Iyy. Yenmez bitki şeyleri!"

#: src/consumption.cpp
msgid "The thought of eating that makes you feel sick."
msgstr "Bunu yeme düşüncesi sizi hasta hissettiriyor."

#: src/consumption.cpp
msgid "You can't eat this."
msgstr "Bunu yiyemezsiniz."

#: src/consumption.cpp
msgid "This is rotten and smells awful!"
msgstr "Bu çürümüş ve berbat kokuyor!"

#: src/consumption.cpp
msgid "The thought of eating human flesh makes you feel sick."
msgstr "İnsan eti yeme düşüncesi sizi hasta hissettiriyor."

#: src/consumption.cpp
msgid "You still feel nauseous and will probably puke it all up again."
msgstr ""
"Hala mide bulantısı hissediyorsunuz ve muhtemelen hepsini tekrar "
"kusacaksınız."

#: src/consumption.cpp
msgid "You're full and will vomit if you try to consume anything."
msgstr "Doymuşsunuz ve bir şey tüketmeye çalışırsanız kusacaksınız."

#: src/consumption.cpp
msgid "Your stomach won't be happy (allergy)."
msgstr "Mideniz mutlu olmayacak (alerji)."

#. ~ No, we don't eat "rotten" food. We eat properly aged food, like a normal
#. person.
#. ~ Semantic difference, but greatly facilitates people being proud of their
#. character.
#: src/consumption.cpp
msgid "Your stomach won't be happy (not rotten enough)."
msgstr "Mideniz mutlu olmayacak (yeterince çürümemiş)."

#: src/consumption.cpp
msgid "You're full already and the excess food will be wasted."
msgstr "Zaten toksunuz ve fazla yiyecek israf olacak."

#: src/consumption.cpp
#, c-format
msgid "Eat your %s anyway?"
msgstr "Yine de %s yemeği yer misiniz?"

#: src/consumption.cpp
#, c-format
msgid "Drink your %s anyway?"
msgstr "Yine de %s içecek misiniz?"

#: src/consumption.cpp
#, c-format
msgid "Consume your %s anyway?"
msgstr "Yine de %s tüketecek misiniz?"

#: src/consumption.cpp
#, c-format
msgid "You force yourself to vomit to make space for %s."
msgstr "%s için yer açmak amacıyla kendinizi kusturuyorsunuz."

#: src/consumption.cpp
#, c-format
msgid "Ick, this %s doesn't taste so good…"
msgstr "Iyy, bu %s pek iyi tat vermiyor…"

#: src/consumption.cpp
#, c-format
msgid "Mmm, this %s tastes delicious…"
msgstr "Mmm, bu %s lezzetli tat veriyor…"

#: src/consumption.cpp
#, c-format
msgid "<npcname> assimilates a %s."
msgstr "<npcname>, bir %s özümser."

#: src/consumption.cpp
#, c-format
msgid "You assimilate your %s."
msgstr "%s'nı özümse."

#: src/consumption.cpp
#, c-format
msgid "<npcname> drinks a %s."
msgstr "<npcname>, bir %s içer."

#: src/consumption.cpp
#, c-format
msgid "You drink your %s."
msgstr "%s'nı içersin."

#: src/consumption.cpp
#, c-format
msgid "<npcname> eats a %s."
msgstr "<npcname>, bir %s yer."

#: src/consumption.cpp
#, c-format
msgid "You eat your %s."
msgstr "%s'nı yersin."

#: src/consumption.cpp
msgid "The shadows are getting ever closer."
msgstr "Gölgeler giderek daha da yaklaşıyor."

#: src/consumption.cpp
msgid "You have a bad feeling about this."
msgstr "Bu konuda kötü bir hisse sahipsin."

#: src/consumption.cpp
msgid "A powerful sense of dread comes over you."
msgstr "Üzerine güçlü bir korku hissi çöküyor."

#: src/consumption.cpp
msgid "Your skin starts crawling."
msgstr "Deri altın kaşınmaya başlıyor."

#: src/consumption.cpp
msgid "They're coming to get you."
msgstr "Seni almaya geliyorlar."

#: src/consumption.cpp
msgid "This might've been a bad idea…"
msgstr "Bu kötü bir fikir olmuş olabilir…"

#: src/consumption.cpp
msgid "You've really done it this time, haven't you?"
msgstr "Bu sefer gerçekten yaptın, değil mi?"

#: src/consumption.cpp
msgid "You have to stay vigilant.  They're always watching…"
msgstr "Dikkatli olmalısın. Her zaman izliyorlar…"

#: src/consumption.cpp
msgid "mistake mistake mistake mistake mistake"
msgstr "hata hata hata hata hata"

#: src/consumption.cpp
msgid "Just gotta stay calm, and you'll make it through this."
msgstr "Sakin kalmalısın, ve bunu atlatacaksın."

#: src/consumption.cpp
msgid "You're starting to feel very jumpy."
msgstr "Kendini çok gergin hissetmeye başlıyorsun."

#: src/consumption.cpp
msgid "Something is twitching at the edge of your vision."
msgstr "Görüş alanının kenarında bir şey kıpırdıyor."

#: src/consumption.cpp
msgid "They know what you've done…"
msgstr "Ne yaptığını biliyorlar…"

#: src/consumption.cpp
msgid "You're feeling even more paranoid than usual."
msgstr "Kendini her zamankinden daha paranoyak hissediyorsun."

#: src/consumption.cpp
#, c-format
msgid "You heat up your %1$s using the %2$s."
msgstr "%1$s'yı %2$s kullanarak ısıtıyorsun."

#: src/consumption.cpp
#, c-format
msgid "<npcname> heats up their %1$s using the %2$s."
msgstr "<npcname>, %1$s'i %2$s kullanarak ısıtır."

#: src/consumption.cpp
msgid "This stuff is icy!"
msgstr "Bu şey buz gibi!"

#: src/consumption.cpp
msgid "This stuff is cold!"
msgstr "Bu şey soğuk!"

#: src/consumption.cpp
msgid "You indulge your shameful hunger."
msgstr "Utanç verici açlığınızı tatmin ediyorsunuz."

#: src/consumption.cpp
msgid "You feel horrible for eating a person."
msgstr "Bir insan yediğiniz için kendinizi berbat hissediyorsunuz."

#: src/consumption.cpp
msgid "Yuck!  How can anybody eat this stuff?"
msgstr "Iyy! Kim bu şeyi yiyebilir ki?"

#: src/consumption.cpp
msgid "Mmm, junk food."
msgstr "Mmm, abur cubur."

#: src/consumption.cpp
msgid "When life's got you down, there's always sugar."
msgstr "Hayat sizi üzdüğünde, her zaman şeker vardır."

#: src/consumption.cpp
msgid "They may do what they must… you've already won."
msgstr "Onlar ne yapmaları gerekiyorsa yapabilirler... siz zaten kazandınız."

#: src/consumption.cpp
msgid "Your stomach begins gurgling and you feel bloated and ill."
msgstr "Mideniz guruldamaya başlıyor ve şişkin ve hasta hissediyorsunuz."

#: src/consumption.cpp
msgid "You find the sweet taste of honey surprisingly palatable."
msgstr "Balın tatlı tadını şaşırtıcı derecede lezzetli buluyorsunuz."

#: src/consumption.cpp
msgid "You feast upon the sweet honey."
msgstr "Tatlı balı ziyafetle yiyorsunuz."

#: src/consumption.cpp
msgid "You feel as though you're going to split open!  In a good way?"
msgstr "Sanki patlayacakmış gibi hissediyorsunuz! İyi bir şekilde mi?"

#. ~ slimespawns have *small voices* which may be the Nice equivalent
#. ~ of the Rat King's ALL CAPS invective.  Probably shared-brain telepathy.
#: src/consumption.cpp
msgid "hey, you look like me!  let's work together!"
msgstr "Hey, sen bana benziyorsun! Hadi birlikte çalışalım!"

#: src/consumption.cpp
#, c-format
msgid "Are you sure you want to eat your favorited %s?"
msgstr "Favori %s'nizi yemek istediğinizden emin misiniz?"

#: src/consumption.cpp
#, c-format
msgid "You digest your %s, but fail to acquire energy from it."
msgstr "%s'nizi sindiriyorsunuz, ancak ondan enerji elde edemiyorsunuz."

#: src/consumption.cpp
#, c-format
msgid ""
"<npcname> digests their %s for energy, but fails to acquire energy from it."
msgstr ""
"<npcname>, enerji için %s'ini sindiriyor, ancak ondan enerji elde edemiyor."

#: src/consumption.cpp
#, c-format
msgid ""
"You digest your %s, but you're fully powered already, so the energy is "
"wasted."
msgstr ""
"%s'nizi sindiriyorsunuz, ama zaten tamamen dolusunuz, bu yüzden enerji boşa "
"gidiyor."

#: src/consumption.cpp
#, c-format
msgid ""
"<npcname> digests a %s for energy, they're fully powered already, so the "
"energy is wasted."
msgstr ""
"<npcname>, enerji için bir %s sindiriyor, ama zaten tamamen dolular, bu "
"yüzden enerji boşa gidiyor."

