#: data/json/furniture_and_terrain/furniture-appliances.json
msgid "mounted small motorbike battery"
msgstr "monte edilmiş küçük motosiklet aküsü"

#. ~ Description for mounted small motorbike battery
#: data/json/furniture_and_terrain/furniture-appliances.json
