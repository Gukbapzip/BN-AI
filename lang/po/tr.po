msgstr[0] "taş cirit"
msgstr[1] "taş ciritler"

#. ~ Description for {'str': 'stone javelin'}
#: data/json/items/melee/spears_and_polearms.json
msgid "A throwing spear with a stone spearhead."
msgstr "Taş uçlu bir fırlatma mızrağı."

#: data/json/items/melee/spears_and_polearms.json
