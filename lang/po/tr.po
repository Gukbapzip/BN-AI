msgid_plural "qiangs"
msgstr[0] "qiang"
msgstr[1] "qianglar"

#. ~ Description for {'str': 'qiang'}
#: data/json/items/melee/spears_and_polearms.json
msgid ""
"An ancient Chinese spear, typically with a tassel just below the spearhead."
"  One of the four major weapons in folklore, alongside the dao sabre, jian "
"sword, and gun staff."
msgstr ""
"Genellikle mızrak ucunun hemen altında bir püskül bulunan eski bir Çin "
"mızrağı. Folklorda dao kılıcı, jian kılıcı ve gun sopası ile birlikte dört "
"büyük silahtan biri."

#: data/json/items/melee/spears_and_polearms.json
