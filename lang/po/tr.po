msgstr[1] "<npcname>, %d %s sindirir ve %d enerji puanı yeniler."

#: src/consumption.cpp
#, c-format
msgid "You digest your %s and recharge %d point of energy."
msgid_plural "You digest your %s and recharge %d points of energy."
